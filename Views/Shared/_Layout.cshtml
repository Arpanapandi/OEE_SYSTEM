@{
    var title = ViewData["Title"] as string ?? "OEE Monitoring";
    var isOeeDetailPage = ViewData["IsOeeDetailPage"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - OEE Monitoring</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Custom Glassmorphism Core -->
    <link rel="stylesheet" href="~/css/glassmorphism-core.css" />
    
    <style>
        /* Override specific Bootstrap styles for Glassmorphism compatibility */
        body {
            background-color: transparent; /* Handled by glassmorphism-core.css */
        }
        .modal-content {
            background: var(--dark-bg-secondary);
            border: 1px solid var(--glass-border);
            color: var(--text-primary);
        }
        .modal-header, .modal-footer {
            border-color: var(--glass-border);
        }
        .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
        }
    </style>
</head>
<body>
    <div class="app-wrapper @(isOeeDetailPage ? "no-sidebar" : "")" id="appWrapper">
        @if (!isOeeDetailPage)
        {
            <!-- Sidebar -->
            <aside class="sidebar">
                <div class="sidebar-header">
                    <i class="bi bi-cpu-fill sidebar-logo"></i>
                    <span class="sidebar-title">OEE SYSTEM</span>
                </div>
                <nav class="sidebar-nav">
                    <a asp-controller="Home" asp-action="Index" class="nav-item @(ViewData["Title"]?.ToString()?.Contains("Dashboard") == true ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a asp-controller="Admin" asp-action="Index" class="nav-item">
                        <i class="bi bi-gear"></i>
                        <span>Admin</span>
                    </a>
                    <a href="#" class="nav-item">
                        <i class="bi bi-bar-chart-line"></i>
                        <span>Analytics</span>
                    </a>
                    <a href="#" class="nav-item">
                        <i class="bi bi-clock-history"></i>
                        <span>History</span>
                    </a>
                </nav>
                <div class="sidebar-footer">
                    <div class="status-indicator">
                        <div class="status-dot active" style="background: #28a745; box-shadow: 0 0 10px #28a745;"></div>
                        <span class="text-secondary ms-2">System Online</span>
                    </div>
                </div>
            </aside>
        }

        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="d-flex align-items-center">
                @if (isOeeDetailPage)
                {
                    <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary me-3 border-0" title="Back to Dashboard">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                }
                else
                {
                    <button class="sidebar-toggle me-3" id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>
                }
                <div class="d-flex flex-column">
                    <span class="fw-bold" style="font-size: 1.1rem;">@title</span>
                    <span class="small text-secondary">
                        @if (isOeeDetailPage)
                        {
                            <span class="me-2"><i class="bi bi-layers-half me-1"></i>@ViewData["LineId"]</span>
                            <span><i class="bi bi-calendar3 me-1"></i>@ViewData["ShiftName"] (@ViewData["ShiftTime"])</span>
                        }
                        else
                        {
                            @:OEE Monitoring System
                        }
                    </span>
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-2 gap-md-3">
                @if (isOeeDetailPage)
                {
                    <!-- Machine Status in Navbar -->
                    <div class="glass-card py-1 px-3 mb-0 d-none d-md-flex align-items-center gap-2" style="background: rgba(255,255,255,0.03);">
                        <div class="status-dot active" id="navbar-status-dot" style="background: var(--accent-blue); box-shadow: 0 0 10px var(--accent-blue);"></div>
                        <span id="navbar-status-text" class="fw-bold small text-uppercase" style="letter-spacing: 1px;">@(ViewData["MachineStatus"]?.ToString() ?? "OFFLINE")</span>
                    </div>
                }

                @if (!isOeeDetailPage)
                {
                    <!-- Real-time Clock (Jam Aktual) -->
                    <div class="glass-card py-1 px-3 mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-clock text-accent-blue"></i>
                        <span id="realtimeClock" class="fw-bold font-monospace">Loading...</span>
                    </div>
                }
                
                @if (!isOeeDetailPage)
                {
                    <!-- SignalR Status - Only on Dashboard for now to keep Detail clean -->
                    <div id="signalr-status-container" class="glass-card py-1 px-3 mb-0">
                        <span id="signalr-status">
                            <span class="badge bg-secondary">Connecting...</span>
                        </span>
                    </div>
                }
            </div>
        </header>

        <!-- Main Content -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>
    
    <!-- Design System Scripts -->
    <script>
        // Global variables for time synchronization
        window.serverTimeOffset = 0;
        
        // Function to get accurate time (server adjusted)
        window.getAdjustedServerTime = function() {
            return new Date(new Date().getTime() + window.serverTimeOffset);
        };

        // Helper to get raw offset
        window.getServerTimeOffset = function() {
            return window.serverTimeOffset;
        };

        // Sync server time offset once at start
        (function() {
            const serverTimeStr = '@Html.Raw(DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss"))';
            const serverTime = new Date(serverTimeStr);
            if (!isNaN(serverTime.getTime())) {
                window.serverTimeOffset = serverTime.getTime() - new Date().getTime();
                console.log('🕒 Server time offset synced:', window.serverTimeOffset, 'ms');
            }
        })();

        // Sidebar Toggle Logic
        const sidebarToggle = document.getElementById('sidebarToggle');
        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', () => {
                const wrapper = document.getElementById('appWrapper');
                if (window.innerWidth <= 767) {
                    wrapper.classList.toggle('mobile-nav-active');
                } else {
                    wrapper.classList.toggle('collapsed');
                }
            });
        }

        // Centralized Clock Sync Logic
        function updateAllClocks() {
            const now = window.getAdjustedServerTime();
            
            // Format time string
            const timeStr = now.getHours().toString().padStart(2, '0') + ':' + 
                          now.getMinutes().toString().padStart(2, '0') + ':' + 
                          now.getSeconds().toString().padStart(2, '0');
            
            // 1. Update Navbar Clock
            const clockEl = document.getElementById('realtimeClock');
            if(clockEl) {
                clockEl.textContent = timeStr;
            }

            // 2. Synchronize date if it changes (e.g. at midnight)
            const detailDateEl = document.getElementById('filter-date');
            if(detailDateEl) {
                const dateStr = now.getFullYear() + '-' + 
                              (now.getMonth() + 1).toString().padStart(2, '0') + '-' + 
                              now.getDate().toString().padStart(2, '0');
                if (detailDateEl.value !== dateStr) {
                    detailDateEl.value = dateStr;
                }
            }
        }
        setInterval(updateAllClocks, 1000);
        updateAllClocks();

        // Responsive adjustment
        window.addEventListener('resize', () => {
            if (window.innerWidth > 767) {
                document.getElementById('appWrapper')?.classList.remove('mobile-nav-active');
            }
        });
    </script>
    
    <!-- Dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
