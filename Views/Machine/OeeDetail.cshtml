                        if (typeof checkAllInputsComplete === 'function') {
                            checkAllInputsComplete();
                        }
                        console.log('✅ Value updated to:', newValue.toFixed(2));
                    }
                    return false;
                });
                
                // Fallback: juga attach via onclick
                newBtnDecrement.onclick = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const currentValue = parseFloat(inputBeratAct.value) || 0;
                    if (currentValue > 0) {
                        const newValue = Math.max(0, currentValue - 0.01);
                        inputBeratAct.value = newValue.toFixed(2);
