        // Fetch operator data untuk update action buttons dan production data
        async function fetchOperatorDataForOee() {
            const machineId = '@Html.Raw(Model.MachineId)';
            if (!machineId) {
                console.warn('Machine ID is not available');
                return;
            }
            
            try {
                const response = await fetch(`/Operator/GetOperatorData?machineId=${machineId}`);
                if (!response.ok) {
                    console.warn(`HTTP error! status: ${response.status}`);
                    return;
                }
                
                const data = await response.json();
                
                // Defensive: Check if data exists and has expected structure
                if (!data || typeof data !== 'object') {
                    console.warn('Unexpected data structure:', data);
                    return;
                }
                
                // Update state with safe defaults
                hasActiveJobOee = data?.HasActiveJob ?? false;
                hasActiveDowntimeOee = data?.HasActiveDowntime ?? false;
                machineStatusOee = data?.MachineStatus ?? machineStatusOee;
                
                // Update NoLoading status dari data jika ada
                if (data?.IsNoLoading !== undefined) {
                    isNoLoading = data.IsNoLoading;
                }
                
                // ✅ PERBAIKAN: Update Rest Break status dari data jika ada
                if (data?.HasActiveRestBreak !== undefined) {
                    hasActiveRestBreak = data.HasActiveRestBreak;
                }
                
                // ✅ Update durasi sejak status terakhir dari backend
                if (data?.SinceLastChangeSeconds !== undefined && data.SinceLastChangeSeconds !== null) {
                    // ✅ CRITICAL: Deteksi apakah mesin sedang Running
                    // Running jika: MachineStatus === 'Running' atau 'Aktif' DAN tidak ada downtime aktif DAN tidak ada Rest Break
                    const isRunning = (data?.MachineStatus === 'Running' || data?.MachineStatus === 'Aktif') && 
                                      !(data?.HasActiveDowntime || data?.HasActiveRestBreak);
                    
                    // ✅ CRITICAL: Jika Running dan ada LastStatusChangeTime, SELALU gunakan itu untuk set runningStartTimeUtc
                    // Ini memastikan durasi sinkron dengan backend, bukan dihitung dari initialTimeSeconds
                    // ✅ CRITICAL: Set runningStartTimeUtc SEBELUM memanggil updateSinceLastChange() agar digunakan dengan benar
                    if (isRunning && data?.LastStatusChangeTime) {
                        try {
                            const lastChangeTime = new Date(data.LastStatusChangeTime);
                            if (!isNaN(lastChangeTime.getTime())) {
                                // ✅ CRITICAL: Set runningStartTimeUtc langsung dari LastStatusChangeTime (sumber kebenaran dari backend)
                                // Ini memastikan durasi selalu sinkron dengan waktu saat Running diklik di backend
                                runningStartTimeUtc = lastChangeTime;
                                if (typeof window.runningStartTimeUtc !== 'undefined') {
                                    window.runningStartTimeUtc = lastChangeTime;
                                }
                                console.log('✅ Set runningStartTimeUtc from LastStatusChangeTime (backend source):', lastChangeTime.toISOString(), 'SinceLastChangeSeconds:', data.SinceLastChangeSeconds);
                            }
                        } catch (dateError) {
                            console.warn('Error parsing LastStatusChangeTime:', dateError);
                        }
                    } else if (isRunning) {
                        // Jika Running tapi tidak ada LastStatusChangeTime, clear runningStartTimeUtc
                        runningStartTimeUtc = null;
                        if (typeof window.runningStartTimeUtc !== 'undefined') {
                            window.runningStartTimeUtc = null;
                        }
                        console.warn('⚠️ Running but no LastStatusChangeTime, cleared runningStartTimeUtc');
                    }
                    
                    // ✅ CRITICAL: Panggil updateSinceLastChange() SETELAH runningStartTimeUtc di-set dari LastStatusChangeTime
                    updateSinceLastChange(data.SinceLastChangeSeconds, isRunning);
                    console.log('🔄 Updated "since-last-status" timer from backend:', data.SinceLastChangeSeconds, 'isRunning:', isRunning, 'LastStatusChangeTime:', data?.LastStatusChangeTime, 'runningStartTimeUtc:', runningStartTimeUtc?.toISOString());
                } else if (data?.LastStatusChangeTime) {
                    // Fallback: hitung dari LastStatusChangeTime jika SinceLastChangeSeconds tidak ada
                    try {
                        const lastChangeTime = new Date(data.LastStatusChangeTime);
                        if (!isNaN(lastChangeTime.getTime())) {
                            const now = new Date();
                            const diffSeconds = Math.floor((now.getTime() - lastChangeTime.getTime()) / 1000);
                            const isRunning = (data?.MachineStatus === 'Running' || data?.MachineStatus === 'Aktif') && 
                                              !(data?.HasActiveDowntime || data?.HasActiveRestBreak);
                            
                            // ✅ PERBAIKAN: Jika Running, set runningStartTimeUtc dari LastStatusChangeTime
                            if (isRunning) {
                                runningStartTimeUtc = lastChangeTime;
                                if (typeof window.runningStartTimeUtc !== 'undefined') {
                                    window.runningStartTimeUtc = lastChangeTime;
                                }
                                console.log('✅ Set runningStartTimeUtc from LastStatusChangeTime (fallback):', lastChangeTime.toISOString());
                            }
                            
                            updateSinceLastChange(Math.max(0, diffSeconds), isRunning);
                        }
                    } catch (dateError) {
                        console.warn('Error parsing LastStatusChangeTime:', dateError);
                    }
                }
                
                // Update action buttons
                updateActionButtonsOee(data);
                
                // Update machine status
                updateMachineStatusOee(data);
                
                // Update production data
                updateProductionDataOee(data);
            } catch (error) {
                console.error('Error fetching operator data for OEE:', error);
                // Don't break the UI, just log the error
            }
        }

