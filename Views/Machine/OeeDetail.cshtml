        // Apply time metrics data to UI (can be from fetch or SignalR)
        function applyTimeMetrics(data) {
            if (!data) return;
            
            const newShiftKey = data.ShiftKey || '';
            // Store active job/downtime info
            const newHasActiveJob = data.HasActiveJob || false;
            const newHasActiveDowntime = data.HasActiveDowntime || false;

            // Update base values dengan nilai baru dari server (sudah termasuk waktu saat fetch)
            basePlannedSeconds = Number(data.PlannedProductionTimeSeconds) || 0;
            baseOperatingSeconds = Number(data.OperatingTimeSeconds) || 0;
            baseDowntimeSeconds = Number(data.DowntimeTotalSeconds) || 0;
            // ✅ PERBAIKAN: Update Rest Break dan No Loading dari backend jika ada
            baseRestBreakSeconds = Number(data.RestBreakTimeSeconds) || 0;
            baseNoLoadingSeconds = Number(data.NoLoadingTimeSeconds) || 0;

            // Jika shift berubah, reset counter dan simpan shiftKey baru
            const shiftChanged = newShiftKey && newShiftKey !== lastShiftKey;
            if (shiftChanged) {
                lastShiftKey = newShiftKey;
            }

            // Reset counter karena base sudah mengandung waktu terkini
            realTimeCounter = 0;

            // Update status
            hasActiveJob = newHasActiveJob;
            hasActiveDowntime = newHasActiveDowntime;
            previousHasActiveJob = hasActiveJob;
            previousHasActiveDowntime = hasActiveDowntime;
            
            // Update NoLoading status dari data jika ada
            if (data.IsNoLoading !== undefined) {
                isNoLoading = data.IsNoLoading;
            }
            
            // ✅ PERBAIKAN: Update Rest Break status dari data jika ada
            if (data.HasActiveRestBreak !== undefined) {
                hasActiveRestBreak = data.HasActiveRestBreak;
            }

            // Update OEE KPI Cards
            if (data.Oee !== undefined) {
                const oeeEl = document.getElementById('oee-value');
                if (oeeEl) oeeEl.textContent = Math.round(data.Oee) + '%';
                
                const availEl = document.getElementById('availability-value');
                if (availEl) availEl.textContent = Math.round(data.Availability) + '%';
                
                const perfEl = document.getElementById('performance-value');
                if (perfEl) perfEl.textContent = Math.round(data.Performance) + '%';
                
                const qualEl = document.getElementById('quality-value');
                if (qualEl) qualEl.textContent = Math.round(data.Quality) + '%';
            }

            // Update Production Counts
            if (data.TotalCount !== undefined) {
                const totalGoodEl = document.getElementById('total-good');
                if (totalGoodEl) totalGoodEl.textContent = data.GoodCount;
                
                const totalRejectEl = document.getElementById('total-reject');
                if (totalRejectEl) totalRejectEl.textContent = data.RejectCount;
                
                const progressTextEl = document.getElementById('progress-text');
                if (progressTextEl) {
                    // Ambil target qty dari text sebelumnya (format: "Good / Target")
                    const parts = progressTextEl.textContent.split('/');
                    const target = parts.length > 1 ? parts[1].trim() : '0';
                    progressTextEl.textContent = `${data.GoodCount} / ${target}`;
                    
                    // Update progress bar
                    const targetInt = parseInt(target);
                    if (targetInt > 0) {
                        const percent = Math.min(100, (data.GoodCount / targetInt * 100));
                        const progressBar = document.getElementById('progress-bar');
                        if (progressBar) {
                            progressBar.style.width = percent + '%';
                            progressBar.setAttribute('aria-valuenow', percent);
                            
                            const progressPercentEl = document.getElementById('progress-percent');
                            if (progressPercentEl) progressPercentEl.textContent = percent.toFixed(1) + '%';
                        }
                    }
                }
            }

            // Update display immediately
            updateTimeDisplay();
            
            // ✅ Update durasi sejak status terakhir dari backend
            if (data?.SinceLastChangeSeconds !== undefined && data.SinceLastChangeSeconds !== null) {
                // ✅ CRITICAL: Deteksi apakah mesin sedang Running
                const isRunning = (data?.MachineStatus === 'Running' || data?.MachineStatus === 'Aktif') && 
                                  !(data?.HasActiveDowntime || data?.HasActiveRestBreak);
                
                // ✅ CRITICAL: Jika Running dan ada LastStatusChangeTime, SELALU gunakan itu untuk set runningStartTimeUtc
                if (isRunning && data?.LastStatusChangeTime) {
                    try {
                        const lastChangeTime = new Date(data.LastStatusChangeTime);
                        if (!isNaN(lastChangeTime.getTime())) {
                            runningStartTimeUtc = lastChangeTime;
                            if (typeof window.runningStartTimeUtc !== 'undefined') {
                                window.runningStartTimeUtc = lastChangeTime;
                            }
                        }
                    } catch (dateError) {
                        console.warn('Error parsing LastStatusChangeTime:', dateError);
                    }
                } else if (isRunning) {
                    runningStartTimeUtc = null;
                    if (typeof window.runningStartTimeUtc !== 'undefined') {
                        window.runningStartTimeUtc = null;
                    }
                }
                
                // ✅ CRITICAL: Panggil updateSinceLastChange() SETELAH runningStartTimeUtc di-set
                updateSinceLastChange(data.SinceLastChangeSeconds, isRunning);
            } else if (data?.LastStatusChangeTime) {
                // Fallback: calculate dari LastStatusChangeTime
                try {
                    const lastChangeTime = new Date(data.LastStatusChangeTime);
                    if (!isNaN(lastChangeTime.getTime())) {
                        const now = typeof window.getAdjustedServerTime === 'function' 
                            ? window.getAdjustedServerTime() 
                            : new Date();
                        const diffSeconds = Math.floor((now.getTime() - lastChangeTime.getTime()) / 1000);
                        const isRunning = (data?.MachineStatus === 'Running' || data?.MachineStatus === 'Aktif') && 
                                          !(data?.HasActiveDowntime || data?.HasActiveRestBreak);
                        
                        if (isRunning) {
                            runningStartTimeUtc = lastChangeTime;
                            if (typeof window.runningStartTimeUtc !== 'undefined') {
                                window.runningStartTimeUtc = lastChangeTime;
                            }
                        }
                        
                        updateSinceLastChange(Math.max(0, diffSeconds), isRunning);
                    }
                } catch (dateError) {
                    console.warn('Error parsing LastStatusChangeTime:', dateError);
                }
            }
        }

        // Fetch time metrics from server
        function fetchTimeMetrics() {
            const params = new URLSearchParams({
                id: machineId
            });
            if (shiftId) params.append('shiftId', shiftId);
            if (shiftDate) params.append('shiftDate', shiftDate);
            if (shiftCode) params.append('shiftCode', shiftCode);

            return fetch(`/Machine/GetTimeMetrics?${params.toString()}`)
                .then(response => {
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
