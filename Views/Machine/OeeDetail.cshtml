        // Function untuk memastikan semua durasi update setiap detik dengan timestamp
        function ensureAllDurationsUpdate() {
            try {
                // 1. Update Time Metrics (Operating, Downtime, Rest Break, No Loading, Planned)
                // Ini sudah dipanggil dari timeMetricsInterval, tapi kita pastikan tetap update
                if (typeof updateTimeDisplay === 'function') {
