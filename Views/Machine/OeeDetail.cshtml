                    // ✅ CRITICAL: Update display immediately SEBELUM start interval
                    console.log('🔄 Calling updateRunningDisplay immediately...');
                    updateRunningDisplay();
                    console.log('✅ Initial updateRunningDisplay called');
                    
                    // ✅ CRITICAL: Start timer interval dengan updateRunningDisplay
                    runningTimerInterval = setInterval(() => {
                        try {
                            updateRunningDisplay();
                        } catch (error) {
                            console.error('❌ Error in updateRunningDisplay:', error);
                        }
                    }, 1000);
                    
                    console.log('✅ Timer interval started, ID:', runningTimerInterval);
                    
                    // ✅ VERIFICATION: Verifikasi timer benar-benar berjalan setelah beberapa detik
                    setTimeout(() => {
