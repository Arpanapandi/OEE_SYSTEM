    </script>
    <script>
            // ========== REAL-TIME TIME METRICS UPDATE ==========
            const machineId = '@Html.Raw(Model.MachineId)';
        let timeMetricsInterval = null;
        let realTimeCounter = 0; // Counter yang bertambah setiap detik
        let basePlannedSeconds = @Html.Raw(Model.PlannedProductionTime.TotalSeconds.ToString("F0"));
        let baseOperatingSeconds = @Html.Raw(Model.OperatingTime.TotalSeconds.ToString("F0"));
        let baseDowntimeSeconds = @Html.Raw(Model.DowntimeTotal.TotalSeconds.ToString("F0"));
        let baseRestBreakSeconds = @Html.Raw(Model.RestBreakTime.TotalSeconds.ToString("F0")); // ✅ Initial Rest Break from Model
        let baseNoLoadingSeconds = @Html.Raw(Model.NoLoadingTime.TotalSeconds.ToString("F0")); // ✅ Initial No Loading from Model
        const shiftMetaEl = document.getElementById('shift-meta');
        const shiftDate = shiftMetaEl?.dataset.shiftDate || '';
        const shiftCode = shiftMetaEl?.dataset.shiftCode || '';
        const shiftId = shiftMetaEl?.dataset.shiftId || '';
        let lastShiftKey = shiftMetaEl?.dataset.shiftKey || '';

        // Format seconds to HH:mm:ss
        function formatTime(seconds) {
            // Handle NaN, undefined, or invalid values
            if (isNaN(seconds) || seconds === null || seconds === undefined) {
                return "00:00:00";
            }
            
            // Ensure seconds is a valid number
            seconds = Math.max(0, Math.floor(Number(seconds)));
            
            const hours = Math.floor(seconds / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            const secs = seconds % 60;
            
            return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        // Start real-time counter
        function startTimeCounter() {
            // Clear existing interval
            if (timeMetricsInterval) {
                clearInterval(timeMetricsInterval);
                timeMetricsInterval = null;
            }

            // Update every second - PASTIKAN selalu dipanggil
            timeMetricsInterval = setInterval(() => {
                try {
                    realTimeCounter++; // Increment counter setiap detik
                    updateTimeDisplay(); // Update display setiap detik
                } catch (error) {
                    console.error('❌ Error in real-time counter:', error);
                }
            }, 1000);
            
            console.log('✅ Real-time counter started - akan update setiap detik');
            console.log('⏱️ Interval ID:', timeMetricsInterval);
            
            // Verify interval is running
            setTimeout(() => {
                if (timeMetricsInterval) {
                    console.log('✅ Real-time counter verified - running correctly');
                } else {
                    console.error('❌ Real-time counter failed to start!');
                }
            }, 2000);
        }

        // Store active job/downtime info - Initialize dari server-side data
        let hasActiveJob = @(Model.ActiveJob != null ? "true" : "false");
        let hasActiveDowntime = @(Model.HasActiveDowntime ? "true" : "false");
        
        // v2.1: Initialize granular flags from ViewModel
        let isNoLoading = @(Model.IsNoLoading ? "true" : "false"); 
        let hasActiveRestBreak = @(Model.HasActiveRestBreak ? "true" : "false");
        let isIdle = @(Model.IsIdle ? "true" : "false");
        
        let previousHasActiveJob = hasActiveJob;
        let previousHasActiveDowntime = hasActiveDowntime;

        // ========== PRODUCTION DURATION TIMER (PER ITEM) ==========
        // ✅ CATATAN: durasiProduksiSeconds dan durasiProduksiInterval sudah dideklarasikan di baris 1970-1973
        let isProduksiRunning = false;

        function updateDurasiProduksiDisplay() {
            const displayEl = document.getElementById('durasi-produksi-display');
            if (displayEl) {
                const hours = Math.floor(durasiProduksiSeconds / 3600);
                const minutes = Math.floor((durasiProduksiSeconds % 3600) / 60);
                const seconds = durasiProduksiSeconds % 60;
                displayEl.value = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
                
                // Update hidden input
                const hiddenEl = document.getElementById('hidden-durasi-seconds');
                if (hiddenEl) hiddenEl.value = durasiProduksiSeconds;
            }
        }

        function startDurasiProduksi() {
            if (durasiProduksiInterval) clearInterval(durasiProduksiInterval);
            isProduksiRunning = true;
            durasiProduksiInterval = setInterval(() => {
                if(isProduksiRunning) {
                    durasiProduksiSeconds++;
                    updateDurasiProduksiDisplay();
                }
            }, 1000);
            document.getElementById('durasi-produksi-display')?.classList.add('text-primary');
        }

        function stopDurasiProduksi() {
            isProduksiRunning = false;
            if (durasiProduksiInterval) {
                clearInterval(durasiProduksiInterval);
                durasiProduksiInterval = null;
            }
            document.getElementById('durasi-produksi-display')?.classList.remove('text-primary');
        }

        function resetDurasiProduksi() {
            stopDurasiProduksi();
            durasiProduksiSeconds = 0;
            updateDurasiProduksiDisplay();
            
            // Check auto start
            const autoStart = document.getElementById('toggle-auto-durasi')?.checked;
            if (autoStart) {
                startDurasiProduksi();
            }
        }

        // Initialize Timer Controls
        document.addEventListener('DOMContentLoaded', () => {
             const btnReset = document.getElementById('btn-reset-durasi');
             if(btnReset) {
                 btnReset.style.display = 'inline-block'; // Ensure visible
                 btnReset.addEventListener('click', resetDurasiProduksi);
             }

             // Start initially if auto-start is checked
             const autoStart = document.getElementById('toggle-auto-durasi')?.checked;
             if(autoStart) {
                 startDurasiProduksi();
             }
        });

        // ========== EVENT-DRIVEN TIMER ARCHITECTURE ==========
        // PRINSIP:
        // - Client menghitung durasi dari timestamp UTC
        // - SignalR hanya kirim START/STOP events
        // - Timer berjalan di client dengan setInterval(1000)

        // ========== RUNNING TIMER (Client-Side) ==========
        // ✅ CRITICAL: Semua variabel timer HARUS menggunakan window. prefix untuk menghindari duplikasi
        // window.runningStartTimeUtc - Timestamp UTC saat Running dimulai
        // window.runningTimerInterval - Interval ID untuk timer Running
        // window.lastChangeTimestamp - Timestamp terakhir status berubah
        // window.sinceLastChangeInterval - Interval ID untuk timer non-running (Rest Break, Line Stop, dll)

        // ========== SIGNALR CONNECTION ==========
        let oeeConnection = null;
        // ✅ PERBAIKAN: machineId sudah dideklarasikan di atas (line 4063), gunakan yang sudah ada
        const machineIdInt = parseInt(machineId) || 0;
        const currentMachineId = '@Html.Raw(Model.MachineId)';
        
        // ========== RUNNING TIMER FUNCTIONS ==========
        /**
         * Start Running timer dari UTC timestamp
         * startTimeUtc: ISO 8601 UTC timestamp
         */
        function startRunningTimer(startTimeUtc) {
            console.log('🔄 startRunningTimer called with:', startTimeUtc);
            
            // Clear existing interval first
            if (window.runningTimerInterval) {
                clearInterval(window.runningTimerInterval);
                window.runningTimerInterval = null;
            }
            
            // Gunakan MachineTimer yang sudah terpusat
            if (window.MachineTimer && typeof window.MachineTimer.start === 'function') {
                window.MachineTimer.start(startTimeUtc);
                
                // Set legacy compatibility variable just in case
                if (startTimeUtc) {
                    window.runningStartTimeUtc = new Date(startTimeUtc);
                }
            } else {
                console.error('❌ window.MachineTimer not found! Cannot start timer.');
            }
        }

        /**
         * Stop Running timer
         */
        function stopRunningTimer() {
            if (typeof window.stopAllTimers === 'function') {
                window.stopAllTimers();
            } else {
                console.warn('⚠️ window.stopAllTimers not found, falling back to manual cleanup');
                if (window.runningTimerInterval) {
                    clearInterval(window.runningTimerInterval);
                    window.runningTimerInterval = null;
                }
                window.runningStartTimeUtc = null;
            }
            console.log('⏹️ Running timer stopped via wrapper');
        }

        /**
         * Update Running display dengan durasi real-time
         * ✅ CRITICAL: Function ini dipanggil setiap detik untuk update "since-last-status"
         */
        function updateRunningDisplay() {
            // Update "since-last-status" timer jika ada
            const sinceLastStatusEl = document.getElementById('since-last-status');
            if (!sinceLastStatusEl) {
                console.warn('⚠️ since-last-status element not found');
                return;
            }

            // ✅ PRIORITAS 1: Jika runningStartTimeUtc ada, gunakan itu (event-driven, lebih akurat)
            if (runningStartTimeUtc) {
                // Gunakan waktu server yang disesuaikan jika tersedia untuk konsistensi
                let now;
                if (typeof window.getAdjustedServerTime === 'function') {
                    now = window.getAdjustedServerTime();
                } else {
                    now = new Date();
                }
                
                const elapsedSeconds = Math.max(0, Math.floor((now - runningStartTimeUtc) / 1000));
                
                // Debug logging setiap 10 detik untuk menghindari spam
                if (elapsedSeconds > 0 && elapsedSeconds % 10 === 0) {
                    console.log('🔄 updateRunningDisplay - elapsedSeconds:', elapsedSeconds, 'runningStartTimeUtc:', runningStartTimeUtc.toISOString());
                }
                
                // ✅ PERBAIKAN: Cek shift window dan stop otomatis saat shift habis
                const shiftMeta = document.getElementById('shift-meta');
                if (shiftMeta) {
                    const shiftDate = shiftMeta.getAttribute('data-shift-date');
                    const shiftCode = shiftMeta.getAttribute('data-shift-code');
                    
                    // Hitung shift end time berdasarkan shift code
                    // Shift 1: 07:30 - 19:30
                    // Shift 2: 19:30 - 07:30 (hari berikutnya)
                    let shiftEndTime = null;
                    if (shiftCode === '1') {
                        // Shift 1: 19:30 hari yang sama
                        const shiftDateObj = new Date(shiftDate + 'T19:30:00');
                        shiftEndTime = shiftDateObj;
                    } else if (shiftCode === '2') {
                        // Shift 2: 07:30 hari berikutnya
                        const shiftDateObj = new Date(shiftDate);
                        shiftDateObj.setDate(shiftDateObj.getDate() + 1);
                        shiftDateObj.setHours(7, 30, 0, 0);
                        shiftEndTime = shiftDateObj;
                    }
                    
                    // ✅ CRITICAL: Jika sudah melewati shift end time, stop timer dan reset ke 00:00:00
                    if (shiftEndTime && now > shiftEndTime) {
                        console.log('⏹️ Shift ended, stopping running timer. Shift end:', shiftEndTime.toISOString(), 'Current time:', now.toISOString());
                        
                        // Stop running timer interval
                        if (window.runningTimerInterval) {
                            clearInterval(window.runningTimerInterval);
                            window.runningTimerInterval = null;
                        }
                        if (typeof runningTimerInterval !== 'undefined' && runningTimerInterval) {
                            clearInterval(runningTimerInterval);
                            runningTimerInterval = null;
                        }
                        
                        // Clear runningStartTimeUtc
                        if (window.runningStartTimeUtc) {
                            window.runningStartTimeUtc = null;
                        }
                        
                        // Reset display ke 00:00:00
                        sinceLastStatusEl.textContent = '00:00:00';
                        
                        // Update status mesin jika perlu
                        if (typeof window.updateMachineStatusUI === 'function') {
                            window.updateMachineStatusUI('Tidak Aktif', 'Shift Ended');
                        }
                        
                        return;
                    }
                }
                
                sinceLastStatusEl.textContent = formatTime(elapsedSeconds);
                // Update lastChangeTimestamp untuk fallback
                window.lastChangeTimestamp = window.runningStartTimeUtc;
                return;
            }

            // ✅ PRIORITAS 2: Fallback: gunakan lastChangeTimestamp jika ada (sistem lama)
            if (window.lastChangeTimestamp) {
                const now = new Date();
                const diffMs = now.getTime() - window.lastChangeTimestamp.getTime();
                const totalSeconds = Math.max(0, Math.floor(diffMs / 1000));
                sinceLastStatusEl.textContent = formatTime(totalSeconds);
                return;
            }

            // Jika tidak ada timestamp, tampilkan 00:00:00
            sinceLastStatusEl.textContent = '00:00:00';
        }
        
        // ========== SIGNALR EVENT HANDLERS ==========
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof signalR === 'undefined') {
                console.error('❌ SignalR library not loaded!');
                return;
            }

            console.log('🚀 Initializing SignalR connection for OEE events...');

            oeeConnection = new signalR.HubConnectionBuilder()
                .withUrl("/oeeHub")
                .withAutomaticReconnect({
                    nextRetryDelayInMilliseconds: retryContext => {
                        if (retryContext.elapsedMilliseconds < 2000) return 0;
                        if (retryContext.elapsedMilliseconds < 5000) return 2000;
                        if (retryContext.elapsedMilliseconds < 10000) return 5000;
                        return 10000;
                    }
                })
                .build();


            // ========== EVENT: RunningStarted ==========
            oeeConnection.on("RunningStarted", function (machineId, startTimeUtc) {
                if (machineId !== machineIdInt) return; // Filter by machineId

                console.log('📡 RunningStarted event received:', startTimeUtc);
                // Restart timer dengan timestamp dari server (lebih akurat)
                startRunningTimer(startTimeUtc);
            });

            // ========== EVENT: RunningStopped ==========
            oeeConnection.on("RunningStopped", function (machineId, endTimeUtc, totalSeconds) {
                if (machineId !== machineIdInt) return; // Filter by machineId

                console.log('📡 RunningStopped event received:', endTimeUtc, totalSeconds);
                stopRunningTimer();
            });

            // ========== EVENT: OeeUpdated ==========
            oeeConnection.on("OeeUpdated", function (data) {
                if (!data || !data.MachineId) return;
                
                const dataMachineId = typeof data.MachineId === 'string' ? data.MachineId : data.MachineId.toString();
                const currentMachineId = machineIdInt.toString();
                
                if (dataMachineId !== currentMachineId) return;

                console.log('📡 OeeUpdated event received:', data);

                // ✅ Update button states berdasarkan status
