                    const shiftCode = shiftMeta.getAttribute('data-shift-code');
                    
                    // Hitung shift end time berdasarkan shift code
                    // Shift 1: 07:30 - 19:30
                    // Shift 2: 19:30 - 07:30 (hari berikutnya)
                    let shiftEndTime = null;
                    if (shiftCode === '1') {
                        // Shift 1: 19:30 hari yang sama
                        const shiftDateObj = new Date(shiftDate + 'T19:30:00');
                        shiftEndTime = shiftDateObj;
                    } else if (shiftCode === '2') {
