@model OeeSystem.Models.ViewModels.MachineOeeViewModel
@{
    ViewData["Title"] = "OEE Detail - " + Model.MachineName;
    ViewData["IsOeeDetailPage"] = true;
    ViewData["MachineName"] = Model.MachineName;
    ViewData["LineId"] = Model.LineId;
    ViewData["ShiftName"] = string.IsNullOrEmpty(Model.ShiftName) ? $"Shift {Model.ShiftCode}" : Model.ShiftName;
    ViewData["ShiftTime"] = $"{Model.ShiftStart:HH:mm} - {Model.ShiftEnd:HH:mm}";
    ViewData["StandarCycleTime"] = Model.StandarCycleTime.ToString("F1");
    ViewData["MachineStatus"] = Model.Status;
    
    var shiftDateStr = Model.ShiftDate.ToString("yyyy-MM-dd");
    var shiftStartStr = Model.ShiftStart.ToString("HH:mm");
    var shiftEndStr = Model.ShiftEnd.ToString("HH:mm");
}


<!-- ✅ Status badge dan back button sudah dipindahkan ke navbar -->

<div id="shift-meta"
     data-shift-key="@Model.ShiftKey"
     data-shift-date="@shiftDateStr"
     data-shift-code="@Model.ShiftCode"
     data-shift-id="@(Model.ShiftId?.ToString() ?? "")"></div>

<!-- ✅ Filter Section - Card terpisah di atas Machine Actions -->
<!-- Card Filter: Shift, Jam (kiri), Tanggal (kanan) -->
<div class="row mb-3">
    <div class="col-12">
        <div class="glass-card" id="filter-card">
            <div class="glass-card-header" style="padding: 0.75rem 1rem;">
                <i class="fa-solid fa-clock me-2"></i>Waktu Kerja Operator
            </div>
            <div class="glass-card-body" style="padding: 0.75rem 1rem;">
                <div class="row g-3 align-items-center">
                    <!-- Jam Proses (Left) -->
                    <div class="col-6">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-glass text-secondary">
                                <i class="bi bi-clock text-accent-blue"></i>
                            </span>
                            <div class="form-control-glass d-flex align-items-center justify-content-center fw-bold font-monospace" style="letter-spacing: 1px; min-height: 38px;">
                                <span id="realtimeClock">Loading...</span>
                            </div>
                        </div>
                        <div class="text-center mt-1">
                            <small class="text-secondary"><i class="fa-solid fa-hourglass-half me-1"></i>Jam Proses</small>
                        </div>
                    </div>
                    
                    <!-- Date Input (Right) -->
                    <div class="col-6">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-glass text-secondary">
                                <i class="fa-solid fa-calendar-day"></i>
                            </span>
                            <input type="date" 
                                   class="form-control-glass text-center fw-bold" 
                                   id="filter-date" 
                                   name="filterDate"
                                   style="letter-spacing: 1px;"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="text-center mt-1">
                            <small class="text-secondary"><i class="fa-solid fa-calendar-check me-1"></i>Tanggal</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Machine Actions Section - Compact with Inline Status -->
<div class="row mb-3">
    <div class="col-12">
        <div class="glass-card">
            <div class="glass-card-header d-flex justify-content-between align-items-center" style="padding: 0.75rem 1rem;">
                <div>
                    <i class="fa-solid fa-sliders me-2"></i>Machine Actions
                </div>
                <div>
                    <span class="badge @(Model.MachineStatus == MachineStatus.Aktif ? "bg-success" : "bg-warning")" id="machine-status-badge">
                        @(Model.MachineStatus == MachineStatus.Aktif ? "AKTIF" : "TIDAK AKTIF")
                    </span>
                    @if (Model.MachineStatus == MachineStatus.TidakAktif)
                    {
                        <span class="small text-warning ms-2" id="machine-status-info">
                            <i class="fa-solid fa-exclamation-triangle me-1"></i>Machine di-set Tidak Aktif di Admin
                        </span>
                    }
                    
                    <span class="small text-danger ms-2" id="downtime-description" style="@(Model.HasActiveDowntime && !string.IsNullOrEmpty(Model.ActiveDowntimeDescription) ? "" : "display:none;")">
                        @(Model.HasActiveDowntime ? Model.ActiveDowntimeDescription : "")
                    </span>
                </div>
            </div>
            <div class="glass-card-body" style="padding: 0.75rem 1rem;">
                <!-- Action Buttons -->
                <div class="row g-2 justify-content-center text-center">
                    <!-- Running Button -->
                    <div class="col-md-3 col-6">
                        <button type="button" 
                                id="btn-running" 
                                class="btn w-100 btn-outline-success machine-action-btn">
                            <i class="fa-solid fa-play-circle me-1"></i>
                            Running
                        </button>
                    </div>

                    <!-- Rest Break Button -->
                    @if (Model.RestReason != null)
                    {
                        <div class="col-md-3 col-6">
                            <form id="rest-form" style="margin: 0;">
                                <input type="hidden" name="reasonId" value="@Model.RestReason.Id" />
                                <button type="button" 
                                        id="btn-rest" 
                                        class="btn w-100 btn-outline-warning machine-action-btn"
                                        onclick="window.handleRestClick(this)">
                                    <i class="fa-solid fa-pause-circle me-1"></i>
                                    Rest Break
                                </button>
                            </form>
                        </div>
                    }

                    <!-- Line Stop Button -->
                    <div class="col-md-3 col-6">
                        <button type="button" 
                                id="btn-line-stop" 
                                class="btn w-100 btn-outline-danger machine-action-btn"
                                data-bs-toggle="modal" 
                                data-bs-target="#lineStopModal">
                            <i class="fa-solid fa-stop-circle me-1"></i>
                            Line Stop
                        </button>
                    </div>

                    <!-- No Loading Button -->
                    <div class="col-md-3 col-6">
                        <button type="button" 
                                id="btn-no-loading" 
                                class="btn w-100 btn-outline-info machine-action-btn"
                                data-bs-toggle="modal" 
                                data-bs-target="#noLoadingModal">
                            <i class="fa-regular fa-hourglass-half me-1"></i>
                            NoLoading
                        </button>
                    </div>
                </div>
            </div>
            </div>
        </div>
    </div>


<!-- SCW (Stop Call Waiting) Section -->
<div class="row mb-3">
    <div class="col-12">
        <div class="glass-card">
            <div class="glass-card-header" style="padding: 0.75rem 1rem;">
                <i class="fa-solid fa-exclamation-triangle me-2"></i>SCW (Stop Call Waiting)
                </div>
            <div class="glass-card-body" style="padding: 0.75rem 1rem;">
                <div class="row g-3">
                    <!-- Jenis 4M Dropdown (50%) -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold mb-1">
                            <i class="fa-solid fa-list me-1"></i>Jenis 4M <span class="text-danger">*</span>
                        </label>
                        <select class="form-control-glass" id="scw-4m-type" name="scw4MTypeId" required>
                            <option value="">-- Pilih Jenis 4M --</option>
                            @if (ViewBag.Scw4MTypes != null)
                            {
                                @foreach (var type in ((List<OeeSystem.Models.Scw4MType>)ViewBag.Scw4MTypes).OrderBy(t => t.DisplayOrder))
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            }
                            else
                            {
                                <!-- ✅ DEBUG: ViewBag.Scw4MTypes is NULL -->
                                <option value="" disabled>Data tidak tersedia</option>
                            }
                        </select>
                        @if (ViewBag.Scw4MTypes == null)
                        {
                            <small class="text-danger">⚠️ ViewBag.Scw4MTypes is NULL</small>
                        }
                        else
                        {
                            <small class="text-success">✅ Loaded @((ViewBag.Scw4MTypes as List<OeeSystem.Models.Scw4MType>)?.Count ?? 0) types</small>
                        }
                    </div>
                    
                    <!-- Jenis Remark Dropdown (50%) -->
                    <div class="col-md-6 mb-2">
                        <label class="form-label fw-bold mb-1">
                            <i class="fa-solid fa-comment-dots me-1"></i>Jenis Remark <span class="text-danger">*</span>
                        </label>
                        <select class="form-control-glass" id="scw-remark" name="scwRemarkId" required>
                            <option value="">-- Pilih Jenis 4M terlebih dahulu --</option>
                            @if (ViewBag.ScwRemarks != null)
                            {
                                @foreach (var remark in (List<OeeSystem.Models.ScwRemark>)ViewBag.ScwRemarks)
                                {
                                    <option value="@remark.Id" data-parent-id="@remark.Scw4MTypeId" class="scw-remark-option" style="display:none;">@remark.Description</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                
                <!-- Action Button -->
                <div class="row mt-3">
                    <div class="col-md-6 offset-md-6 d-flex justify-content-end">
                        <button type="button" 
                                class="btn btn-primary" 
                                id="btn-scw-submit"
                                style="min-width: 200px; height: 38px;">
                            <i class="fa-solid fa-save me-1"></i>Simpan SCW
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- ========== MODALS ========== -->

<!-- Line Stop Modal -->
<div class="modal fade" id="lineStopModal" tabindex="-1" aria-labelledby="lineStopModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #1e1e1e; border: 1px solid #333;">
            <div class="modal-header" style="border-bottom: 1px solid #333;">
                <h5 class="modal-title" id="lineStopModalLabel">
                    <i class="fa-solid fa-stop-circle me-2 text-danger"></i>Line Stop
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="line-stop-form" onsubmit="return false;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="machineId" value="@Model.MachineId" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Alasan Line Stop <span class="text-danger">*</span>
                        </label>
                        <select class="form-control-glass" name="reasonId" required>
                            <option value="">-- Pilih Alasan --</option>
                            @if (ViewBag.DowntimeReasons != null)
                            {
                                @foreach (var reason in ((List<OeeSystem.Models.DowntimeReason>)ViewBag.DowntimeReasons).Where(r => r.Category == "Unplanned"))
                                {
                                    <option value="@reason.Id">@reason.Description</option>
                                }
                            }
                        </select>
                    </div>
                    
                    <div class="d-grid">
                        <button type="button" class="btn btn-danger" onclick="handleLineStopClick(this)">
                            <i class="fa-solid fa-save me-1"></i>Submit Line Stop
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- No Loading Modal -->
<div class="modal fade" id="noLoadingModal" tabindex="-1" aria-labelledby="noLoadingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #1e1e1e; border: 1px solid #333;">
            <div class="modal-header" style="border-bottom: 1px solid #333;">
                <h5 class="modal-title" id="noLoadingModalLabel">
                    <i class="fa-regular fa-hourglass-half me-2 text-info"></i>No Loading
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-secondary mb-3">
                    <i class="fa-solid fa-info-circle me-1"></i>
                    Konfirmasi untuk set status mesin menjadi No Loading
                </p>
                
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-info" onclick="handleNoLoadingClick(this)">
                        <i class="fa-solid fa-check me-1"></i>Ya, Set No Loading
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="fa-solid fa-times me-1"></i>Batal
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Scan Data Produksi Section -->
<div class="row mb-3 g-3">
    <!-- Left Side: Man Power & Injection -->
    <div class="col-12">
        <div class="card h-100">
            <div class="glass-card-header" style="padding: 0.75rem 1rem;">
                <i class="fa-solid fa-users me-2"></i>Man Power & Injection
            </div>
            <div class="glass-card-body" style="padding: 0.75rem 1rem;">
                <!-- Man Power Field -->
                <div class="mb-2">
                    <label class="form-label fw-bold">
                        Man Power <span class="text-danger">*</span>
                    </label>
                    <select class="form-control-glass" id="select-man-power" required>
                        <option value="">-- Pilih Man Power --</option>
                        @if (ViewBag.ManPowers != null)
                        {
                            @foreach (var mp in (List<OeeSystem.Models.ManPower>)ViewBag.ManPowers)
                            {
                                @if (mp.IsActive)
                                {
                                    @if (Model.ActiveJob?.ManPowerId == mp.Id)
                                    {
                                        <option value="@mp.Id" selected>@mp.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@mp.Id">@mp.Name</option>
                                    }
                                }
                            }
                        }
                    </select>
                </div>

                <!-- Injection Field -->
                <div class="mb-2">
                    <label class="form-label fw-bold">
                        Group Injection <span class="text-danger">*</span>
                    </label>
                    <div class="d-flex gap-2" role="group" id="injection-group">
                        <input type="radio" class="btn-check" name="injection" id="injection-merah" value="merah" required>
                        <label class="btn btn-outline-danger flex-fill" for="injection-merah">
                            <i class="fa-solid fa-circle me-1" style="color: #dc3545;"></i>Merah
                        </label>

                        <input type="radio" class="btn-check" name="injection" id="injection-biru" value="biru" required>
                        <label class="btn btn-outline-primary flex-fill" for="injection-biru">
                            <i class="fa-solid fa-circle me-1" style="color: #0d6efd;"></i>Biru
                        </label>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Right Side: Scan Data Produksi (100% width) -->
    <div class="col-12">
        <div class="card h-100">
            <div class="glass-card-header" style="padding: 0.75rem 1rem;">
                <i class="fa-solid fa-qrcode me-2"></i>Input Data Produksi
            </div>
            <div class="glass-card-body" style="padding: 0.75rem 1rem;">
                <!-- Nomor Lot Field (dipindahkan ke atas) -->
                <div class="mb-3">
                    <label class="form-label fw-bold mb-2">
                        Nomor Lot <span class="text-danger">*</span>
                    </label>
                    <div class="input-group position-relative">
                        <button type="button" 
                                class="btn btn-outline-primary border-end-0" 
                                id="btn-scan-nomor-lot"
                                style="border-top-right-radius: 0; border-bottom-right-radius: 0; z-index: 1; pointer-events: auto !important; cursor: pointer !important;">
                            <i class="fa-solid fa-qrcode"></i>
                        </button>
                        <input type="text" 
                               class="form-control border-start-0 border-end-0" 
                               id="input-nomor-lot" 
                               placeholder="Scan Barcode/QR atau ketik manual"
                               style="padding-left: 0.5rem;"
                                autocomplete="off"
                                maxlength="12"
                                oninput="if(this.value.length>12) this.value=this.value.slice(0,12);"
                                required />
                        <button type="button" 
                                class="btn btn-outline-primary border-start-0" 
                                id="btn-edit-nomor-lot"
                                style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                            <i class="fa-solid fa-pencil"></i>
                        </button>
                    </div>
                </div>

                <!-- Lot Bo Field (dipindahkan ke bawah, sebelumnya Part Number) -->
                <div class="mb-3">
                    <label class="form-label fw-bold mb-2">
                        Lot BO <span class="text-danger">*</span>
                    </label>
                    <div class="input-group position-relative">
                        <button type="button" 
                                class="btn btn-outline-primary border-end-0" 
                                id="btn-scan-lot-bo"
                                style="border-top-right-radius: 0; border-bottom-right-radius: 0; z-index: 1; pointer-events: auto !important; cursor: pointer !important;">
                            <i class="fa-solid fa-qrcode"></i>
                        </button>
                        <input type="text" 
                               class="form-control border-start-0 border-end-0" 
                               id="input-lot-bo" 
                                placeholder="Scan Barcode/QR atau ketik manual"
                               style="padding-left: 0.5rem;"
                                autocomplete="off"
                               maxlength="12"
                               oninput="if(this.value.length>12) this.value=this.value.slice(0,12);"
                               required />
                        <button type="button" 
                                class="btn btn-outline-primary border-start-0" 
                                id="btn-edit-lot-bo"
                                style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                            <i class="fa-solid fa-pencil"></i>
                        </button>
                    </div>
                </div>

                <!-- Nama Compound Field (BARU - ditambahkan di bawah Lot Bo) -->
                <div class="mb-3">
                    <label class="form-label fw-bold mb-2">
                        Nama Compound <span class="text-danger">*</span>
                    </label>
                    <div class="input-group position-relative">
                        <button type="button" 
                                class="btn btn-outline-primary border-end-0" 
                                id="btn-scan-nama-compound"
                                style="border-top-right-radius: 0; border-bottom-right-radius: 0; z-index: 1; pointer-events: auto !important; cursor: pointer !important;"
                                type="button">
                            <i class="fa-solid fa-qrcode"></i>
                        </button>
                        <input type="text" 
                               class="form-control border-start-0 border-end-0" 
                               id="input-nama-compound" 
                                placeholder="Scan Barcode/QR atau ketik manual"
                               style="padding-left: 0.5rem;"
                                autocomplete="off"
                               required />
                        <button type="button" 
                                class="btn btn-outline-primary border-start-0" 
                                id="btn-edit-nama-compound"
                                style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                            <i class="fa-solid fa-pencil"></i>
                        </button>
                    </div>
                </div>

                <!-- Input Berat Act (Manual dengan format decimal 2 angka di belakang koma) -->
                <div class="mb-3" id="berat-act-container" style="display: block;">
                    <label class="form-label fw-bold mb-2">
                        Berat Act <span class="text-danger">*</span>
                    </label>
                    <div class="input-group position-relative">
                        <input type="number" 
                               class="form-control text-center" 
                               id="input-berat-act" 
                               placeholder="0,00"
                               style="padding-left: 0.5rem; padding-right: 3.5rem;"
                               autocomplete="off"
                               min="0"
                               step="0.01"
                               value=""
                               required />
                        <div class="position-absolute" style="right: 0; top: 0; height: 100%; display: flex; flex-direction: column; z-index: 10; pointer-events: none;">
                            <button type="button" 
                                    class="btn btn-outline-secondary btn-sm h-50 d-flex align-items-center justify-content-center" 
                                    id="btn-increment-berat-act"
                                    onclick="event.preventDefault(); event.stopPropagation(); const input = document.getElementById('input-berat-act'); if(input){ const val = parseFloat(input.value) || 0; input.value = (val + 0.01).toFixed(2); input.dispatchEvent(new Event('input', {bubbles: true})); if(typeof checkAllInputsComplete === 'function') checkAllInputsComplete(); console.log('🔼 Plus clicked:', input.value); } return false;"
                                    style="border-top-right-radius: 0.375rem; border-bottom-right-radius: 0; border-left: none; border-top: none; border-right: none; padding: 0.25rem 0.5rem; pointer-events: auto !important; cursor: pointer !important; background-color: #f8f9fa; z-index: 11;">
                                <i class="fa-solid fa-plus" style="font-size: 0.75rem; pointer-events: none;"></i>
                            </button>
                            <button type="button" 
                                    class="btn btn-outline-secondary btn-sm h-50 d-flex align-items-center justify-content-center" 
                                    id="btn-decrement-berat-act"
                                    onclick="event.preventDefault(); event.stopPropagation(); const input = document.getElementById('input-berat-act'); if(input){ const val = parseFloat(input.value) || 0; if(val > 0){ input.value = Math.max(0, val - 0.01).toFixed(2); input.dispatchEvent(new Event('input', {bubbles: true})); if(typeof checkAllInputsComplete === 'function') checkAllInputsComplete(); console.log('🔽 Minus clicked:', input.value); } } return false;"
                                    style="border-top-right-radius: 0; border-bottom-right-radius: 0.375rem; border-left: none; border-top: 1px solid #ced4da; border-right: none; border-bottom: none; padding: 0.25rem 0.5rem; pointer-events: auto !important; cursor: pointer !important; background-color: #f8f9fa; z-index: 11;">
                                <i class="fa-solid fa-minus" style="font-size: 0.75rem; pointer-events: none;"></i>
                            </button>
                        </div>
                    </div>
                    <div class="text-danger small mt-1" id="berat-act-error" style="display: none;"></div>
                    <div class="text-success small mt-1" id="berat-act-success" style="display: none;"></div>
                </div>

                <!-- Penipisan Field (BARU) -->
                <div class="mb-3">
                    <label class="form-label fw-bold mb-2">
                        Penipisan <span class="text-danger">*</span>
                    </label>
                    <div class="d-flex gap-2" role="group" id="penipisan-group">
                        <input type="radio" class="btn-check" name="penipisan" id="penipisan-1-kali" value="1-kali" required>
                        <label class="btn btn-outline-primary flex-fill" for="penipisan-1-kali">
                            1 Kali
                        </label>

                        <input type="radio" class="btn-check" name="penipisan" id="penipisan-2-kali" value="2-kali" required>
                        <label class="btn btn-outline-primary flex-fill" for="penipisan-2-kali">
                            2 Kali
                        </label>

                        <input type="radio" class="btn-check" name="penipisan" id="penipisan-tidak" value="tidak-penipisan" required>
                        <label class="btn btn-outline-primary flex-fill" for="penipisan-tidak">
                            Tidak Penipisan
                        </label>
                    </div>
                </div>

                <!-- Keterangan Field (BARU) -->
                <div class="mb-3">
                    <label class="form-label fw-bold mb-2">
                        Keterangan <span class="text-danger">*</span>
                    </label>
                    <select class="form-control-glass" id="select-keterangan" required>
                        <option value="">-- Pilih Keterangan --</option>
                        <option value="Oke">Oke</option>
                        <option value="CHAMBER A">CHAMBER A</option>
                        <option value="CHAMBER E">CHAMBER E</option>
                        <option value="CHAMBER N">CHAMBER N</option>
                        <option value="NG Berat">NG Berat</option>
                        <option value="NG Kontaminasi">NG Kontaminasi</option>
                        <option value="NG Scorch">NG Scorch</option>
                        <option value="NG Warna">NG Warna</option>
                        <option value="Giling Ulang">Giling Ulang</option>
                    </select>
                </div>

                <!-- Form Submit Scan Produksi (hidden form untuk data) -->
                <form id="form-scan-produksi" style="display: none;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="machineId" value="@Model.MachineId" />
                    <input type="hidden" id="hidden-lot-bo" name="lotBo" />
                    <input type="hidden" id="hidden-nomor-lot" name="nomorLot" />
                    <input type="hidden" id="hidden-nama-compound" name="namaCompound" />
                    <input type="hidden" id="hidden-berat-act" name="beratAct" />
                    <input type="hidden" id="hidden-penipisan" name="penipisan" />
                    <input type="hidden" id="hidden-keterangan" name="keterangan" />
                    <input type="hidden" id="hidden-man-power" name="manPowerId" />
                    <input type="hidden" id="hidden-injection" name="injection" />
                    <input type="hidden" id="hidden-komponen-id" name="komponenId" />
                    <input type="hidden" id="hidden-durasi-seconds" name="durasiSeconds" value="0" />
                </form>

                <!-- Tombol Submit (langsung tampil di bawah Line) -->
                <div class="mb-3 d-flex justify-content-end" id="submit-container">
                    <button type="button" 
                            class="btn btn-primary" 
                            id="btn-submit-produksi"
                            style="min-width: 200px; height: 38px;">
                        <i class="fa-solid fa-paper-plane me-2"></i>Submit Data Produksi
                    </button>
                </div>

                <!-- Durasi Produksi per Item -->
                <div class="mb-3" id="durasi-produksi-container" style="display: block;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0">
                            <i class="fa-solid fa-clock me-1"></i>Durasi Produksi
                        </label>
                        <div class="d-flex gap-2">
                             <button type="button" class="btn btn-sm btn-outline-danger" id="btn-reset-durasi">
                                <i class="fa-solid fa-stop-circle me-1"></i>Reset & Stop
                            </button>
                        </div>
                    </div>
                    
                    <div class="card border-primary" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                        <div class="card-body text-center p-2">
                            <input type="text" 
                                   class="form-control border-0 text-center fw-bold bg-transparent" 
                                   id="durasi-produksi-display" 
                                   value="00:00:00"
                                   readonly
                                   style="font-size: 1.5rem; color: #0d6efd; letter-spacing: 2px; box-shadow: none;">
                             
                             <!-- Status Indicator -->
                             <div id="timer-status-text" class="small text-primary mt-1 fw-bold">
                                 <i class="fa-solid fa-spinner fa-spin me-1"></i>Running
                             </div>
                        </div>
                    </div>
                    <div class="mt-1 text-end">
                        <small class="text-muted fst-italic">Timer restart otomatis setelah submit</small>
                    </div>
                </div>

                <!-- Button QUANTITY (dipindahkan dari Current Job) -->
                <div class="mb-3 mt-3">
                    <button type="button" 
                            class="btn btn-primary w-100"
                            data-bs-toggle="modal" 
                            data-bs-target="#addQtyModal"
                            style="height: 38px;">
                        <i class="fa-solid fa-plus-circle me-1"></i>
                        QUANTITY
                    </button>
                </div>

                <!-- Dropdown Komponen (muncul setelah Part Number dan Nomor Lot Produksi diisi) -->
                <div class="mb-2" id="komponen-container" style="display: none;">
                    <label class="form-label fw-bold">
                        Komponen <span class="text-danger">*</span>
                    </label>
                    <select class="form-control-glass" id="select-komponen" required>
                        <option value="">-- Pilih Komponen --</option>
                    </select>
                    <div class="text-danger small mt-1" id="komponen-error" style="display: none;"></div>
                    <div class="text-success small mt-1" id="komponen-success" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Current Job Section (dipindahkan setelah Input Data Produksi) -->
<div class="row mb-3">
    <!-- Current Job -->
    <div class="col-12">
        <div class="card h-100" id="current-job-card" style="margin-bottom: 0;">
            <div class="glass-card-header" style="padding: 0.75rem 1rem;">
                <i class="fa-solid fa-clipboard-list me-2"></i>Current Job
            </div>
            <div class="card-body d-flex flex-column" style="padding: 0.75rem 1rem;">
                @if (Model.ActiveJob != null)
                {
                    <div class="row gy-1 gx-1 h-100">
                        <!-- Left Section: Product Image/Name -->
                        <div class="col-5 d-flex flex-column">
                            <div class="mb-1">
                                @{ var imageUrl = Model.ActiveJob?.ProductImageUrl ?? ""; }
                                @if (!string.IsNullOrEmpty(imageUrl))
                                {
                                    <img src="@imageUrl" 
                                         alt="@(Model.ActiveJob?.ProductName ?? "Product")" 
                                         class="img-fluid rounded mb-2" 
                                         style="max-height: 200px; max-width: 100%; width: auto; height: auto; object-fit: contain;"
                                         onerror="this.onerror=null; this.style.display='none'; const placeholder = this.nextElementSibling; if (placeholder) placeholder.classList.remove('d-none');" />
                                    <div class="d-none d-flex align-items-center justify-content-center bg-light rounded mb-2" 
                                         style="max-height: 200px; min-height: 150px;">
                                        <span class="text-muted"><i class="fa-solid fa-image me-2"></i>Image not found</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light rounded mb-2" 
                                         style="max-height: 200px; min-height: 150px;">
                                        <span class="text-muted"><i class="fa-solid fa-image me-2"></i>No image available</span>
                                    </div>
                                }
                            </div>
                            <div class="mt-auto">
                                <div class="fw-semibold small">@(Model.ActiveJob?.ProductName ?? "Unknown Product")</div>
                                <div class="text-secondary small">@(Model.ActiveJob?.WorkOrderNumber ?? "-")</div>
                            </div>
                        </div>
                        
                        <!-- Right Section: Progress & Info -->
                        <div class="col-7 d-flex flex-column ps-2">
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Progress</span>
                                    <span id="progress-text">@Model.GoodCount / @(Model.ActiveJob?.TargetQuantity ?? 0)</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    @{
                                        var targetQty = Model.ActiveJob?.TargetQuantity ?? 0;
                                        var progressPercent = targetQty > 0 
                                            ? (Model.GoodCount * 100.0 / targetQty) 
                                            : 0;
                                        if (progressPercent > 100) progressPercent = 100;
                                    }
                                    <div id="progress-bar" class="progress-bar bg-primary" role="progressbar" style="width: @progressPercent.ToString("F1")%;" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">
                                        <span id="progress-percent" class="small">@progressPercent.ToString("F1")%</span>
                                    </div>
                                </div>
                                <div class="small mt-1 text-secondary">
                                    Total Good: <span id="total-good" class="fw-bold text-success">@Model.GoodCount</span> • 
                                    Reject: <span id="total-reject" class="fw-bold text-danger">@Model.RejectCount</span>
                                </div>
                                @if ((Model.ActiveJob?.TargetQuantity ?? 0) > 0)
                                {
                                    <div class="small mt-1 text-info">
                                        <i class="fa-solid fa-clock me-1"></i>
                                        Est. Completion: <span id="estimated-completion">@(ViewData["EstimatedCompletion"] ?? "-")</span>
                                    </div>
                                }
                            </div>
                            <div class="mt-auto">
                                <!-- Durasi sejak status terakhir - Prominent -->
                                <div class="pt-2 border-top">
                                    <div class="text-secondary small mb-1">Durasi sejak status terakhir</div>
                                    <div class="fs-4 fw-bold text-primary" id="since-last-status">
                                        @{
                                            var sinceLastChangeSeconds = Model.ActiveJob?.SinceLastChangeSeconds ?? 0;
                                            var sinceLastChange = TimeSpan.FromSeconds(sinceLastChangeSeconds);
                                        }
                                        @sinceLastChange.ToString(@"hh\:mm\:ss")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center text-secondary py-5 my-auto">
                        <i class="fa-solid fa-inbox fa-3x mb-3 opacity-50"></i>
                        <div class="fw-semibold">No active job</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal for Scanner -->
<div class="modal fade" id="scannerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Scan <span id="scanner-target-label">Barcode/QR Code</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="scanner-container" style="width: 100%; min-height: 300px; position: relative;">
                    <!-- ✅ PERBAIKAN: Quagga2 scanner dengan bounding box -->
                    <div id="scanner-reader" style="width: 100%; position: relative; background-color: #000;">
                        <canvas id="scanner-canvas" style="display: none;"></canvas>
                        <video id="scanner-video" style="width: 100%; height: auto; display: block;"></video>
                        <!-- Bounding box overlay yang mengikuti barcode -->
                        <div id="scanner-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;"></div>
                    </div>
                    <!-- ✅ PERBAIKAN: Tombol untuk switch camera -->
                    <div class="text-center mt-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btn-switch-camera" style="display: none;">
                            <i class="fa-solid fa-camera-rotate me-1"></i>Switch Camera
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btn-stop-scanner">Stop Scanner</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- OEE KPI Cards -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card kpi-card border-primary" style="margin-bottom: 0;">
            <div class="glass-card-body" style="padding: 1.25rem;">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-secondary small mb-1">OEE</div>
                        <div class="kpi-value text-primary" id="oee-value">@Model.Oee.ToString("F0")%</div>
                    </div>
                    <i class="fa-solid fa-chart-line fa-2x text-primary opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card border-success" style="margin-bottom: 0;">
            <div class="glass-card-body" style="padding: 1.25rem;">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-secondary small mb-1">Availability</div>
                        <div class="kpi-value text-success" id="availability-value">@Model.Availability.ToString("F0")%</div>
                    </div>
                    <i class="fa-solid fa-clock fa-2x text-success opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card border-warning" style="margin-bottom: 0;">
            <div class="glass-card-body" style="padding: 1.25rem;">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-secondary small mb-1">Performance</div>
                        <div class="kpi-value text-warning" id="performance-value">@Model.Performance.ToString("F0")%</div>
                    </div>
                    <i class="fa-solid fa-gauge-high fa-2x text-warning opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card border-info" style="margin-bottom: 0;">
            <div class="glass-card-body" style="padding: 1.25rem;">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-secondary small mb-1">Quality</div>
                        <div class="kpi-value text-info" id="quality-value">@Model.Quality.ToString("F0")%</div>
                    </div>
                    <i class="fa-solid fa-check-circle fa-2x text-info opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <!-- Time Metrics -->
    <div class="col-12">
        <div class="card h-100" style="margin-bottom: 0;">
            <div class="glass-card-header" style="padding: 1rem 1.25rem;">
                <i class="fa-solid fa-clock me-2"></i>Time Metrics
            </div>
            <div class="card-body d-flex flex-column" style="padding: 1.25rem;">
                <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Planned Production</span>
                        <span class="fw-semibold" id="planned-production-time">@Model.PlannedProductionTime.ToString(@"hh\:mm\:ss")</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-primary" style="width: 100%"></div>
                    </div>
                </div>
                <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Operating Time</span>
                        <span class="fw-semibold text-success" id="operating-time">@Model.OperatingTime.ToString(@"hh\:mm\:ss")</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: #e9ecef;">
                        @{
                            var operatingPercent = Model.PlannedProductionTime.TotalSeconds > 0 
                                ? (Model.OperatingTime.TotalSeconds / Model.PlannedProductionTime.TotalSeconds * 100) 
                                : 0;
                            
                            // Logika warna dinamis: Hijau >=80%, Kuning 50-80%, Merah <50%
                            string operatingColor;
                            if (operatingPercent >= 80)
                            {
                                operatingColor = "#28a745";
                            }
                            else if (operatingPercent >= 50)
                            {
                                operatingColor = "#ffc107";
                            }
                            else
                            {
                                operatingColor = "#dc3545";
                            }
                        }
                        <div class="progress-bar" id="operating-progress-bar" style="width: @operatingPercent.ToString("F1")%; background-color: @operatingColor !important; min-width: 2px;"></div>
                    </div>
                </div>
                <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Downtime</span>
                        <span class="fw-semibold text-danger" id="downtime-total">@Model.DowntimeTotal.ToString(@"hh\:mm\:ss")</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: #e9ecef;">
                        @{
                            var downtimePercent = Model.PlannedProductionTime.TotalSeconds > 0 
                                ? (Model.DowntimeTotal.TotalSeconds / Model.PlannedProductionTime.TotalSeconds * 100) 
                                : 0;
                            
                            // Logika warna dinamis: Merah >20%, Kuning 10-20%, Hijau <10%
                            string downtimeColor;
                            if (downtimePercent > 20)
                            {
                                downtimeColor = "#dc3545";
                            }
                            else if (downtimePercent > 10)
                            {
                                downtimeColor = "#ffc107";
                            }
                            else
                            {
                                downtimeColor = "#28a745";
                            }
                        }
                        <div class="progress-bar" id="downtime-progress-bar" style="width: @downtimePercent.ToString("F1")%; background-color: @downtimeColor !important; min-width: 2px;"></div>
                    </div>
                </div>
                <!-- ✅ PERBAIKAN: Tambahkan Rest Break -->
                <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Rest Break</span>
                        <span class="fw-semibold text-warning" id="rest-break-time">00:00:00</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: #e9ecef;">
                        @{
                            var restBreakPercent = 0;
                        }
                        <div class="progress-bar" id="rest-break-progress-bar" style="width: @restBreakPercent.ToString("F1")%; background-color: #ffc107 !important; min-width: 2px;"></div>
                    </div>
                </div>
                <!-- ✅ PERBAIKAN: Tambahkan No Loading -->
                <div class="mt-auto">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">No Loading</span>
                        <span class="fw-semibold text-info" id="no-loading-time">00:00:00</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: #e9ecef;">
                        @{
                            var noLoadingPercent = 0;
                        }
                        <div class="progress-bar" id="no-loading-progress-bar" style="width: @noLoadingPercent.ToString("F1")%; background-color: #0dcaf0 !important; min-width: 2px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Production Metrics -->
    <div class="col-12">
        <div class="card h-100" style="margin-bottom: 0;">
            <div class="glass-card-header" style="padding: 1rem 1.25rem;">
                <i class="fa-solid fa-boxes me-2"></i>Production Metrics
            </div>
            <div class="card-body d-flex flex-column" style="padding: 1.25rem;">
                <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-primary">
                            <i class="fa-solid fa-box me-1"></i>Total Produced
                        </span>
                        <span class="fw-semibold text-primary">@Model.TotalCount</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-primary" style="width: 100%"></div>
                    </div>
                </div>
                <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fw-semibold" style="color: #28a745 !important;">
                            <i class="fa-solid fa-check-circle me-1"></i>Good
                        </span>
                        <span class="fw-bold" style="color: #28a745 !important;">@Model.GoodCount</span>
                    </div>
                    <div class="progress" style="height: 8px; background-color: #e9ecef;">
                        @{
                            var goodPercent = Model.TotalCount > 0 ? (Model.GoodCount * 100.0 / Model.TotalCount) : 0;
                            
                            // Logika warna dinamis: Hijau >=95%, Kuning 80-95%, Merah <80%
                            string goodColor;
                            if (goodPercent >= 95)
                            {
                                goodColor = "#28a745";
                            }
                            else if (goodPercent >= 80)
                            {
                                goodColor = "#ffc107";
                            }
                            else
                            {
                                goodColor = "#dc3545";
                            }
                        }
                        <div class="progress-bar" id="good-progress-bar" style="width: @goodPercent.ToString("F1")%; background-color: @goodColor !important; min-width: 2px;"></div>
                    </div>
                </div>
                <div class="mt-auto">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fw-semibold" style="color: #dc3545 !important;">
                            <i class="fa-solid fa-times-circle me-1"></i>Reject
                        </span>
                        <span class="fw-bold" style="color: #dc3545 !important;">@Model.RejectCount</span>
                    </div>
                    <div class="progress" style="height: 8px; background-color: #e9ecef;">
                        @{
                            var rejectPercent = Model.TotalCount > 0 ? (Model.RejectCount * 100.0 / Model.TotalCount) : 0;
                            
                            // Logika warna dinamis: Merah >5%, Kuning 2-5%, Hijau <2%
                            string rejectColor;
                            if (rejectPercent > 5)
                            {
                                rejectColor = "#dc3545";
                            }
                            else if (rejectPercent > 2)
                            {
                                rejectColor = "#ffc107";
                            }
                            else
                            {
                                rejectColor = "#28a745";
                            }
                        }
                        <div class="progress-bar" id="reject-progress-bar" style="width: @rejectPercent.ToString("F1")%; background-color: @rejectColor !important; min-width: 2px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="row g-3 mb-3">
    <!-- Recent Downtimes -->
    <div class="col-12">
        <div class="card h-100" style="margin-bottom: 0;">
            <div class="glass-card-header" style="padding: 1rem 1.25rem;">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>Recent Downtimes
            </div>
            <div class="glass-card-body" style="padding: 1.25rem; display: flex; flex-direction: column; height: 100%; overflow: hidden;">
                @if (Model.RecentDowntimes != null && Model.RecentDowntimes.Any())
                {
                    <div class="table-responsive" style="height: 200px !important; max-height: 400px !important; overflow-y: auto; overflow-x: hidden; flex-shrink: 0;">
                        <table class="table table-dark table-sm mb-0">
                            <thead>
                                <tr>
                                    <th style="position: sticky; top: 0; background-color: #1f2937; z-index: 10;">Reason</th>
                                    <th style="position: sticky; top: 0; background-color: #1f2937; z-index: 10;">Start</th>
                                    <th style="position: sticky; top: 0; background-color: #1f2937; z-index: 10;">Duration</th>
                                    <th style="position: sticky; top: 0; background-color: #1f2937; z-index: 10;">Status</th>
                                </tr>
                            </thead>
                            <tbody id="recent-downtime-tbody">
                                @foreach (var dt in Model.RecentDowntimes)
                                {
                                    <tr>
                                        <td>
                                            <div class="small">@(dt.ReasonDescription ?? "-")</div>
                                            <div class="text-secondary" style="font-size: 0.7rem;">@(dt.ReasonCategory ?? "-")</div>
                                        </td>
                                        <td class="small">@dt.StartTime.ToString("MM/dd HH:mm")</td>
                                        <td>
                                            @if (dt.EndTime.HasValue)
                                            {
                                                <span class="text-success">@TimeSpan.FromSeconds(dt.DurationSeconds).ToString(@"hh\:mm\:ss")</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">Ongoing</span>
                                            }
                                        </td>
                                        <td>
                                            @if (dt.EndTime.HasValue)
                                            {
                                                <span class="badge bg-success">Closed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Active</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-secondary py-3">
                        <i class="fa-solid fa-check-circle fa-2x mb-2"></i>
                        <div>No downtime recorded</div>
                    </div>
                }
            </div>
            </div>
        </div>
    </div>

<!-- ✅ PERBAIKAN: Recent Production Counts (full width) -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="glass-card" style="margin-bottom: 0;">
            <div class="glass-card-header" style="padding: 1rem 1.25rem;">
                <i class="fa-solid fa-chart-column me-2"></i>Recent Production Counts
            </div>
            <div class="glass-card-body" style="padding: 1.25rem;">
                @if (Model.RecentProductionCounts != null && Model.RecentProductionCounts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Kode Part</th>
                                    <th class="text-end">QTY Planning</th>
                                    <th class="text-end">QTY Good</th>
                                    <th class="text-end">QTY NG</th>
                                    <th class="text-end">Achieve Rate</th>
                                    <th class="text-end">Rejection Rate</th>
                                    <th>Loading Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pc in Model.RecentProductionCounts)
                                {
                                    <tr>
                                        <td class="small">@pc.Timestamp.ToString("MM/dd HH:mm")</td>
                                        <td class="small">@(pc.PartCode ?? "-")</td>
                                        <td class="text-end">@pc.PlanningQty.ToString("N0")</td>
                                        <td class="text-end text-success">@pc.GoodCount.ToString("N0")</td>
                                        <td class="text-end text-danger">@pc.RejectCount.ToString("N0")</td>
                                        <td class="text-end">
                                            <span class="@(pc.AchieveRate >= 100 ? "text-success" : pc.AchieveRate >= 80 ? "text-warning" : "text-danger")">
                                                @pc.AchieveRate.ToString("F1")%
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <span class="@(pc.RejectionRate <= 5 ? "text-success" : pc.RejectionRate <= 10 ? "text-warning" : "text-danger")">
                                                @pc.RejectionRate.ToString("F1")%
                                            </span>
                                        </td>
                                        <td class="small">
                                            @if (pc.LoadingTime.HasValue)
                                            {
                                                @pc.LoadingTime.Value.ToString(@"hh\:mm\:ss")
                                            }
                                            else
                                            {
                                                <span class="text-secondary">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-secondary py-3">
                        <i class="fa-solid fa-inbox fa-2x mb-2"></i>
                        <div>No production counts</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

