        /**
         * Start Running timer dari UTC timestamp
         * startTimeUtc: ISO 8601 UTC timestamp
         */
        function startRunningTimer(startTimeUtc) {
            // Clear existing interval
            if (runningTimerInterval) {
                clearInterval(runningTimerInterval);
                runningTimerInterval = null;
            }
            
            // Parse UTC timestamp (support both string and Date object)
            if (typeof startTimeUtc === 'string') {
                runningStartTimeUtc = new Date(startTimeUtc);
            } else if (startTimeUtc instanceof Date) {
                runningStartTimeUtc = startTimeUtc;
            } else {
                console.error('❌ Invalid Running startTimeUtc type:', typeof startTimeUtc, startTimeUtc);
                return;
            }
            
            if (isNaN(runningStartTimeUtc.getTime())) {
                console.error('❌ Invalid Running startTimeUtc (NaN):', startTimeUtc);
                return;
            }

            console.log('🔄 Starting Running timer from UTC:', startTimeUtc, '→ Parsed:', runningStartTimeUtc.toISOString());

            // Update display immediately
            updateRunningDisplay();
            console.log('✅ Initial display updated');
                
                // Start interval untuk update setiap detik
            runningTimerInterval = setInterval(() => {
                updateRunningDisplay();
                }, 1000);
                
            console.log('✅ Running timer interval started, ID:', runningTimerInterval);
            console.log('✅ Timer will update "since-last-status" every 1 second');
                
            // ✅ CRITICAL: Verifikasi interval benar-benar berjalan
                setTimeout(() => {
                if (runningTimerInterval) {
                    const sinceLastStatusEl = document.getElementById('since-last-status');
