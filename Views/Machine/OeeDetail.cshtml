    <!-- Scanner Modal & Logic -->
    <style>
        /* Scanner Modal Styling */
        .scanner-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.95);
            z-index: 10000;
            display: none; /* Hidden by default */
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(5px);
        }
        
        .scanner-modal.active {
            display: flex;
        }

        .scanner-container {
            background: #1e1e1e;
            width: 100%;
            max-width: 600px;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            margin: 1rem;
            position: relative;
            border: 1px solid #333;
        }

        .scanner-header {
            padding: 1rem 1.5rem;
            background: #000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #333;
        }

        .scanner-header h3 {
            color: #fff;
            font-size: 1.25rem;
            margin: 0;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-close-scanner {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: #fff;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-close-scanner:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: rotate(90deg);
        }

        .scanner-viewport {
            position: relative;
            width: 100%;
            height: 50vh; 
            min-height: 300px;
            background: #000;
            overflow: hidden;
        }

        /* 
         * IMPORTANT: Generic selector for ANY video inside viewport 
         * Quagga might create its own or use ours.
         */
        .scanner-viewport video, #scanner-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }
        
        /* Quagga Canvas - Overlay for Bounding Box */
        .drawingBuffer, canvas.drawingBuffer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 5; /* Above video(1), below overlay(10) */
            pointer-events: none;
        }
        
        /* Overlay area - Topmost */
        .scanner-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 10;
        }
        
        /* Guide Box */
        .scanner-guide {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 70%;
            height: 40%;
            border: 2px solid rgba(255, 255, 255, 0.5);
            border-radius: 12px;
            box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.5);
        }
        
        /* Active Laser */
        .scanner-laser {
            position: absolute;
            top: 50%;
            left: 10%;
            right: 10%;
            height: 2px;
            background: #ff3b3b;
            box-shadow: 0 0 10px #ff3b3b, 0 0 5px #ff3b3b;
            animation: scan-vertical 2s infinite linear;
            z-index: 5;
        }
        
        @@keyframes scan-vertical {
            0% { top: 10%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: 90%; opacity: 0; }
        }
        
        .scanner-controls {
            padding: 1.5rem;
            background: #1e1e1e;
            border-top: 1px solid #333;
        }
    </style>

    <!-- Load Quagga2 from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@@ericblade/quagga2@1.8.4/dist/quagga.min.js"></script>

    <!-- Modal Elements -->
    <div id="scanner-modal-container">
        <div id="scanner-modal" class="scanner-modal">
            <div class="scanner-container">
                <div class="scanner-header">
                    <h3><i class="fa-solid fa-qrcode"></i> Scan Barcode</h3>
                    <button type="button" class="btn-close-scanner" id="btn-close-scanner" aria-label="Close">
                        <i class="fa-solid fa-times"></i>
                    </button>
                </div>
                <div class="scanner-body">
                    <div id="scanner-viewport" class="scanner-viewport">
                        <!-- Video Element -->
                        <video id="scanner-video" autoplay playsinline muted></video>
                        <!-- Canvas will be appended here by Quagga -->
                        
                        <div class="scanner-overlay">
                            <div class="scanner-guide"></div>
                            <div class="scanner-laser"></div>
                        </div>
                        <div id="scanner-feedback" class="position-absolute top-50 start-50 translate-middle bg-success text-white px-3 py-2 rounded shadow" style="display: none; z-index: 20;">
                            <i class="fa-solid fa-check-circle me-2"></i>Scanned!
                        </div>
                    </div>
                    <div class="scanner-controls">
                        <div class="mb-3">
                            <label class="form-label text-light small mb-1">Pilih Kamera:</label>
                            <select id="camera-select" class="form-select text-light border-secondary" style="background-color: #2b2b2b;">
                                <option value="">Mencari kamera...</option>
                            </select>
                        </div>
                        <div class="text-center">
                            <p class="text-muted small mb-0">Arahkan kamera ke Code 128 / QR Code</p>
                            <span id="scanner-engine-status" class="badge bg-secondary mt-1">Ready</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        /**
         * Universal Scanner v6.0 (Visual Feedback & State Fix)
         * - Adds Green Bounding Box on detected barcodes
         * - Fixes Button UI state (no active/focus lock)
         * - Maintains robust video cleanup
         */
        class BarcodeScannerService {
            constructor() {
                this.modal = document.getElementById('scanner-modal');
                this.viewport = document.getElementById('scanner-viewport');
                this.cameraSelect = document.getElementById('camera-select');
                this.closeBtn = document.getElementById('btn-close-scanner');
                this.feedback = document.getElementById('scanner-feedback');
                this.statusBadge = document.getElementById('scanner-engine-status');
                
                this.isScanning = false;
                this.activeTargetId = null;
                this._ctx = null; // Canvas Context for drawing
                
                this.initListeners();
            }

            initListeners() {
                if(this.closeBtn) this.closeBtn.onclick = () => this.stop();
                if(this.modal) this.modal.onclick = (e) => { if(e.target === this.modal) this.stop(); };
                
                if(this.cameraSelect) {
                    this.cameraSelect.onchange = () => {
                        if(this.isScanning) {
                            setTimeout(() => this.startScanner(this.cameraSelect.value), 200);
                        }
                    };
                }
                
                document.body.addEventListener('click', (e) => {
                    const btn = e.target.closest('button[id^="btn-scan-"]');
                    if (btn) {
                        e.preventDefault();
                        e.stopPropagation();
                        // Blur button immediately to prevent active state stuck
                        btn.blur();
                        
                        let targetId = '';
                        if (btn.id === 'btn-scan-lot-number') targetId = 'input-lot-number';
                        else if (btn.id === 'btn-scan-part-number') targetId = 'input-part-number';
                        else if (btn.id === 'btn-scan-nama-compound') targetId = 'input-nama-compound';
                        
                        if (targetId) this.open(targetId);
                    }
                });
            }

            async open(targetId) {
                this.activeTargetId = targetId;
                if(this.modal) this.modal.classList.add('active');
                
                this.updateStatus('Initializing...');
                this.isScanning = true;
                
                // Wait for modal transition
                await new Promise(r => setTimeout(r, 400));
                
                await this.populateCameras();
                await this.startScanner();
            }

            stop() {
                this.isScanning = false;
                if(this.modal) this.modal.classList.remove('active');
                
                if (typeof Quagga !== 'undefined') {
                    try { Quagga.stop(); } catch(e) {}
                }
                
                // Robust Stream Cleanup
                document.querySelectorAll('video').forEach(vid => {
                    if (vid.srcObject) {
                        try {
                            const tracks = vid.srcObject.getTracks();
                            tracks.forEach(t => t.stop());
                        } catch(e) {}
                        vid.srcObject = null;
                    }
                });
                
                this.activeTargetId = null;
                this.updateStatus('Stopped');
            }

            async populateCameras() {
                try {
                    if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) return;
                    
                    const devices = await navigator.mediaDevices.enumerateDevices();
                    const cameras = devices.filter(d => d.kind === 'videoinput');
                    
                    this.cameraSelect.innerHTML = '';
                    let backCam = null;
                    
                    if (cameras.length === 0) {
                         this.cameraSelect.innerHTML = '<option value="">No Camera</option>';
                         return;
                    }
                    
                    cameras.forEach(cam => {
                        const opt = document.createElement('option');
                        opt.value = cam.deviceId;
                        opt.text = cam.label || 'Camera ' + (this.cameraSelect.length + 1);
                        if ((cam.label||'').toLowerCase().match(/back|environment|belakang/)) {
                            backCam = cam.deviceId;
                            opt.text += ' (Back)';
                        }
                        this.cameraSelect.add(opt);
                    });
                    
                    if (backCam) this.cameraSelect.value = backCam;
                    else if (cameras.length) this.cameraSelect.selectedIndex = cameras.length - 1;
                    
                } catch(e) {
                    console.warn(e);
                }
            }

            async startScanner(deviceId = null) {
                if (!this.isScanning) return;
                this.updateStatus('Starting Camera...');
                
                if (typeof Quagga !== 'undefined') try{ Quagga.stop(); } catch(e){}
                
                // Cleanup viewport videos
                if(this.viewport) {
                    const existingVids = this.viewport.querySelectorAll('video');
                     existingVids.forEach(v => {
                        if(v.srcObject) {
                             try { v.srcObject.getTracks().forEach(t=>t.stop()); } catch(e){}
                             v.srcObject = null;
                        }
                    });
                }

                const constraints = {
                    width: { ideal: 1280 },
                    height: { ideal: 720 },
                };
                
                const selId = deviceId || this.cameraSelect.value;
                if (selId) constraints.deviceId = { exact: selId };
                else constraints.facingMode = "environment";
                
                Quagga.init({
                    inputStream: {
                        name: "Live",
                        type: "LiveStream",
                        target: this.viewport,
                        constraints: constraints,
                        area: { top: "10%", right: "10%", left: "10%", bottom: "10%" }
                    },
                    decoder: {
                        readers: ["code_128_reader", "ean_reader", "code_39_reader"],
                        multiple: false
                    },
                    locate: true, // Enable location for bounding box
                    frequency: 10
                }, (err) => {
                    if (err) {
                        console.error('Quagga Init Error:', err);
                        this.updateStatus('Error: ' + err.message);
                        return;
                    }
                    console.log("Quagga Ready");
                    Quagga.start();
                    this.updateStatus('Scanning...');
                    
                    this.startNativeQR();
                });
                
                // Visual Feedback: Bounding Box
                Quagga.onProcessed((result) => {
                    if (!result) return;
                    
                    const drawingCtx = Quagga.canvas.ctx.overlay;
                    const drawingCanvas = Quagga.canvas.dom.overlay;
            
                    if (result.boxes) {
                        drawingCtx.clearRect(0, 0, parseInt(drawingCanvas.getAttribute("width")), parseInt(drawingCanvas.getAttribute("height")));
                        result.boxes.filter((box) => box !== result.box).forEach((box) => {
                            Quagga.ImageDebug.drawPath(box, { x: 0, y: 1 }, drawingCtx, { color: "green", lineWidth: 2 });
                        });
                    }
            
                    if (result.box) {
                        Quagga.ImageDebug.drawPath(result.box, { x: 0, y: 1 }, drawingCtx, { color: "#00F", lineWidth: 2 });
                    }
            
                    if (result.codeResult && result.codeResult.code) {
                        Quagga.ImageDebug.drawPath(result.line, { x: 'x', y: 'y' }, drawingCtx, { color: 'red', lineWidth: 3 });
                    }
                });
                
                Quagga.offDetected();
                Quagga.onDetected(res => {
                    if (res?.codeResult?.code) this.handleScan(res.codeResult.code, 'Quagga');
                });
            }
            
            startNativeQR() {
                if (!('BarcodeDetector' in window)) return;
                
                setTimeout(() => {
                    const videoEl = this.viewport.querySelector('video');
                    if(!videoEl) return;
                    
                    const qr = new BarcodeDetector({formats:['qr_code']});
                    const loop = async () => {
                        if(!this.isScanning) return;
                        try {
                            if(videoEl.readyState >= 2) {
                                 const res = await qr.detect(videoEl);
                                 if(res.length) this.handleScan(res[0].rawValue, 'QR');
                            }
                        } catch(e){}
                        requestAnimationFrame(loop);
                    };
                    loop();
                }, 1000);
            }

            updateStatus(msg) {
                if(this.statusBadge) this.statusBadge.textContent = msg;
            }

            handleScan(code, src) {
                if(!code || code.length < 2) return;
                
                if(this._last === code && Date.now() - this._tm < 2000) return;
                this._last = code; this._tm = Date.now();
                
                console.log('Scan:', code, src);

                // ✅ VALIDATION for Length > 12 (Specific for Lot & Part Number)
                if (this.activeTargetId === 'input-lot-number' || this.activeTargetId === 'input-part-number') {
                    if (code.length > 12) {
                        console.warn('Scanned code too long:', code);
                        if (typeof showToast === 'function') {
                            showToast(`Code tidak sesuai! Maksimal 12 karakter.`, 'error');
                        } else {
                            alert(`Code tidak sesuai! Maksimal 12 karakter.`);
                        }
                        
                        // Close scanner but DO NOT fill input
                        setTimeout(() => {
                            this.stop();
                        }, 500);
                        return;
                    }
                }

                if(this.feedback) {
                    this.feedback.textContent = code;
                    this.feedback.style.display = 'block';
                }
                
                if (navigator.vibrate) navigator.vibrate([200]);
                
                // Inject Value without altering button state
                if (this.activeTargetId) {
                    const inp = document.getElementById(this.activeTargetId);
                    if(inp) {
                        inp.value = code;
                        // Trigger standard events for compatibility (React/Vue/etc if used in future)
                        inp.dispatchEvent(new Event('input', {bubbles:true}));
                        inp.dispatchEvent(new Event('change', {bubbles:true}));
                        
                        // Optional: Slight flash on INPUT field only, NOT button
                        const originalBg = inp.style.backgroundColor;
                        inp.style.backgroundColor = '#d1e7dd';
                        setTimeout(() => { inp.style.backgroundColor = originalBg; }, 300);
                    }
                }
                
                setTimeout(() => {
                    this.stop();
                    if(this.feedback) this.feedback.style.display = 'none';
                }, 800);
            }
        }

        window.addEventListener('load', () => {
             window.scannerService = new BarcodeScannerService();
             console.log('Scanner v6.0 Ready');
        });

        // Toast Notification System
        function showToast(message, type = 'info') {
            let container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                document.body.appendChild(container);
            }

            // Always enforce Top-Center position
            container.className = 'toast-container position-fixed top-0 start-50 translate-middle-x p-3';
            container.style.zIndex = '11000';
            container.style.marginTop = '20px';

            const id = 'toast-' + Date.now();
            const bgClass = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-primary';
            const icon = type === 'success' ? 'fa-check' : type === 'error' ? 'fa-circle-exclamation' : 'fa-info-circle';
            
            const html = `
                <div id="${id}" class="toast align-items-center text-white ${bgClass} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="fa-solid ${icon} me-2"></i>${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `;
            
            container.insertAdjacentHTML('beforeend', html);
            
            const toastEl = document.getElementById(id);
            const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
            toast.show();
            
            toastEl.addEventListener('hidden.bs.toast', () => {
                toastEl.remove();
            });
        }
    </script>
    </script>
    
    <!-- Design System Scripts -->
    <script>
        // Sidebar Toggle Logic
        document.getElementById('sidebarToggle').addEventListener('click', () => {
            const wrapper = document.getElementById('appWrapper');
            if (window.innerWidth <= 767) {
                wrapper.classList.toggle('mobile-nav-active');
            } else {
                wrapper.classList.toggle('collapsed');
            }
        });

        // Real-time Clock for Navbar
        function updateRealtimeClock() {
            const clockEl = document.getElementById('realtimeClock');
            if(clockEl) {
                const now = new Date();
                // Format: HH:mm:ss
                const timeStr = now.getHours().toString().padStart(2, '0') + ':' + 
                              now.getMinutes().toString().padStart(2, '0') + ':' + 
                              now.getSeconds().toString().padStart(2, '0');
                clockEl.textContent = timeStr;
            }
        }
        setInterval(updateRealtimeClock, 1000);
        updateRealtimeClock(); // Initial call

        // Responsive adjustment
        window.addEventListener('resize', () => {
            if (window.innerWidth > 767) {
                document.getElementById('appWrapper')?.classList.remove('mobile-nav-active');
            }
        });
    </script>




