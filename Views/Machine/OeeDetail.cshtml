        async function handleScanSuccess(decodedText) {
            // ✅ DUMMY MODE: Bypass validasi untuk testing
            const USE_DUMMY_VALIDATION = true; // Set ke false untuk menggunakan API real
            
            // ✅ PERBAIKAN: Validasi Part Number ke database jika target adalah part-number
            if (currentScanTarget === 'part-number') {
                if (!USE_DUMMY_VALIDATION) {
                    try {
                        const validateResponse = await fetch(`/api/Scanner/komponen/validate/${encodeURIComponent(decodedText.trim())}`);
                        const validateResult = await validateResponse.json();
                        
                        if (!validateResult.success) {
                            alert('Part Number tidak ditemukan di database: ' + decodedText + '\n\n' + (validateResult.message || ''));
                            return; // Jangan proses lebih lanjut jika tidak valid
                        }
                        
                        console.log('✅ Part Number validated:', decodedText);
                    } catch (err) {
                        console.error('❌ Error validating Part Number:', err);
                        alert('Error saat validasi Part Number. Silakan coba lagi.');
                        return;
                    }
                } else {
                    console.log(`✅ Part Number validated (DUMMY): "${decodedText}"`);
                }
            }
            
            // Stop scanner
            stopScanner();
            
            // Close modal
            const scannerModalEl = document.getElementById('scannerModal');
            if (scannerModalEl) {
                const scannerModal = bootstrap.Modal.getInstance(scannerModalEl);
                if (scannerModal) {
                    scannerModal.hide();
                }
            }
            
            // Fill input field based on target
            if (currentScanTarget === 'part-number') {
                const input = document.getElementById('input-part-number');
                if (input) {
                    input.value = decodedText;
                    input.dispatchEvent(new Event('input'));
                    showScanSuccess('part-number');
                    // ✅ PERBAIKAN: Load komponen setelah scan part number (tunggu lot number juga terisi)
                    setTimeout(() => {
                        checkAndLoadKomponen();
                    }, 500);
                }
            } else if (currentScanTarget === 'lot-number') {
                const input = document.getElementById('input-lot-number');
                if (input) {
                    input.value = decodedText;
                    input.dispatchEvent(new Event('input'));
                    showScanSuccess('lot-number');
                    // ✅ PERBAIKAN: Check komponen setelah scan lot number (jika part number sudah ada)
                    setTimeout(() => {
                        checkAndLoadKomponen();
                    }, 500);
                }
            } else if (currentScanTarget === 'nama-compound') {
                const input = document.getElementById('input-nama-compound');
                if (input) {
                    input.value = decodedText;
                    input.dispatchEvent(new Event('input'));
                    showScanSuccess('nama-compound');
                    // Tampilkan dropdown Berat Act setelah Nama Compound diisi
                    setTimeout(() => {
                        checkAndLoadBeratAct();
                    }, 500);
                }
            } else if (currentScanTarget === 'berat-act') {
                const select = document.getElementById('select-berat-act');
                if (select) {
                    // Cari option yang sesuai dengan decodedText
                    const options = Array.from(select.options);
                    const matchingOption = options.find(opt => opt.value === decodedText || opt.textContent.includes(decodedText));
                    if (matchingOption) {
                        select.value = matchingOption.value;
                        select.dispatchEvent(new Event('change'));
                        showScanSuccess('berat-act');
                    } else {
                        // Jika tidak ditemukan, tambahkan sebagai option baru atau alert
                        alert('Berat Act tidak ditemukan: ' + decodedText);
                    }
                }
            } else if (currentScanTarget === 'urutan') {
                const input = document.getElementById('input-urutan');
                if (input) {
                    input.value = decodedText;
                    input.dispatchEvent(new Event('input'));
                    showScanSuccess('urutan');
                }
            }
        }
        
        function stopScanner() {
            // Stop Quagga2 scanner
            if (quaggaInitialized && typeof Quagga !== 'undefined') {
                try {
                    Quagga.stop();
                    Quagga.offDetected();
                    quaggaInitialized = false;
                    console.log('✅ Quagga2 scanner stopped');
                } catch (err) {
                    console.error('Error stopping Quagga2 scanner:', err);
                    quaggaInitialized = false;
                }
            }
            
            // Stop html5-qrcode scanner
            if (html5QrCode && typeof Html5Qrcode !== 'undefined') {
                try {
                html5QrCode.stop().then(() => {
                    html5QrCode.clear();
                    html5QrCode = null;
                        console.log('✅ html5-qrcode scanner stopped');
                    }).catch(err => {
                        console.error('Error stopping html5-qrcode scanner:', err);
                    html5QrCode = null;
                });
                } catch (err) {
                    console.error('Error stopping html5-qrcode scanner:', err);
                    html5QrCode = null;
                }
            }
            
            // Clear overlay
            const overlay = document.getElementById('scanner-overlay');
            if (overlay) {
                overlay.innerHTML = '';
            }
        }
        
        function showScanSuccess(target) {
            let inputId;
            if (target === 'part-number') {
                inputId = 'input-part-number';
            } else if (target === 'lot-number') {
                inputId = 'input-lot-number';
            } else if (target === 'nama-compound') {
                inputId = 'input-nama-compound';
            } else if (target === 'berat-act') {
                inputId = 'select-berat-act';
            } else if (target === 'urutan') {
                inputId = 'input-urutan';
            } else {
                return;
            }
            
            const input = document.getElementById(inputId);
            if (input) {
                // Add success class temporarily
                input.classList.add('border-success');
                setTimeout(() => {
                    input.classList.remove('border-success');
                }, 2000);
            }
        }
        
