        window.updateSinceLastChange = function(initialTimeSeconds, isRunning = false) {
            const sinceLastStatusEl = document.getElementById('since-last-status');
            if (!sinceLastStatusEl) return;
            
            // 1. STOP ALL EXISTING TIMERS FIRST
            window.stopAllTimers();
            
            // 2. Validate Seconds
            const validSeconds = (initialTimeSeconds !== null && initialTimeSeconds !== undefined && initialTimeSeconds >= 0) 
                ? Number(initialTimeSeconds)
                : 0;
            
            // 3. Calculate Base Time (Server Time Adjustment)
            const nowAdjusted = typeof window.getAdjustedServerTime === 'function' 
                ? window.getAdjustedServerTime() 
                : new Date();
                
            // 4. Set Global Timestamps
            if (isRunning) {
                // RUNNING Logic
                // Prioritize existing UTC start time if set from backend logic
                if (!window.runningStartTimeUtc) {
                    window.runningStartTimeUtc = new Date(nowAdjusted.getTime() - (validSeconds * 1000));
                }
                // Sync lastChangeTimestamp for consistency
                window.lastChangeTimestamp = window.runningStartTimeUtc;
                
                // Update UI Immediately
                if (typeof window.updateRunningDisplay === 'function') {
                    window.updateRunningDisplay();
                }
                
                // Start Running Interval
                window.runningTimerInterval = setInterval(() => {
                    if (typeof window.updateRunningDisplay === 'function') {
                        window.updateRunningDisplay();
                    }
                }, 1000);
                
                console.log('✅ RUNNING Timer started. Base:', window.runningStartTimeUtc.toISOString());
            } else {
                // STOPPED/REST/DOWN Logic
                window.runningStartTimeUtc = null; // Clear running time
                window.lastChangeTimestamp = new Date(nowAdjusted.getTime() - (validSeconds * 1000));
                
                // Update UI Immediately
                updateTimerDisplay();
                
                // Start Static Timer Interval
                window.sinceLastChangeInterval = setInterval(() => {
                    updateTimerDisplay();
                }, 1000);
                
                console.log('✅ STATUS Timer started. Base:', window.lastChangeTimestamp.toISOString());
            }
        };
        
