                }
                
                // 2. Update Since Last Status (durasi sejak status terakhir)
                // Gunakan updateRunningDisplay jika ada runningStartTimeUtc (lebih akurat)
                if (typeof updateRunningDisplay === 'function' && typeof runningStartTimeUtc !== 'undefined' && runningStartTimeUtc) {
                    updateRunningDisplay();
                } else if (typeof updateTimerDisplay === 'function') {
                    // Fallback ke updateTimerDisplay jika tidak ada runningStartTimeUtc
                    updateTimerDisplay();
                }
                
                // 3. Update Durasi Produksi (jika sedang berjalan)
                // Durasi produksi sudah punya interval sendiri, tapi kita pastikan tetap update
                if (typeof updateDurasiProduksiDisplay === 'function' && typeof durasiProduksiStartTime !== 'undefined' && durasiProduksiStartTime && typeof isDurasiAuto !== 'undefined' && isDurasiAuto) {
                    // Hitung durasi dari timestamp untuk akurasi
                    const now = new Date();
                    if (durasiProduksiStartTime) {
                        const elapsed = Math.floor((now - durasiProduksiStartTime) / 1000);
                        if (typeof durasiProduksiSeconds !== 'undefined') {
                            durasiProduksiSeconds = elapsed;
                        }
                        updateDurasiProduksiDisplay();
                    }
                }
            } catch (error) {
                console.error('❌ Error in ensureAllDurationsUpdate:', error);
            }
        }

