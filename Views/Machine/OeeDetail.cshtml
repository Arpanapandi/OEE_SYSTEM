    <script>
        // ========== GLOBAL NOTIFICATION HELPERS (SAFE BLOCK) ==========
        // Defined in a separate script tag to ensure availability even if main script fails
        (function() {
            // ✅ RESTORED: Toast Notification System for premium UI
            window.showToast = function(message, type = 'info') {
                let container = document.getElementById('toast-container');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'toast-container';
                    document.body.appendChild(container);
                }

                container.className = 'toast-container position-fixed top-0 start-50 translate-middle-x p-3';
                container.style.zIndex = '11000';
                container.style.marginTop = '20px';

                const id = 'toast-' + Date.now();
                const bgClass = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 
                               type === 'warning' ? 'bg-warning' : 'bg-primary';
                const icon = type === 'success' ? 'fa-check' : type === 'error' ? 'fa-circle-exclamation' : 
                            type === 'warning' ? 'fa-triangle-exclamation' : 'fa-info-circle';
                
                const html = `
                    <div id="${id}" class="toast align-items-center text-white ${bgClass} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fa-solid ${icon} me-2"></i>${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                `;
                
                container.insertAdjacentHTML('beforeend', html);
                
                const toastEl = document.getElementById(id);
                if (typeof bootstrap !== 'undefined' && bootstrap.Toast) {
                    const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
                    toast.show();
                    toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
                } else {
                    // Fallback if bootstrap is not available
                    toastEl.style.display = 'block';
                    toastEl.style.opacity = '1';
                    setTimeout(() => { toastEl.remove(); }, 3000);
                }
            };

            window.showSuccessNotification = function(message) {
                if (typeof showToast === 'function') {
                    showToast(message, 'success');
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Berhasil',
                        text: message,
                        timer: 2000,
                        showConfirmButton: false,
                        background: '#1e1e1e',
                        color: '#fff'
                    });
                } else {
                    alert('✅ ' + message);
                }
            };

            window.showErrorNotification = function(message) {
                if (typeof showToast === 'function') {
                    showToast(message, 'error');
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Gagal',
                        text: message,
                        background: '#1e1e1e',
                        color: '#fff'
                    });
                } else {
                    alert('❌ Error: ' + message);
                }
            };

            window.showWarningNotification = function(message) {
                if (typeof showToast === 'function') {
                    showToast(message, 'warning');
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Peringatan',
                        text: message,
                        background: '#1e1e1e',
                        color: '#fff'
                    });
                } else {
                    alert('⚠️ Peringatan: ' + message);
                }
            };
            
            // Hoist as var to window scope
            var showSuccessNotification = window.showSuccessNotification;
            var showErrorNotification = window.showErrorNotification;
            var showWarningNotification = window.showWarningNotification;
        })();
    </script>

    <script>
        // ========== MAIN SCRIPT START ==========
        
        // ========== PRODUCTION DATA VARIABLES ==========
        let durasiProduksiSeconds = 0;

        // ========== SERVER TIME SYNCHRONIZATION ==========
        // Hitung offset antara jam server (dari Razor) dan jam client saat page load
        // Gunakan ISO string standard untuk menghindari parsing error di JS
        const serverTimeInitial = new Date('@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")'); 
        const clientTimeInitial = new Date();
        const serverTimeOffset = serverTimeInitial - clientTimeInitial;

        console.log('🕒 Server Time Initial:', serverTimeInitial.toLocaleString());
        console.log('💻 Client Time Initial:', clientTimeInitial.toLocaleString());
        console.log('⏱️ Time Offset (ms):', serverTimeOffset);

        // Fungsi global untuk mendapatkan waktu server yang disesuaikan
        window.getAdjustedServerTime = function() {
            return new Date(Date.now() + serverTimeOffset);
        };
        
        let durasiProduksiStartTime = null;
        let durasiProduksiInterval = null;
        
        // ========== HELPER FUNCTION: Validate Group Injection ==========
        function validateGroupInjection() {
            const injectionVal = document.querySelector('input[name="injection"]:checked')?.value;
            if (!injectionVal) {
                showWarningNotification('Harap pilih Group Injection (Merah/Biru) terlebih dahulu');
                return false;
            }
            return true;
        }
        
        // ========== HELPER FUNCTION: Stop Durasi Produksi ==========
        function stopDurasiProduksi() {
            if (durasiProduksiInterval) {
                clearInterval(durasiProduksiInterval);
                durasiProduksiInterval = null;
            }
            console.log('⏹️ Durasi produksi stopped');
        }
        
        // ========== HELPER FUNCTION: Update Production Data with Qty ==========
        function updateProductionDataWithQty(goodQty, rejectQty, duration) {
            try {
                // Store production data in localStorage or update UI
                const productionData = {
                    goodQty: goodQty || 0,
                    rejectQty: rejectQty || 0,
                    duration: duration || 0,
                    timestamp: new Date().toISOString()
                };
                
                localStorage.setItem('lastProductionData', JSON.stringify(productionData));
                console.log('✅ Production data updated:', productionData);
            } catch (error) {
                console.error('❌ Error updating production data:', error);
            }
        }
        
