        function setupBeratActButtons() {
            const inputBeratAct = document.getElementById('input-berat-act');
            const btnIncrement = document.getElementById('btn-increment-berat-act');
            const btnDecrement = document.getElementById('btn-decrement-berat-act');
            const beratActError = document.getElementById('berat-act-error');
            const beratActSuccess = document.getElementById('berat-act-success');
            
            if (!inputBeratAct || !btnIncrement || !btnDecrement) {
                // Retry jika elemen belum tersedia (form mungkin muncul secara dinamis)
                return;
            }
            
            // Format input ke 2 angka di belakang koma saat blur
            if (inputBeratAct) {
                inputBeratAct.addEventListener('blur', function() {
                    const value = parseFloat(this.value);
                    if (!isNaN(value) && value >= 0) {
                        this.value = value.toFixed(2);
                    } else if (this.value !== '') {
                        this.value = '';
                    }
                    checkAllInputsComplete();
                });
                
                inputBeratAct.addEventListener('input', function() {
                    // Validasi real-time
                    const value = parseFloat(this.value);
                    if (this.value !== '' && (isNaN(value) || value < 0)) {
                        if (beratActError) {
                            beratActError.textContent = 'Berat Act harus berupa angka positif';
                            beratActError.style.display = 'block';
                        }
                        if (beratActSuccess) beratActSuccess.style.display = 'none';
                    } else {
                        if (beratActError) beratActError.style.display = 'none';
                        if (beratActSuccess && this.value !== '') {
                            // Format display dengan koma
                            const displayValue = isNaN(value) ? this.value : value.toFixed(2).replace('.', ',');
                            beratActSuccess.textContent = 'Berat Act: ' + displayValue + ' kg';
                            beratActSuccess.style.display = 'block';
                        }
                    }
                    checkAllInputsComplete();
                });
            }
            
            // Tombol Increment (Plus) - menggunakan event delegation
            if (btnIncrement && inputBeratAct) {
                // Hapus event listener lama jika ada
                btnIncrement.replaceWith(btnIncrement.cloneNode(true));
                const newBtnIncrement = document.getElementById('btn-increment-berat-act');
                
                newBtnIncrement.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    console.log('🔼 Plus button clicked');
                    const currentValue = parseFloat(inputBeratAct.value) || 0;
                    const newValue = currentValue + 0.01;
                    inputBeratAct.value = newValue.toFixed(2);
                    inputBeratAct.dispatchEvent(new Event('input', { bubbles: true }));
                    inputBeratAct.dispatchEvent(new Event('change', { bubbles: true }));
                    if (typeof checkAllInputsComplete === 'function') {
                        checkAllInputsComplete();
                    }
                    console.log('✅ Value updated to:', newValue.toFixed(2));
                    return false;
                });
                
                // Fallback: juga attach via onclick
                newBtnIncrement.onclick = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const currentValue = parseFloat(inputBeratAct.value) || 0;
                    const newValue = currentValue + 0.01;
                    inputBeratAct.value = newValue.toFixed(2);
                    inputBeratAct.dispatchEvent(new Event('input', { bubbles: true }));
                    if (typeof checkAllInputsComplete === 'function') {
                        checkAllInputsComplete();
                    }
                    return false;
                };
                
                console.log('✅ Plus button initialized');
            } else {
                console.warn('⚠️ btn-increment-berat-act or input-berat-act not found');
            }
            
            // Tombol Decrement (Minus) - menggunakan event delegation
            if (btnDecrement && inputBeratAct) {
                // Hapus event listener lama jika ada
                btnDecrement.replaceWith(btnDecrement.cloneNode(true));
                const newBtnDecrement = document.getElementById('btn-decrement-berat-act');
                
                newBtnDecrement.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
