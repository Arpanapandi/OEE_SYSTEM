    <script>
        // ========== REAL-TIME TIME METRICS UPDATE ==========
        const machineId = '@Model.MachineId';
        let timeMetricsInterval = null;
        let realTimeCounter = 0; // Counter yang bertambah setiap detik
        let basePlannedSeconds = @Model.PlannedProductionTime.TotalSeconds;
        let baseOperatingSeconds = @Model.OperatingTime.TotalSeconds;
        let baseDowntimeSeconds = @Model.DowntimeTotal.TotalSeconds;
        let baseRestBreakSeconds = 0; // ✅ PERBAIKAN: Base Rest Break time dari backend
        let baseNoLoadingSeconds = 0; // ✅ PERBAIKAN: Base No Loading time dari backend
        const shiftMetaEl = document.getElementById('shift-meta');
        const shiftDate = shiftMetaEl?.dataset.shiftDate || '';
        const shiftCode = shiftMetaEl?.dataset.shiftCode || '';
        const shiftId = shiftMetaEl?.dataset.shiftId || '';
        let lastShiftKey = shiftMetaEl?.dataset.shiftKey || '';

        // Format seconds to HH:mm:ss
        function formatTime(seconds) {
            // Handle NaN, undefined, or invalid values
            if (isNaN(seconds) || seconds === null || seconds === undefined) {
                return "00:00:00";
            }
            
            // Ensure seconds is a valid number
            seconds = Math.max(0, Math.floor(Number(seconds)));
            
            const hours = Math.floor(seconds / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            const secs = seconds % 60;
            
            return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        // Start real-time counter
        function startTimeCounter() {
            // Clear existing interval
            if (timeMetricsInterval) {
                clearInterval(timeMetricsInterval);
                timeMetricsInterval = null;
            }

            // Update every second - PASTIKAN selalu dipanggil
            timeMetricsInterval = setInterval(() => {
                try {
                    realTimeCounter++; // Increment counter setiap detik
                    updateTimeDisplay(); // Update display setiap detik
                } catch (error) {
                    console.error('❌ Error in real-time counter:', error);
                }
            }, 1000);
            
            console.log('✅ Real-time counter started - akan update setiap detik');
            console.log('⏱️ Interval ID:', timeMetricsInterval);
            
            // Verify interval is running
            setTimeout(() => {
                if (timeMetricsInterval) {
                    console.log('✅ Real-time counter verified - running correctly');
                } else {
                    console.error('❌ Real-time counter failed to start!');
                }
            }, 2000);
        }

        // Store active job/downtime info - Initialize dari server-side data
        let hasActiveJob = @(Model.ActiveJob != null ? "true" : "false");
        @{
            var hasActiveDowntimeValue = Model.RecentDowntimes != null && Model.RecentDowntimes.Any(d => !d.EndTime.HasValue);
        }
        let hasActiveDowntime = @(hasActiveDowntimeValue ? "true" : "false");
        let isNoLoading = false; // Track status NoLoading - tidak masuk ke Operating Time atau Downtime
        let hasActiveRestBreak = false; // ✅ PERBAIKAN: Track status Rest Break aktif
        let previousHasActiveJob = hasActiveJob;
        let previousHasActiveDowntime = hasActiveDowntime;

        // ========== DANDORI DURATION ==========
        // Variabel untuk Dandori duration (DEFINISIKAN SEBELUM HANDLER)
        let baseDandoriSeconds = @(Model.ActiveJob?.DandoriDurationSeconds ?? 0);
        let dandoriStartTime = @(Model.ActiveJob?.DandoriStartTime != null ? $"new Date('{Model.ActiveJob.DandoriStartTime.Value:O}')" : "null");
        let dandoriEndTime = @(Model.ActiveJob?.DandoriEndTime != null ? $"new Date('{Model.ActiveJob.DandoriEndTime.Value:O}')" : "null");
        let dandoriInterval = null;
        let dandoriConnection = null;
        const currentMachineId = @Model.MachineId;
        
        // ✅ PERBAIKAN: Initialize SignalR untuk Dandori timer real-time
        function initializeDandoriSignalR() {
            if (typeof signalR === 'undefined') {
                console.warn('⚠️ SignalR library not loaded, using JavaScript interval fallback');
                startDandoriTimer();
                return;
            }

            // Jika sudah ada connection, jangan buat baru
            if (dandoriConnection && dandoriConnection.state !== signalR.HubConnectionState.Disconnected) {
                console.log('ℹ️ Dandori SignalR connection already exists, state:', dandoriConnection.state);
                return;
            }

            console.log('🚀 Initializing SignalR connection for Dandori timer...');
            
            dandoriConnection = new signalR.HubConnectionBuilder()
                .withUrl("/oeeHub")
                .withAutomaticReconnect({
                    nextRetryDelayInMilliseconds: retryContext => {
                        if (retryContext.elapsedMilliseconds < 2000) return 0;
                        if (retryContext.elapsedMilliseconds < 5000) return 2000;
                        if (retryContext.elapsedMilliseconds < 10000) return 5000;
                        return 10000;
                    }
                })
                .build();

            // Listen untuk update Dandori duration dari server
            dandoriConnection.on("DandoriDurationUpdated", function (machineId, durationSeconds) {
                // Convert machineId to string for comparison (MachineId is string type)
                const machineIdStr = String(machineId);
                const currentMachineIdStr = String(currentMachineId);
                
                if (machineIdStr === currentMachineIdStr) {
                    const dandoriEl = document.getElementById('dandori-duration');
                    if (dandoriEl) {
                        dandoriEl.textContent = formatTime(durationSeconds);
                        // Update base untuk fallback
                        baseDandoriSeconds = durationSeconds;
                        
                        // Update color jika sedang running
                        if (dandoriStartTime && !dandoriEndTime) {
                            dandoriEl.className = 'fs-4 fw-bold text-success';
                        }
                        
                        console.log('📡 SignalR Dandori update received:', durationSeconds, 'seconds');
                    }
                }
            });

            dandoriConnection.start()
                .then(() => {
                    console.log('✅ Dandori SignalR connected, connection ID:', dandoriConnection.connectionId);
                    // Join machine group untuk receive updates (parse to int for SignalR)
                    const machineIdInt = parseInt(currentMachineId) || 0;
                    if (machineIdInt > 0) {
                        dandoriConnection.invoke("JoinMachineGroup", machineIdInt)
                            .then(() => {
                                console.log('✅ Joined machine group:', machineIdInt);
                                // Start timer setelah join group
                                startDandoriTimer();
                            })
                            .catch(err => {
                                console.error('❌ Error joining machine group:', err);
                                // Start timer anyway
                                startDandoriTimer();
                            });
                    } else {
                        console.warn('⚠️ Invalid machineId, starting fallback timer');
                        startDandoriTimer();
                    }
                })
                .catch(err => {
                    console.error('❌ Dandori SignalR connection error:', err);
                    // Fallback ke JavaScript interval
                    startDandoriTimer();
                });
        }

        // Fungsi Update Dandori Duration Display (fallback dengan JavaScript interval)
        function updateDandoriDuration() {
            const dandoriEl = document.getElementById('dandori-duration');
            if (!dandoriEl) {
                console.warn('⚠️ Dandori duration element not found');
                return;
            }
            
            let currentDandoriSeconds = baseDandoriSeconds || 0;
            
            // Jika dandori sedang berjalan (ada start time tapi belum ada end time)
            if (dandoriStartTime && !dandoriEndTime) {
                const now = new Date();
                const startTime = dandoriStartTime instanceof Date ? dandoriStartTime : new Date(dandoriStartTime);
                
                if (!isNaN(startTime.getTime())) {
                    const elapsedSeconds = Math.floor((now.getTime() - startTime.getTime()) / 1000);
                    currentDandoriSeconds = (baseDandoriSeconds || 0) + elapsedSeconds;
                } else {
                    console.warn('⚠️ Invalid DandoriStartTime:', dandoriStartTime);
                }
            }
            
            // Update display
            dandoriEl.textContent = formatTime(currentDandoriSeconds);
        }
        
        // Start Dandori timer interval (fallback jika SignalR tidak tersedia)
        function startDandoriTimer() {
            // Clear existing interval
            if (dandoriInterval) {
                clearInterval(dandoriInterval);
                dandoriInterval = null;
            }
            
            // Check if Dandori is running
            const isRunning = dandoriStartTime && !dandoriEndTime;
            
            console.log('🔧 startDandoriTimer called:', {
                isRunning: isRunning,
                dandoriStartTime: dandoriStartTime,
                dandoriEndTime: dandoriEndTime,
                baseDandoriSeconds: baseDandoriSeconds,
                signalRConnected: dandoriConnection && dandoriConnection.state === signalR.HubConnectionState.Connected
            });
            
            if (isRunning) {
                // Update immediately
                updateDandoriDuration();
                
                // Start interval untuk update setiap detik (fallback jika SignalR tidak update)
                // SignalR akan update via listener, tapi interval ini sebagai backup
                dandoriInterval = setInterval(() => {
                    updateDandoriDuration();
                }, 1000);
                
                console.log('✅ Dandori timer started - updating every second, interval ID:', dandoriInterval);
                console.log('📡 Waiting for SignalR updates from server...');
            } else {
                // Jika sudah selesai atau belum mulai, update sekali saja
                updateDandoriDuration();
                console.log('ℹ️ Dandori timer not running, updated once');
            }
        }
        
        // ✅ AJAX Handler untuk Start/Stop Dandori (tanpa refresh)
        document.addEventListener('DOMContentLoaded', function() {
            const btnDandori = document.getElementById('btn-dandori-action');
            if (!btnDandori) return;
            
            btnDandori.addEventListener('click', async function() {
                const action = this.getAttribute('data-action');
                const machineId = '@Model.MachineId';
                const originalText = this.innerHTML;
                
                // Disable button dan show loading
                this.disabled = true;
                this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Processing...';
                
                try {
                    // Simpan scroll position
                    const scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
                    
                    // Get anti-forgery token
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    
                    const formData = new FormData();
                    formData.append('machineId', machineId);
                    if (token) {
                        formData.append('__RequestVerificationToken', token);
                    }
                    
                    const url = action === 'start' 
                        ? '/Operator/StartDandori' 
                        : '/Operator/StopDandori';
                    
                    const response = await fetch(url, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': token || ''
                        }
                    });
                    
                    if (response.ok) {
                        // Update UI langsung tanpa refresh
                        if (action === 'start') {
                            // Update variables untuk timer - PASTIKAN INI DILAKUKAN SEBELUM startDandoriTimer()
                            const now = new Date();
                            dandoriStartTime = now;
                            dandoriEndTime = null;
                            baseDandoriSeconds = 0;
                            
                            console.log('🔄 Dandori variables updated:', {
                                dandoriStartTime: dandoriStartTime,
                                dandoriEndTime: dandoriEndTime,
                                baseDandoriSeconds: baseDandoriSeconds
                            });
                            
                            // Update button
                            this.setAttribute('data-action', 'stop');
                            this.className = 'btn btn-danger w-100';
                            this.innerHTML = '<i class="fa-solid fa-stop me-2"></i>STOP DANDORI';
                            
                            // Update duration display color
                            const dandoriEl = document.getElementById('dandori-duration');
                            if (dandoriEl) {
                                dandoriEl.className = 'fs-4 fw-bold text-success';
                                dandoriEl.textContent = '00:00:00';
                            }
                            
                            // ✅ PASTIKAN SIGNALR CONNECTED DAN JOIN GROUP
                            const ensureSignalRConnected = () => {
                                if (!dandoriConnection || dandoriConnection.state !== signalR.HubConnectionState.Connected) {
                                    console.log('🔄 SignalR not connected, initializing...');
                                    initializeDandoriSignalR();
                                    // Wait for connection
                                    setTimeout(() => {
                                        if (dandoriConnection && dandoriConnection.state === signalR.HubConnectionState.Connected) {
                                            joinMachineGroup();
                                        } else {
                                            console.warn('⚠️ SignalR connection failed, using fallback timer');
                                            startDandoriTimer();
                                        }
                                    }, 1000);
                                } else {
                                    joinMachineGroup();
                                }
                            };
                            
                            const joinMachineGroup = () => {
                                const machineIdInt = parseInt(currentMachineId) || 0;
                                if (machineIdInt > 0) {
                                    dandoriConnection.invoke("JoinMachineGroup", machineIdInt)
                                        .then(() => {
                                            console.log('✅ Joined machine group for Dandori updates:', machineIdInt);
                                            // Start timer setelah join group
                                            startDandoriTimer();
                                        })
                                        .catch(err => {
                                            console.error('❌ Error joining machine group:', err);
                                            // Start timer anyway
                                            startDandoriTimer();
                                        });
                                } else {
                                    console.warn('⚠️ Invalid machineId, starting fallback timer');
                                    startDandoriTimer();
                                }
                            };
                            
                            // Initialize SignalR jika belum ada atau tidak connected
                            if (typeof signalR === 'undefined') {
                                console.warn('⚠️ SignalR not available, using fallback timer');
                                startDandoriTimer();
                            } else {
                                ensureSignalRConnected();
                            }
                            
                            console.log('✅ Dandori started - timer should be running real-time');
                        } else {
                            // Stop Dandori
                            dandoriEndTime = new Date();
                            
                            // Update button
                            this.setAttribute('data-action', 'start');
                            this.className = 'btn btn-success w-100';
                            this.innerHTML = '<i class="fa-solid fa-play me-2"></i>START DANDORI';
                            
                            // Update duration display color
                            const dandoriEl = document.getElementById('dandori-duration');
                            if (dandoriEl) {
                                dandoriEl.className = 'fs-4 fw-bold text-dark';
                            }
                            
                            // Stop timer
                            if (dandoriInterval) {
                                clearInterval(dandoriInterval);
                                dandoriInterval = null;
                            }
                            
                            console.log('✅ Dandori stopped');
                        }
                        
                        // Restore scroll position
                        window.scrollTo(0, scrollPosition);
                    } else {
                        const errorText = await response.text();
                        alert('❌ Error: ' + (errorText || 'Gagal ' + action + ' Dandori'));
                        this.innerHTML = originalText;
                    }
                } catch (error) {
                    console.error('❌ Error:', error);
                    alert('❌ Terjadi error saat ' + action + ' Dandori. Silakan coba lagi.');
                    this.innerHTML = originalText;
                } finally {
                    this.disabled = false;
                }
            });
        });
        
        // ✅ Initialize SignalR saat page load (PASTIKAN INI DIPANGGIL)
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize SignalR connection untuk Dandori
            if (typeof signalR !== 'undefined') {
                initializeDandoriSignalR();
            } else {
                // Load SignalR script jika belum ada
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js';
                script.onload = () => {
                    console.log('✅ SignalR library loaded');
                    initializeDandoriSignalR();
                };
                script.onerror = () => {
                    console.warn('⚠️ Failed to load SignalR, using fallback');
                    startDandoriTimer();
                };
                document.head.appendChild(script);
            }
        });
        
        // ✅ TAMBAHKAN: Update button status Dandori
        function updateDandoriButton() {
            const btnDandori = document.getElementById('btn-dandori-action');
            const dandoriDurationEl = document.getElementById('dandori-duration');
            const isRunning = dandoriStartTime && !dandoriEndTime;
            
            if (btnDandori) {
                // ✅ PERBAIKAN: Pastikan button tidak disabled (kecuali sedang processing)
                // Jangan disable button saat update status, hanya disable saat processing
                if (!btnDandori.innerHTML.includes('Processing...')) {
                    btnDandori.disabled = false;
                    btnDandori.style.pointerEvents = 'auto';
                    btnDandori.style.cursor = 'pointer';
                }
                
                if (isRunning) {
                    btnDandori.className = 'btn btn-danger btn-lg w-100';
                    btnDandori.innerHTML = '<i class="fa-solid fa-stop me-2"></i>STOP DANDORI';
                    btnDandori.setAttribute('data-is-running', 'true');
                } else {
                    btnDandori.className = 'btn btn-success btn-lg w-100';
                    btnDandori.innerHTML = '<i class="fa-solid fa-play me-2"></i>START DANDORI';
                    btnDandori.setAttribute('data-is-running', 'false');
                }
            }
            
            if (dandoriDurationEl) {
                if (isRunning) {
                    dandoriDurationEl.className = 'fs-3 fw-bold text-success';
                } else {
                    dandoriDurationEl.className = 'fs-3 fw-bold text-dark';
                }
            }
        }
        
        // ✅ PERBAIKAN FINAL: Handle Start/Stop Dandori dengan AJAX (tanpa reload page)
        function setupDandoriButton() {
            const btnDandori = document.getElementById('btn-dandori-action');
            if (!btnDandori) {
                console.warn('⚠️ Button Dandori not found, will retry...');
                setTimeout(setupDandoriButton, 100);
                return;
            }
            
            // ✅ PERBAIKAN: Pastikan button tidak disabled dan bisa diklik
            btnDandori.disabled = false;
            btnDandori.style.pointerEvents = 'auto';
            btnDandori.style.cursor = 'pointer';
            btnDandori.style.zIndex = '10';
            btnDandori.style.position = 'relative';
            
            // Force remove any overlay atau blocking element
            const parent = btnDandori.parentElement;
            if (parent) {
                parent.style.pointerEvents = 'auto';
                parent.style.zIndex = '10';
            }
            
            // ✅ PERBAIKAN: Juga attach event listener sebagai backup (selain onclick di HTML)
            btnDandori.addEventListener('click', handleDandoriButtonClick);
            
            console.log('✅ Dandori button setup completed');
            console.log('🔍 Button state:', {
                disabled: btnDandori.disabled,
                pointerEvents: btnDandori.style.pointerEvents,
                cursor: btnDandori.style.cursor,
                zIndex: btnDandori.style.zIndex,
                id: btnDandori.id,
