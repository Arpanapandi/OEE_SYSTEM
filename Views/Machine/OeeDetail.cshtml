                selectBeratAct.innerHTML = '<option value="">-- Pilih Berat Act --</option>';
                beratActError.textContent = 'Error loading Berat Act: ' + err.message;
                beratActError.style.display = 'block';
                beratActSuccess.style.display = 'none';
                beratActData = [];
            }
        }
        
        // Event listener untuk Nama Compound input
        document.addEventListener('DOMContentLoaded', function() {
            const inputNamaCompound = document.getElementById('input-nama-compound');
            if (inputNamaCompound) {
                let namaCompoundTimeout;
                
                inputNamaCompound.addEventListener('input', function() {
                    clearTimeout(namaCompoundTimeout);
                    namaCompoundTimeout = setTimeout(() => {
                        checkAndLoadBeratAct();
                        checkAllInputsComplete();
                    }, 500);
                });
                
                inputNamaCompound.addEventListener('change', function() {
                    checkAllInputsComplete();
                });
            }
            
            // Event listener untuk select Berat Act
            const selectBeratAct = document.getElementById('select-berat-act');
            if (selectBeratAct) {
                selectBeratAct.addEventListener('change', function() {
                    selectedBeratAct = this.value;
                    const beratActError = document.getElementById('berat-act-error');
                    const beratActSuccess = document.getElementById('berat-act-success');
                    
                    if (this.value) {
                        if (beratActError) beratActError.style.display = 'none';
                        if (beratActSuccess) {
                            beratActSuccess.textContent = 'Berat Act dipilih: ' + this.options[this.selectedIndex].text;
                            beratActSuccess.style.display = 'block';
                        }
                    } else {
                        if (beratActError) beratActError.style.display = 'none';
                        if (beratActSuccess) beratActSuccess.style.display = 'none';
                    }
                    
                    checkAllInputsComplete();
                });
            }
        });
        // ========== END BERAT ACT LOADING ==========
        
        // ========== END SCANNER FUNCTIONALITY ==========
        
        // ========== KOMPONEN LOADING DARI db_HOSS ==========
        let komponenData = [];
        let selectedPartNumber = '';
        let selectedKomponenId = null;

        // Function untuk load komponen berdasarkan part number dari db_HOSS
        async function loadKomponenFromHoss(partNumber) {
            const komponenContainer = document.getElementById('komponen-container');
            const selectKomponen = document.getElementById('select-komponen');
            const komponenError = document.getElementById('komponen-error');
            const komponenSuccess = document.getElementById('komponen-success');
            
            if (!komponenContainer || !selectKomponen || !komponenError || !komponenSuccess) {
                console.error('Komponen container elements not found');
                return;
            }
            
            if (!partNumber || partNumber.trim() === '') {
                komponenContainer.style.display = 'none';
                selectKomponen.innerHTML = '<option value="">-- Pilih Komponen --</option>';
                komponenData = [];
                selectedPartNumber = '';
                return;
            }
            
            // ✅ DUMMY MODE: Bypass API untuk testing
            const USE_DUMMY_DATA = true; // Set ke false untuk menggunakan API real
            
            try {
                if (USE_DUMMY_DATA) {
                    // Simulasi delay
                    await new Promise(resolve => setTimeout(resolve, 500));
                    
                    // ✅ DUMMY DATA: Komponen berdasarkan Part Number
                    const partNumberUpper = partNumber.toUpperCase();
                    
                    // Dummy komponen data
                    let dummyKomponen = [];
                    
                    if (partNumberUpper.includes('BRG') || partNumberUpper.includes('BEARING')) {
                        dummyKomponen = [
                            { Id: 1, PartNumber: 'BRG-001', JmlKomponen: 10 },
                            { Id: 2, PartNumber: 'BRG-002', JmlKomponen: 15 },
                            { Id: 3, PartNumber: 'BRG-003', JmlKomponen: 20 }
                        ];
                    } else if (partNumberUpper.includes('VLV') || partNumberUpper.includes('VALVE')) {
                        dummyKomponen = [
                            { Id: 4, PartNumber: 'VLV-001', JmlKomponen: 5 },
                            { Id: 5, PartNumber: 'VLV-002', JmlKomponen: 8 },
                            { Id: 6, PartNumber: 'VLV-003', JmlKomponen: 12 }
                        ];
                    } else if (partNumberUpper.includes('GRS') || partNumberUpper.includes('GEAR')) {
                        dummyKomponen = [
                            { Id: 7, PartNumber: 'GRS-001', JmlKomponen: 3 },
                            { Id: 8, PartNumber: 'GRS-002', JmlKomponen: 5 }
                        ];
                    } else {
                        // Default komponen untuk part number lainnya
                        dummyKomponen = [
                            { Id: 9, PartNumber: 'COMP-001', JmlKomponen: 1 },
                            { Id: 10, PartNumber: 'COMP-002', JmlKomponen: 2 },
                            { Id: 11, PartNumber: 'COMP-003', JmlKomponen: 3 },
                            { Id: 12, PartNumber: 'COMP-004', JmlKomponen: 4 }
                        ];
                    }
                    
                    komponenData = dummyKomponen;
                    selectedPartNumber = partNumber.trim();
                    
                    // Populate dropdown
                    selectKomponen.innerHTML = '<option value="">-- Pilih Komponen --</option>';
                    dummyKomponen.forEach(komponen => {
                        const option = document.createElement('option');
                        option.value = komponen.Id;
                        const jmlText = komponen.JmlKomponen ? ` (Qty: ${komponen.JmlKomponen})` : '';
                        option.textContent = `${komponen.PartNumber}${jmlText}`;
                        option.setAttribute('data-part-number', komponen.PartNumber);
                        option.setAttribute('data-jml-komponen', komponen.JmlKomponen || 0);
                        selectKomponen.appendChild(option);
                    });
                    
                    // Tampilkan dropdown
                    komponenContainer.style.display = 'block';
                    komponenError.style.display = 'none';
                    komponenSuccess.textContent = `${dummyKomponen.length} komponen ditemukan untuk Part Number "${partNumber}" (DUMMY DATA)`;
                    komponenSuccess.style.display = 'block';
                    
                    console.log(`✅ Komponen loaded (DUMMY): ${dummyKomponen.length} options untuk "${partNumber}"`);
                    return;
                }
                
                // ✅ REAL API MODE: Uncomment untuk menggunakan API real
                // Validasi part number terlebih dahulu
                const validateResponse = await fetch(`/api/Scanner/komponen/validate/${encodeURIComponent(partNumber.trim())}`);
                const validateResult = await validateResponse.json();
                
                if (!validateResult.success) {
                    komponenContainer.style.display = 'none';
                    selectKomponen.innerHTML = '<option value="">-- Pilih Komponen --</option>';
                    komponenError.textContent = validateResult.message || 'Part Number tidak ditemukan di database';
                    komponenError.style.display = 'block';
                    komponenSuccess.style.display = 'none';
                    komponenData = [];
                    selectedPartNumber = '';
                    return;
                }
                
                // Part number valid, load komponen
                const response = await fetch(`/api/Scanner/komponen/${encodeURIComponent(partNumber.trim())}`);
                const result = await response.json();
                
                if (result.success && result.data && result.data.length > 0) {
                    komponenData = result.data;
                    selectedPartNumber = partNumber.trim();
                    
                    // Populate dropdown
                    selectKomponen.innerHTML = '<option value="">-- Pilih Komponen --</option>';
                    result.data.forEach(komponen => {
                        const option = document.createElement('option');
                        option.value = komponen.Id;
                        const jmlText = komponen.JmlKomponen ? ` (Qty: ${komponen.JmlKomponen})` : '';
                        option.textContent = `${komponen.PartNumber}${jmlText}`;
                        option.setAttribute('data-part-number', komponen.PartNumber);
                        option.setAttribute('data-jml-komponen', komponen.JmlKomponen || 0);
                        selectKomponen.appendChild(option);
                    });
                    
                    // Tampilkan dropdown
                    komponenContainer.style.display = 'block';
                    komponenError.style.display = 'none';
                    komponenSuccess.textContent = `${result.data.length} komponen ditemukan untuk Part Number ini`;
                    komponenSuccess.style.display = 'block';
                } else {
                    // Tidak ada komponen ditemukan
                    komponenContainer.style.display = 'none';
                    selectKomponen.innerHTML = '<option value="">-- Pilih Komponen --</option>';
                    komponenError.textContent = result.message || 'Komponen tidak ditemukan';
                    komponenError.style.display = 'block';
                    komponenSuccess.style.display = 'none';
                    komponenData = [];
                }
            } catch (error) {
                console.error('Error loading komponen:', error);
                komponenContainer.style.display = 'none';
                komponenError.textContent = 'Error memuat komponen. Silakan coba lagi.';
                komponenError.style.display = 'block';
                komponenSuccess.style.display = 'none';
                komponenData = [];
            }
        }

        // ✅ PERBAIKAN: Check jika Part Number dan No Lot Produksi sudah diisi, lalu load komponen dengan validasi real-time
        async function checkAndLoadKomponen() {
            const inputPartNumber = document.getElementById('input-part-number');
            const inputLotNumber = document.getElementById('input-lot-number');
            const komponenError = document.getElementById('komponen-error');
            const komponenSuccess = document.getElementById('komponen-success');
            
            if (!inputPartNumber || !inputLotNumber) return;
            
            const partNumber = inputPartNumber.value?.trim() || '';
            const lotNumber = inputLotNumber.value?.trim() || '';
            
            // ✅ DUMMY MODE: Bypass validasi untuk testing
            const USE_DUMMY_VALIDATION = true; // Set ke false untuk menggunakan API real
            
            // ✅ PERBAIKAN: Validasi Part Number ke database terlebih dahulu (real-time)
            if (partNumber && partNumber.length > 0) {
                try {
                    if (USE_DUMMY_VALIDATION) {
                        // ✅ DUMMY VALIDATION: Terima semua part number untuk testing
                        inputPartNumber.classList.remove('is-invalid');
                        inputPartNumber.classList.add('is-valid');
                        if (komponenError) komponenError.style.display = 'none';
                        console.log(`✅ Part Number validated (DUMMY): "${partNumber}"`);
                    } else {
                        // ✅ REAL API VALIDATION
                        const validateResponse = await fetch(`/api/Scanner/komponen/validate/${encodeURIComponent(partNumber)}`);
                        const validateResult = await validateResponse.json();
                        
                        // ✅ PERBAIKAN: Update UI feedback real-time
                        if (validateResult.success) {
                            inputPartNumber.classList.remove('is-invalid');
                            inputPartNumber.classList.add('is-valid');
                            if (komponenError) komponenError.style.display = 'none';
                        } else {
                            inputPartNumber.classList.remove('is-valid');
                            inputPartNumber.classList.add('is-invalid');
                            if (komponenError) {
                                komponenError.textContent = validateResult.message || 'Part Number tidak ditemukan di database';
                                komponenError.style.display = 'block';
                            }
                            
                            // Hide komponen container jika Part Number tidak valid
                            const komponenContainer = document.getElementById('komponen-container');
                            if (komponenContainer) komponenContainer.style.display = 'none';
                            return;
                        }
                    }
                } catch (err) {
                    console.error('❌ Error validating Part Number:', err);
                    inputPartNumber.classList.remove('is-valid', 'is-invalid');
                }
            } else {
                // Clear validation classes jika Part Number kosong
                inputPartNumber.classList.remove('is-valid', 'is-invalid');
            }
            
            // ✅ PERBAIKAN: Load komponen hanya jika Part Number dan Lot Number sudah terisi
            if (partNumber && lotNumber) {
                // Validasi Part Number sekali lagi sebelum load komponen
                try {
                    const validateResponse = await fetch(`/api/Scanner/komponen/validate/${encodeURIComponent(partNumber)}`);
                    const validateResult = await validateResponse.json();
                    
                    if (!validateResult.success) {
                        const komponenContainer = document.getElementById('komponen-container');
                        if (komponenContainer) komponenContainer.style.display = 'none';
                        if (komponenError) {
                            komponenError.textContent = validateResult.message || 'Part Number tidak ditemukan di database';
                            komponenError.style.display = 'block';
                        }
                        if (komponenSuccess) komponenSuccess.style.display = 'none';
                        return;
                    }
                    
                    // Part Number valid, load komponen
                    if (partNumber !== selectedPartNumber) {
                        await loadKomponenFromHoss(partNumber);
                    } else {
                        // Jika Part Number sama, pastikan komponen container visible jika ada data
                        const komponenContainer = document.getElementById('komponen-container');
                        const selectKomponen = document.getElementById('select-komponen');
                        if (komponenContainer && selectKomponen && selectKomponen.options.length > 1) {
                            komponenContainer.style.display = 'block';
                        }
                    }
                } catch (err) {
                    console.error('❌ Error validating/loading komponen:', err);
                }
            } else {
                // Hide komponen container jika salah satu belum terisi
                const komponenContainer = document.getElementById('komponen-container');
                const selectKomponen = document.getElementById('select-komponen');
                if (komponenContainer && selectKomponen) {
                    komponenContainer.style.display = 'none';
                    selectKomponen.innerHTML = '<option value="">-- Pilih Komponen --</option>';
                }
                if (komponenError) komponenError.style.display = 'none';
                if (komponenSuccess) komponenSuccess.style.display = 'none';
            }
        }

        // Event listener untuk Part Number dan No Lot Produksi
        document.addEventListener('DOMContentLoaded', function() {
            const inputPartNumber = document.getElementById('input-part-number');
            const inputLotNumber = document.getElementById('input-lot-number');
            const selectKomponen = document.getElementById('select-komponen');
            const formScanProduksi = document.getElementById('form-scan-produksi');
            
            // ✅ PERBAIKAN: Event listener untuk Part Number dengan validasi real-time
            if (inputPartNumber) {
                let partNumberTimeout;
                let lastPartNumberValue = '';
                
                // Trigger saat input berubah (setelah scan atau ketik) - dengan validasi real-time
                inputPartNumber.addEventListener('input', function() {
                    const currentValue = this.value.trim();
                    
                    // Clear timeout sebelumnya
                    clearTimeout(partNumberTimeout);
                    
                    // ✅ PERBAIKAN: Validasi real-time saat diketik (jika value berubah)
                    if (currentValue !== lastPartNumberValue && currentValue.length > 0) {
                        // Validasi langsung jika sudah ada value
                        partNumberTimeout = setTimeout(async () => {
                            try {
                                const validateResponse = await fetch(`/api/Scanner/komponen/validate/${encodeURIComponent(currentValue)}`);
                                const validateResult = await validateResponse.json();
                                
                                // Update UI feedback
                                if (validateResult.success) {
                                    inputPartNumber.classList.remove('is-invalid');
                                    inputPartNumber.classList.add('is-valid');
                                } else {
                                    inputPartNumber.classList.remove('is-valid');
                                    inputPartNumber.classList.add('is-invalid');
                                }
                                
                                // Check dan load komponen jika lot number sudah ada
                                checkAndLoadKomponen();
                            } catch (err) {
                                console.error('❌ Error validating Part Number:', err);
                            }
                        }, 500); // Debounce 500ms untuk validasi real-time
                    }
                    
                    lastPartNumberValue = currentValue;
                    
                    // ✅ PERBAIKAN: Check komponen dengan debounce lebih lama untuk load data
                    clearTimeout(partNumberTimeout);
                    partNumberTimeout = setTimeout(() => {
                        checkAndLoadKomponen();
                    }, 800); // Debounce 800ms untuk load komponen
                });
                
                // Trigger saat blur (ketika user selesai input)
                inputPartNumber.addEventListener('blur', function() {
                    clearTimeout(partNumberTimeout);
                    checkAndLoadKomponen();
                });
            }
            
            // ✅ PERBAIKAN: Event listener untuk No Lot Produksi dengan validasi real-time
            if (inputLotNumber) {
                let lotNumberTimeout;
                
                inputLotNumber.addEventListener('input', function() {
                    clearTimeout(lotNumberTimeout);
                    
                    // ✅ PERBAIKAN: Check komponen real-time saat diketik
                    lotNumberTimeout = setTimeout(() => {
                        checkAndLoadKomponen();
                    }, 500); // Debounce 500ms untuk real-time update
                });
                
                inputLotNumber.addEventListener('blur', function() {
                    clearTimeout(lotNumberTimeout);
                    checkAndLoadKomponen();
                });
            }
            
            // Event listener untuk dropdown komponen
            if (selectKomponen) {
                selectKomponen.addEventListener('change', function() {
                    selectedKomponenId = this.value;
                    const selectedOption = this.options[this.selectedIndex];
                    if (selectedOption && selectedOption.value) {
                        console.log('Komponen dipilih:', {
                            id: selectedOption.value,
                            text: selectedOption.textContent,
                            partNumber: selectedOption.getAttribute('data-part-number'),
                            jmlKomponen: selectedOption.getAttribute('data-jml-komponen')
                        });
                        checkAllInputsComplete();
                    } else {
                        selectedKomponenId = null;
                        checkAllInputsComplete();
                    }
                });
            }
            
            // ✅ Event listener untuk Man Power
            const selectManPower = document.getElementById('select-man-power');
            if (selectManPower) {
                selectManPower.addEventListener('change', function() {
                    checkAllInputsComplete();
                });
            }

            // ✅ Event listener untuk Penipisan radio buttons
            const penipisanRadios = document.querySelectorAll('#penipisan-group input[name="penipisan"]');
            const hiddenPenipisan = document.getElementById('hidden-penipisan');
            if (penipisanRadios.length > 0 && hiddenPenipisan) {
                penipisanRadios.forEach(radio => {
                    radio.addEventListener('change', function() {
                        if (this.checked) {
                            hiddenPenipisan.value = this.value;
                            console.log('✅ Penipisan dipilih:', this.value);
                            checkAllInputsComplete();
                        }
                    });
                });
            }

            // ✅ Event listener untuk Line radio buttons
            const lineRadios = document.querySelectorAll('#line-group input[name="line"]');
            const hiddenLine = document.getElementById('hidden-line');
            if (lineRadios.length > 0 && hiddenLine) {
                lineRadios.forEach(radio => {
                    radio.addEventListener('change', function() {
                        if (this.checked) {
                            hiddenLine.value = this.value;
                            console.log('✅ Line dipilih:', this.value);
                            checkAllInputsComplete();
                        }
                    });
                });
            }

            // ✅ Event listener untuk Shift radio buttons
            const shiftRadios = document.querySelectorAll('#shift-group input[name="shift"]');
            const hiddenShift = document.getElementById('hidden-shift');
            if (shiftRadios.length > 0 && hiddenShift) {
                shiftRadios.forEach(radio => {
                    radio.addEventListener('change', function() {
                        if (this.checked) {
                            hiddenShift.value = this.value;
                            console.log('✅ Shift dipilih:', this.value);
                            checkAllInputsComplete();
                        }
                    });
                });
            }

            // ✅ Function untuk check apakah semua input sudah lengkap
            function checkAllInputsComplete() {
                const lotNumber = document.getElementById('input-lot-number')?.value?.trim();
                const partNumber = document.getElementById('input-part-number')?.value?.trim();
                const namaCompound = document.getElementById('input-nama-compound')?.value?.trim();
                const beratAct = document.getElementById('select-berat-act')?.value?.trim();
                const urutan = document.getElementById('input-urutan')?.value?.trim();
                const penipisan = document.querySelector('#penipisan-group input[name="penipisan"]:checked')?.value;
                const line = document.querySelector('#line-group input[name="line"]:checked')?.value;
                const manPower = document.getElementById('select-man-power')?.value;
                const injection = document.querySelector('#injection-group input[name="injection"]:checked')?.value;
                const shift = document.querySelector('#shift-group input[name="shift"]:checked')?.value;
                const komponenId = selectedKomponenId;
                
                const allComplete = lotNumber && partNumber && namaCompound && beratAct && 
                                    urutan && penipisan && line && manPower && injection && 
                                    shift && komponenId;
                
                const formScanProduksi = document.getElementById('form-scan-produksi');
                if (formScanProduksi) {
                    if (allComplete) {
                        formScanProduksi.style.display = 'block';
                        console.log('✅ Semua input lengkap, form submit ditampilkan');
                    } else {
                        formScanProduksi.style.display = 'none';
                    }
                }
                
                return allComplete;
            }

            // ✅ Validasi workflow alur kerja
            function validateWorkflow() {
                const errors = [];
                
                // 1. Validasi Man Power & Injection
                const manPower = document.getElementById('select-man-power')?.value;
                const injection = document.querySelector('#injection-group input[name="injection"]:checked')?.value;
                const shift = document.querySelector('#shift-group input[name="shift"]:checked')?.value;
                
                if (!manPower) errors.push('Man Power harus dipilih');
                if (!injection) errors.push('Group Injection harus dipilih');
                if (!shift) errors.push('Shift harus dipilih');
                
                // 2. Validasi Input Data Produksi
                const lotNumber = document.getElementById('input-lot-number')?.value?.trim();
                const partNumber = document.getElementById('input-part-number')?.value?.trim();
                const namaCompound = document.getElementById('input-nama-compound')?.value?.trim();
                const beratAct = document.getElementById('select-berat-act')?.value?.trim();
                const urutan = document.getElementById('input-urutan')?.value?.trim();
                const penipisan = document.querySelector('#penipisan-group input[name="penipisan"]:checked')?.value;
                const line = document.querySelector('#line-group input[name="line"]:checked')?.value;
                const komponenId = selectedKomponenId;
                
                if (!lotNumber) errors.push('No Lot harus diisi');
                if (!partNumber) errors.push('No BO harus diisi');
                if (!namaCompound) errors.push('Nama Compound harus diisi');
                if (!beratAct) errors.push('Berat Act harus dipilih');
                if (!urutan) errors.push('Urutan harus diisi');
                if (!penipisan) errors.push('Penipisan harus dipilih');
                if (!line) errors.push('Line harus dipilih');
                if (!komponenId) errors.push('Komponen harus dipilih');
                
                return errors;
            }

            // ✅ Tambahkan event listener untuk semua input agar form submit muncul otomatis
            const inputsToWatch = [
                'input-lot-number', 'input-part-number', 'input-nama-compound',
                'select-berat-act', 'input-urutan', 'select-man-power',
                'select-komponen'
            ];
            
            inputsToWatch.forEach(inputId => {
                const input = document.getElementById(inputId);
                if (input) {
                    input.addEventListener('change', checkAllInputsComplete);
                    input.addEventListener('input', checkAllInputsComplete);
                }
            });
            
            // Listen untuk radio buttons
            ['penipisan', 'line', 'injection', 'shift'].forEach(name => {
                const radios = document.querySelectorAll(`input[name="${name}"]`);
                radios.forEach(radio => {
                    radio.addEventListener('change', checkAllInputsComplete);
                });
            });

            // Handle submit form scan produksi
            if (formScanProduksi) {
                formScanProduksi.addEventListener('submit', async function(e) {
                    e.preventDefault();

                    const partNumber = inputPartNumber?.value?.trim();
                    const lotNumber = inputLotNumber?.value?.trim();
                    const namaCompound = document.getElementById('input-nama-compound')?.value?.trim();
                    const beratAct = document.getElementById('select-berat-act')?.value?.trim();
                    const urutan = document.getElementById('input-urutan')?.value?.trim();
                    const penipisan = document.querySelector('#penipisan-group input[name="penipisan"]:checked')?.value;
                    const line = document.querySelector('#line-group input[name="line"]:checked')?.value;
                    const shift = document.querySelector('#shift-group input[name="shift"]:checked')?.value;
                    const manPower = document.getElementById('select-man-power')?.value;
                    const injection = document.querySelector('#injection-group input[name="injection"]:checked')?.value;
                    const komponenId = selectedKomponenId;

                    // ✅ Validasi workflow
                    const errors = validateWorkflow();
                    if (errors.length > 0) {
                        alert('Harap lengkapi semua field:\n' + errors.join('\n'));
                        return;
                    }

                    // Set semua hidden fields
                    document.getElementById('hidden-part-number').value = partNumber;
                    document.getElementById('hidden-lot-number').value = lotNumber;
                    document.getElementById('hidden-nama-compound').value = namaCompound;
                    document.getElementById('hidden-berat-act').value = beratAct;
                    document.getElementById('hidden-urutan').value = urutan;
                    document.getElementById('hidden-penipisan').value = penipisan;
                    document.getElementById('hidden-line').value = line;
                    document.getElementById('hidden-shift').value = shift;
                    document.getElementById('hidden-man-power').value = manPower;
                    document.getElementById('hidden-injection').value = injection;
                    document.getElementById('hidden-komponen-id').value = komponenId;

                    try {
                        const formData = new FormData(formScanProduksi);

                        const response = await fetch('/api/Scanner/scan-produksi/submit', {
                            method: 'POST',
                            body: formData
                        });

                        const result = await response.json();

                        if (result.success) {
                            alert(
                                '✅ Data scan produksi berhasil disimpan!\\n\\n' +
                                `JobRun ID : ${result.jobRunId}\\n` +
                                `Part Number : ${result.partNumber}\\n` +
                                `Lot Number  : ${result.lotNumber}\\n` +
                                `Komponen    : ${result.komponen.partNumber} (Qty: ${result.komponen.jmlKomponen})`
                            );
                            // Setelah ini operator bisa tekan tombol RUNNING
                            // Jika ingin otomatis:
                            // document.getElementById('btn-running')?.click();
                        } else {
                            alert('❌ ' + (result.message || 'Gagal menyimpan data scan produksi.'));
                        }
