                            btnRest.disabled = false;
                            const btnTextError = btnRest.querySelector('.btn-text');
                            if (btnTextError) {
                                btnTextError.textContent = 'Rest Break';
                            } else {
                                btnRest.innerHTML = originalText;
                            }
                        }
                    } catch (error) {
                        console.error('❌ Error:', error);
                        alert('❌ Terjadi error saat start REST BREAK. Silakan coba lagi.');
                        btnRest.disabled = false;
                        const btnTextError = btnRest.querySelector('.btn-text');
                        if (btnTextError) {
                            btnTextError.textContent = 'Rest Break';
                        } else {
                            btnRest.innerHTML = originalText;
                        }
                    }
                    
                    return false;
                });
            }
            
            // ✅ BACKUP: Juga attach event listener ke form submit untuk safety (jika button click tidak bekerja)
            if (restForm) {
                restForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    return false;
                });
            }
            
            // LINE STOP - AJAX handler (tidak refresh)
            const btnLineStop = document.getElementById('btn-line-stop');
            if (btnLineStop) {
                // ✅ PERBAIKAN: Update button utama saat modal dibuka
                const lineStopModal = document.getElementById('lineStopModal');
                if (lineStopModal) {
                    lineStopModal.addEventListener('show.bs.modal', function() {
                        const btnText = btnLineStop.querySelector('.btn-text');
                        if (btnText) {
                            btnText.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Opening...';
                        }
                    });
                }
            }
            
            if (lineStopForm) {
                lineStopForm.addEventListener('submit', async function(e) {
                    e.preventDefault(); // Prevent default form submission
                    e.stopPropagation(); // Stop event propagation
                    e.stopImmediatePropagation(); // Stop immediate propagation
                    
                    const formData = new FormData(this);
                    const reasonId = formData.get('reasonId');
                    
                    if (!reasonId) {
                        alert('❌ Silakan pilih alasan LINE STOP');
                        return;
                    }
                    
                    const token = formData.get('__RequestVerificationToken');
                    const submitButton = this.querySelector('button[type="submit"]');
                    const originalText = submitButton ? submitButton.innerHTML : '';
                    
                    // ✅ PERBAIKAN: Update button utama dengan loading indicator (smooth, tidak hard refresh)
                    if (btnLineStop) {
                        btnLineStop.disabled = true;
                        const btnText = btnLineStop.querySelector('.btn-text');
                        if (btnText) {
                            btnText.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Processing...';
                        } else {
                            btnLineStop.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Processing...';
                        }
                    }
                    
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Processing...';
                    }
                    
                    try {
                        const response = await fetch('/Operator/LineStop', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': token || '',
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });
                        
                        const result = await response.json();
                        
                        if (result.success) {
                            // ✅ CRITICAL: Reset timer dan mulai berjalan detik per detik SEBELUM update UI lainnya
                            resetTimerOnAction(); // Reset ke 00:00:00 dan mulai timer detik per detik
                            console.log('🔄 LINE STOP clicked - timer reset and started');
                            
                            isNoLoading = false; // Reset NoLoading status saat LINE STOP
                            hasActiveRestBreak = false; // Reset Rest Break status saat LINE STOP
                            
                            // ✅ PERBAIKAN: Update status mesin menjadi Aktif dan tampilkan Line Stop
                            const reasonSelect = this.querySelector('select[name="reasonId"]');
                            const reasonText = reasonSelect?.selectedOptions[0]?.text || 'Line Stop';
                            updateMachineStatusUI('Aktif', reasonText);
                            
                            // ✅ PERBAIKAN: Restore button utama setelah sukses
                            if (btnLineStop) {
                                btnLineStop.disabled = false;
                                const btnText = btnLineStop.querySelector('.btn-text');
                                if (btnText) {
                                    btnText.textContent = 'Line Stop';
                                } else {
                                    btnLineStop.innerHTML = '<i class="fa-solid fa-stop-circle me-1"></i>Line Stop';
                                }
                            }
                            
                            // Close modal
                            const modal = bootstrap.Modal.getInstance(document.getElementById('lineStopModal'));
                            if (modal) modal.hide();
                            
                            // ✅ PERBAIKAN: Restore scroll position
                            const scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
                            requestAnimationFrame(() => {
                                window.scrollTo({ top: scrollPosition, behavior: 'instant' });
                            });
                            
                            // ✅ PERBAIKAN: Refresh operator data dan time metrics untuk sinkronisasi
                            setTimeout(() => {
                                fetchOperatorDataForOee();
                                fetchTimeMetrics();
                            }, 500);
                        } else {
                            alert('❌ Error: ' + (result.message || 'Gagal start LINE STOP'));
                            // ✅ PERBAIKAN: Restore button utama jika error
                            if (btnLineStop) {
                                btnLineStop.disabled = false;
                                const btnText = btnLineStop.querySelector('.btn-text');
                                if (btnText) {
                                    btnText.textContent = 'Line Stop';
                                } else {
                                    btnLineStop.innerHTML = '<i class="fa-solid fa-stop-circle me-1"></i>Line Stop';
                                }
                            }
                            if (submitButton) {
                                submitButton.innerHTML = originalText;
                            }
                        }
                    } catch (error) {
                        console.error('❌ Error:', error);
                        alert('❌ Terjadi error saat start LINE STOP. Silakan coba lagi.');
                        // ✅ PERBAIKAN: Restore button utama jika error
                        if (btnLineStop) {
                            btnLineStop.disabled = false;
                            const btnText = btnLineStop.querySelector('.btn-text');
                            if (btnText) {
                                btnText.textContent = 'Line Stop';
                            } else {
                                btnLineStop.innerHTML = '<i class="fa-solid fa-stop-circle me-1"></i>Line Stop';
                            }
                        }
                        if (submitButton) {
                            submitButton.innerHTML = originalText;
                        }
                    } finally {
                        if (submitButton) {
                            submitButton.disabled = false;
                        }
                    }
                });
            }
            
            // NO LOADING - AJAX handler (tidak refresh)
            const btnNoLoading = document.getElementById('btn-no-loading');
            if (btnNoLoading) {
                // ✅ PERBAIKAN: Update button utama saat modal dibuka
                const noLoadingModal = document.getElementById('noLoadingModal');
                if (noLoadingModal) {
                    noLoadingModal.addEventListener('show.bs.modal', function() {
                        const btnText = btnNoLoading.querySelector('.btn-text');
                        if (btnText) {
                            btnText.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Opening...';
                        }
                    });
                }
            }
            
            if (noLoadingForm) {
                noLoadingForm.addEventListener('submit', async function(e) {
                    e.preventDefault(); // Prevent default form submission
                    e.stopPropagation(); // Stop event propagation
                    e.stopImmediatePropagation(); // Stop immediate propagation
                    
                    const formData = new FormData(this);
                    const token = formData.get('__RequestVerificationToken');
                    const submitButton = this.querySelector('button[type="submit"]');
                    const originalText = submitButton ? submitButton.innerHTML : '';
                    
                    // ✅ PERBAIKAN: Update button utama dengan loading indicator (smooth, tidak hard refresh)
                    if (btnNoLoading) {
                        btnNoLoading.disabled = true;
                        const btnText = btnNoLoading.querySelector('.btn-text');
                        if (btnText) {
                            btnText.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Processing...';
                        } else {
                            btnNoLoading.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Processing...';
                        }
                    }
                    
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Processing...';
                    }
                    
                    try {
                        const response = await fetch('/Operator/NoLoading', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': token || '',
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });
                        
                        const result = await response.json();
                        
                        if (result.success) {
                            // ✅ CRITICAL: Reset timer dan mulai berjalan detik per detik SEBELUM update UI lainnya
                            resetTimerOnAction(); // Reset ke 00:00:00 dan mulai timer detik per detik
                            console.log('🔄 NO LOADING clicked - timer reset and started');
                            
                            isNoLoading = true; // Set NoLoading status
                            hasActiveRestBreak = false; // Reset Rest Break status saat NO LOADING
                            
                            // ✅ PERBAIKAN: Update status mesin menjadi Aktif dan tampilkan No Loading
                            updateMachineStatusUI('Aktif', 'No Loading');
                            
                            // ✅ PERBAIKAN: Restore button utama setelah sukses
                            if (btnNoLoading) {
                                btnNoLoading.disabled = false;
                                const btnText = btnNoLoading.querySelector('.btn-text');
                                if (btnText) {
                                    btnText.textContent = 'NoLoading';
                                } else {
                                    btnNoLoading.innerHTML = '<i class="fa-regular fa-hourglass-half me-1"></i>NoLoading';
                                }
                            }
                            
                            // Close modal
                            const modal = bootstrap.Modal.getInstance(document.getElementById('noLoadingModal'));
                            if (modal) modal.hide();
                            
                            // ✅ PERBAIKAN: Restore scroll position
                            const scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
                            requestAnimationFrame(() => {
                                window.scrollTo({ top: scrollPosition, behavior: 'instant' });
                            });
                            
                            // ✅ PERBAIKAN: Refresh operator data dan time metrics untuk sinkronisasi
                            setTimeout(() => {
                                fetchOperatorDataForOee();
                                fetchTimeMetrics();
                            }, 500);
                        } else {
                            alert('❌ Error: ' + (result.message || 'Gagal set NO LOADING'));
                            // ✅ PERBAIKAN: Restore button utama jika error
                            if (btnNoLoading) {
                                btnNoLoading.disabled = false;
                                const btnText = btnNoLoading.querySelector('.btn-text');
                                if (btnText) {
                                    btnText.textContent = 'NoLoading';
                                } else {
                                    btnNoLoading.innerHTML = '<i class="fa-regular fa-hourglass-half me-1"></i>NoLoading';
                                }
                            }
                            if (submitButton) {
                                submitButton.innerHTML = originalText;
                            }
                        }
                    } catch (error) {
                        console.error('❌ Error:', error);
                        alert('❌ Terjadi error saat set NO LOADING. Silakan coba lagi.');
                        // ✅ PERBAIKAN: Restore button utama jika error
                        if (btnNoLoading) {
                            btnNoLoading.disabled = false;
                            const btnText = btnNoLoading.querySelector('.btn-text');
                            if (btnText) {
                                btnText.textContent = 'NoLoading';
                            } else {
                                btnNoLoading.innerHTML = '<i class="fa-regular fa-hourglass-half me-1"></i>NoLoading';
                            }
                        }
                        if (submitButton) {
                            submitButton.innerHTML = originalText;
                        }
                    } finally {
                        if (submitButton) {
                            submitButton.disabled = false;
                        }
                    }
                });
            }
            
            // ✅ TAMBAHKAN: Event listener untuk form Add Quantity (Intercept & Stop Timer)
            const addQtyForm = document.getElementById('add-qty-form');
            if (addQtyForm) {
                addQtyForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    if (!validateGroupInjection()) {
                        return false;
                    }

                    // ✅ 1. STOP Timer & Get Duration
                    stopDurasiProduksi();
                    const finalDuration = durasiProduksiSeconds;
                    console.log('⏱️ Timer stopped on Qty Submit. Duration:', finalDuration);

                    // ✅ 2. Populate ManPower & Injection Hidden Fields
                    const manPowerVal = document.getElementById('select-man-power')?.value;
                    const injectionVal = document.querySelector('input[name="injection"]:checked')?.value;

                    // Ensure hidden fields are set in form (for FormData extraction)
                    if(document.getElementById('hidden-qtymodal-manpower')) {
                         document.getElementById('hidden-qtymodal-manpower').value = manPowerVal || '';
                    }
                    if(document.getElementById('hidden-injection')) {
                         document.getElementById('hidden-injection').value = injectionVal || '';
                    }

                    // ✅ 3. Get Data
                    const formData = new FormData(addQtyForm);
                    const goodQty = formData.get('goodQty');
                    const rejectQty = formData.get('rejectQty');
                    
                    // ✅ 4. Update Local Storage with Qty & Duration (PER ITEM)
                    updateProductionDataWithQty(goodQty, rejectQty, finalDuration);

                    // ✅ 5. Submit to Server (REAL Backend)
                    const submitBtn = addQtyForm.querySelector('button[type="submit"]');
                    const originalText = submitBtn ? submitBtn.innerHTML : 'Simpan';
                    if(submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Saving...';
                    }

                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        if(token) {
                            formData.set('__RequestVerificationToken', token);
                        }

                        // Explicitly add manPowerId if not picked up (redundant safety)
                        if(manPowerVal && !formData.has('manPowerId')) {
                            formData.append('manPowerId', manPowerVal);
                        }

                        const response = await fetch('/Operator/AddQuantity?ajax=1', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': token || '',
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const result = await response.json();

                        if (result.success || response.ok) { // Check both for robustness
                             console.log('✅ Quantity submitted successfully');
                             
                             // Close modal
                             const modalEl = document.getElementById('addQtyModal');
                             const modal = bootstrap.Modal.getInstance(modalEl);
                             if(modal) modal.hide();

                             // Reset form
                             addQtyForm.reset();
                             
                             showToast('Quantity saved! Item completed.', 'success');
                        } else {
                             console.error('❌ Server Error:', result.message);
                             showToast('Gagal menyimpan Qty: ' + (result.message || 'Unknown Error'), 'error');
                        }
                    } catch (error) {
                        console.error('❌ Network Error:', error);
                        showToast('Error koneksi saat menyimpan Qty', 'error');
                    } finally {
                        if(submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalText;
                        }
                    }
                });
            }

            // REDUNDANT SUBMIT HANDLER REMOVED - Consolidated with one at 4180

            // Initialize action buttons state
            updateActionButtonsOee({
                MachineStatus: machineStatusOee,
                HasActiveJob: hasActiveJobOee,
                HasActiveDowntime: hasActiveDowntimeOee,
                IsNoLoading: isNoLoading
            });
            
            // ✅ PERBAIKAN: Pastikan timer "since-last-status" selalu berjalan setelah DOM ready
            // Jika timer belum diinisialisasi, inisialisasi sekarang
            if (!window.sinceLastChangeInterval) {
                // Jika lastChangeTimestamp belum di-set, set ke waktu sekarang
                if (!window.lastChangeTimestamp) {
                    window.lastChangeTimestamp = new Date();
                }
                // Pastikan timer berjalan
                updateTimerDisplay();
                window.sinceLastChangeInterval = setInterval(() => {
                    updateTimerDisplay();
                }, 1000);
                console.log('✅ Timer "since-last-status" interval started on DOM ready');
            } else {
                // ✅ PERBAIKAN: Jika interval sudah ada, pastikan tetap berjalan
                console.log('✅ Timer "since-last-status" interval already running');
            }
            
            // Verify timer is running
            setTimeout(() => {
                if (window.sinceLastChangeInterval) {
                    const sinceLastStatusEl = document.getElementById('since-last-status');
                    if (sinceLastStatusEl) {
                        console.log('✅ Timer "since-last-status" verified - running correctly, current display:', sinceLastStatusEl.textContent);
                    }
                } else {
                    console.error('❌ Timer "since-last-status" failed to start!');
                }
            }, 2000);
        });
    </script>

    <style>
        /* Filter Card Styling */
        #filter-date {
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        
        #filter-date:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        /* Pulse animation untuk indikator real-time */
        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.5;
            }
        }
        
        /* Action Buttons Horizontal Layout */
        #running-form,
        #rest-form {
            margin: 0;
        }
        
        /* Samakan ukuran & alignment semua tombol Machine Actions */
        .machine-action-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
            min-height: 45px; /* ✅ Ukuran tinggi yang sama untuk semua button */
            height: 45px; /* ✅ Pastikan tinggi tetap sama */
            padding: 0.6rem 1.2rem; /* ✅ Padding yang sama untuk semua button */
            font-size: 0.95rem; /* ✅ Ukuran font yang sama */
            border-radius: 8px !important; /* ✅ Border radius yang sama */
            font-weight: 500; /* ✅ Font weight yang sama */
            width: 100%; /* ✅ Pastikan semua button memiliki lebar yang sama */
            box-sizing: border-box; /* ✅ Pastikan padding tidak mempengaruhi ukuran */
        }
        
        /* Ensure buttons are clickable */
        button[type="submit"]:not(:disabled),
        #btn-running:not(:disabled),
        #btn-rest:not(:disabled),
        #btn-line-stop:not(:disabled),
        #btn-no-loading:not(:disabled) {
            pointer-events: auto !important;
            cursor: pointer !important;
            z-index: 10 !important;
        }
        
        
        /* Button hover effects */
        .btn-outline-success:hover:not(:disabled),
        .btn-outline-warning:hover:not(:disabled),
        .btn-outline-danger:hover:not(:disabled),
        .btn-outline-info:hover:not(:disabled),
        .btn-primary:hover:not(:disabled) {
            transform: scale(1.02);
            transition: transform 0.2s ease;
        }
        
        /* Responsive: Stack buttons on small screens */
        @@media (max-width: 768px) {
            .col-md-3 {
                margin-bottom: 0.5rem;
            }
            
            .machine-action-btn {
                min-height: 42px; /* Sedikit lebih kecil di mobile */
                height: 42px;
                padding: 0.5rem 1rem;
            }
        }
        
        /* SCW Card Styling - Hanya styling untuk disabled state */
        /* JENIS 4M: Tidak ada styling khusus, gunakan default Bootstrap */
        
        /* JENIS REMARK: Hanya styling untuk disabled state */
        /* SCW CARD: Robust State Styles */
        #scw-4m-type,
        #scw-remark {
            transition: all 0.2s ease;
        }

        /* Ensure dropdown items are readable in custom themes */
        #scw-remark option {
            background-color: #2b2d31;
            color: #ffffff;
        }

        #btn-scw-submit {
            font-weight: 500;
            border-radius: 8px;
            transition: transform 0.2s ease;
        }

        #btn-scw-submit:hover:not(:disabled) {
            transform: translateY(-1px);
        }
        
        
        #btn-scw-submit {
            font-weight: 500;
            border-radius: 8px;
        }
        
        #btn-scw-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        
        /* Responsive untuk mobile */
        @@media (max-width: 768px) {
            #btn-scw-submit {
                min-width: 100%;
            }
        }
    </style>

    <!-- Scanner Modal & Logic -->
    <style>
        /* Scanner Modal Styling */
