                            const btnText = btnLineStop.querySelector('.btn-text');
                            if (btnText) {
                                btnText.textContent = 'Line Stop';
                            } else {
                                btnLineStop.innerHTML = '<i class="fa-solid fa-stop-circle me-1"></i>Line Stop';
                            }
                        }
                        if (submitButton) {
                            submitButton.innerHTML = originalText;
                        }
                    } finally {
                        if (submitButton) {
                            submitButton.disabled = false;
                        }
                    }
                });
            }
            
            // NO LOADING - AJAX handler (tidak refresh)
            const btnNoLoading = document.getElementById('btn-no-loading');
            if (btnNoLoading) {
                // ✅ PERBAIKAN: Update button utama saat modal dibuka
                const noLoadingModal = document.getElementById('noLoadingModal');
                if (noLoadingModal) {
                    noLoadingModal.addEventListener('show.bs.modal', function() {
                        const btnText = btnNoLoading.querySelector('.btn-text');
                        if (btnText) {
                            btnText.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Opening...';
                        }
                    });
                }
            }
            
            if (noLoadingForm) {
                noLoadingForm.addEventListener('submit', async function(e) {
                    e.preventDefault(); // Prevent default form submission
                    e.stopPropagation(); // Stop event propagation
                    e.stopImmediatePropagation(); // Stop immediate propagation
                    
                    const formData = new FormData(this);
                    const token = formData.get('__RequestVerificationToken');
                    const submitButton = this.querySelector('button[type="submit"]');
                    const originalText = submitButton ? submitButton.innerHTML : '';
                    
                    // ✅ PERBAIKAN: Update button utama dengan loading indicator (smooth, tidak hard refresh)
                    if (btnNoLoading) {
                        btnNoLoading.disabled = true;
                        const btnText = btnNoLoading.querySelector('.btn-text');
                        if (btnText) {
                            btnText.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Processing...';
                        } else {
                            btnNoLoading.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Processing...';
                        }
                    }
                    
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Processing...';
                    }
                    
                    try {
                        const response = await fetch('/Operator/NoLoading', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': token || '',
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });
                        
                        const result = await response.json();
                        
                        if (result.success) {
                            // ✅ CRITICAL: Reset timer dan mulai berjalan detik per detik SEBELUM update UI lainnya
                            resetTimerOnAction(); // Reset ke 00:00:00 dan mulai timer detik per detik
                            console.log('🔄 NO LOADING clicked - timer reset and started');
                            
                            isNoLoading = true; // Set NoLoading status
                            hasActiveRestBreak = false; // Reset Rest Break status saat NO LOADING
                            
                            // ✅ PERBAIKAN: Update status mesin menjadi Aktif dan tampilkan No Loading
                            updateMachineStatusUI('Aktif', 'No Loading');
                            
                            // ✅ PERBAIKAN: Restore button utama setelah sukses
                            if (btnNoLoading) {
                                btnNoLoading.disabled = false;
                                const btnText = btnNoLoading.querySelector('.btn-text');
                                if (btnText) {
                                    btnText.textContent = 'NoLoading';
                                } else {
                                    btnNoLoading.innerHTML = '<i class="fa-regular fa-hourglass-half me-1"></i>NoLoading';
                                }
                            }
                            
                            // Close modal
                            const modal = bootstrap.Modal.getInstance(document.getElementById('noLoadingModal'));
                            if (modal) modal.hide();
                            
                            // ✅ PERBAIKAN: Restore scroll position
                            const scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
                            requestAnimationFrame(() => {
                                window.scrollTo({ top: scrollPosition, behavior: 'instant' });
                            });
                            
                            // ✅ PERBAIKAN: Refresh operator data dan time metrics untuk sinkronisasi
                            setTimeout(() => {
                                fetchOperatorDataForOee();
                                fetchTimeMetrics();
                            }, 500);
                        } else {
                            alert('❌ Error: ' + (result.message || 'Gagal set NO LOADING'));
                            // ✅ PERBAIKAN: Restore button utama jika error
                            if (btnNoLoading) {
                                btnNoLoading.disabled = false;
                                const btnText = btnNoLoading.querySelector('.btn-text');
                                if (btnText) {
                                    btnText.textContent = 'NoLoading';
                                } else {
                                    btnNoLoading.innerHTML = '<i class="fa-regular fa-hourglass-half me-1"></i>NoLoading';
                                }
                            }
                            if (submitButton) {
                                submitButton.innerHTML = originalText;
                            }
                        }
                    } catch (error) {
                        console.error('❌ Error:', error);
                        alert('❌ Terjadi error saat set NO LOADING. Silakan coba lagi.');
                        // ✅ PERBAIKAN: Restore button utama jika error
                        if (btnNoLoading) {
                            btnNoLoading.disabled = false;
                            const btnText = btnNoLoading.querySelector('.btn-text');
                            if (btnText) {
                                btnText.textContent = 'NoLoading';
                            } else {
                                btnNoLoading.innerHTML = '<i class="fa-regular fa-hourglass-half me-1"></i>NoLoading';
                            }
                        }
                        if (submitButton) {
                            submitButton.innerHTML = originalText;
                        }
                    } finally {
                        if (submitButton) {
                            submitButton.disabled = false;
                        }
                    }
                });
            }
            
            // ✅ TAMBAHKAN: Event listener untuk form Add Quantity (Intercept & Stop Timer)
            const addQtyForm = document.getElementById('add-qty-form');
            if (addQtyForm) {
                addQtyForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    if (!validateGroupInjection()) {
                        return false;
                    }

                    // ✅ 1. STOP Timer & Get Duration
                    stopDurasiProduksi();
                    const finalDuration = durasiProduksiSeconds;
                    console.log('⏱️ Timer stopped on Qty Submit. Duration:', finalDuration);

                    // ✅ 2. Populate ManPower & Injection Hidden Fields
                    const manPowerVal = document.getElementById('select-man-power')?.value;
                    const injectionVal = document.querySelector('input[name="injection-group"]:checked')?.value;

                    // Ensure hidden fields are set in form (for FormData extraction)
                    if(document.getElementById('hidden-qtymodal-manpower')) {
                         document.getElementById('hidden-qtymodal-manpower').value = manPowerVal || '';
                    }
                    if(document.getElementById('hidden-injection')) {
                         document.getElementById('hidden-injection').value = injectionVal || '';
                    }

                    // ✅ 3. Get Data
                    const formData = new FormData(addQtyForm);
                    const goodQty = formData.get('goodQty');
                    const rejectQty = formData.get('rejectQty');
                    
                    // ✅ 4. Update Local Storage with Qty & Duration (PER ITEM)
                    updateProductionDataWithQty(goodQty, rejectQty, finalDuration);

                    // ✅ 5. Submit to Server (REAL Backend)
                    const submitBtn = addQtyForm.querySelector('button[type="submit"]');
                    const originalText = submitBtn ? submitBtn.innerHTML : 'Simpan';
                    if(submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Saving...';
                    }

                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        if(token) {
                            formData.set('__RequestVerificationToken', token);
                        }

                        // Explicitly add manPowerId if not picked up (redundant safety)
                        if(manPowerVal && !formData.has('manPowerId')) {
                            formData.append('manPowerId', manPowerVal);
                        }

                        const response = await fetch('/Operator/AddQuantity', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': token || '',
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const result = await response.json();

                        if (result.success || response.ok) { // Check both for robustness
                             console.log('✅ Quantity submitted successfully');
                             
                             // Close modal
                             const modalEl = document.getElementById('addQtyModal');
                             const modal = bootstrap.Modal.getInstance(modalEl);
                             if(modal) modal.hide();

                             // Reset form
                             addQtyForm.reset();
                             
                             showToast('Quantity saved! Item completed.', 'success');
                        } else {
                             console.error('❌ Server Error:', result.message);
                             showToast('Gagal menyimpan Qty: ' + (result.message || 'Unknown Error'), 'error');
                        }
                    } catch (error) {
                        console.error('❌ Network Error:', error);
                        showToast('Error koneksi saat menyimpan Qty', 'error');
                    } finally {
                        if(submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalText;
                        }
                    }
                });
            }
            
            // Initialize action buttons state
            updateActionButtonsOee({
                MachineStatus: machineStatusOee,
                HasActiveJob: hasActiveJobOee,
                HasActiveDowntime: hasActiveDowntimeOee,
                IsNoLoading: isNoLoading
            });
            
            // ✅ PERBAIKAN: Pastikan timer "since-last-status" selalu berjalan setelah DOM ready
            // Jika timer belum diinisialisasi, inisialisasi sekarang
            if (!sinceLastChangeInterval) {
                // Jika lastChangeTimestamp belum di-set, set ke waktu sekarang
                if (!lastChangeTimestamp) {
                    lastChangeTimestamp = new Date();
                }
                // Pastikan timer berjalan
                updateTimerDisplay();
                sinceLastChangeInterval = setInterval(() => {
                    updateTimerDisplay();
                }, 1000);
                console.log('✅ Timer "since-last-status" interval started on DOM ready');
            } else {
                // ✅ PERBAIKAN: Jika interval sudah ada, pastikan tetap berjalan
                console.log('✅ Timer "since-last-status" interval already running');
            }
            
            // Verify timer is running
            setTimeout(() => {
                if (sinceLastChangeInterval) {
                    const sinceLastStatusEl = document.getElementById('since-last-status');
                    if (sinceLastStatusEl) {
                        console.log('✅ Timer "since-last-status" verified - running correctly, current display:', sinceLastStatusEl.textContent);
                    }
                } else {
                    console.error('❌ Timer "since-last-status" failed to start!');
                }
            }, 2000);
        });

        // Fetch operator data untuk update action buttons dan production data
        async function fetchOperatorDataForOee() {
            const machineId = '@Html.Raw(Model.MachineId)';
            if (!machineId) {
                console.warn('Machine ID is not available');
                return;
            }
            
            try {
                const response = await fetch(`/Operator/GetOperatorData?machineId=${machineId}`);
                if (!response.ok) {
                    console.warn(`HTTP error! status: ${response.status}`);
                    return;
                }
                
                const data = await response.json();
                
                // Defensive: Check if data exists and has expected structure
                if (!data || typeof data !== 'object') {
                    console.warn('Unexpected data structure:', data);
                    return;
                }
                
                // Update state with safe defaults
                hasActiveJobOee = data?.HasActiveJob ?? false;
                hasActiveDowntimeOee = data?.HasActiveDowntime ?? false;
                machineStatusOee = data?.MachineStatus ?? machineStatusOee;
                
                // Update NoLoading status dari data jika ada
                if (data?.IsNoLoading !== undefined) {
                    isNoLoading = data.IsNoLoading;
                }
                
                // ✅ PERBAIKAN: Update Rest Break status dari data jika ada
                if (data?.HasActiveRestBreak !== undefined) {
                    hasActiveRestBreak = data.HasActiveRestBreak;
                }
                
                // ✅ Update durasi sejak status terakhir dari backend
                if (data?.SinceLastChangeSeconds !== undefined && data.SinceLastChangeSeconds !== null) {
                    // ✅ CRITICAL: Deteksi apakah mesin sedang Running
                    // Running jika: MachineStatus === 'Running' atau 'Aktif' DAN tidak ada downtime aktif DAN tidak ada Rest Break
                    const isRunning = (data?.MachineStatus === 'Running' || data?.MachineStatus === 'Aktif') && 
                                      !(data?.HasActiveDowntime || data?.HasActiveRestBreak);
                    
                    // ✅ CRITICAL: Jika Running dan ada LastStatusChangeTime, SELALU gunakan itu untuk set runningStartTimeUtc
                    // Ini memastikan durasi sinkron dengan backend, bukan dihitung dari initialTimeSeconds
                    // ✅ CRITICAL: Set runningStartTimeUtc SEBELUM memanggil updateSinceLastChange() agar digunakan dengan benar
                    if (isRunning && data?.LastStatusChangeTime) {
                        try {
                            const lastChangeTime = new Date(data.LastStatusChangeTime);
                            if (!isNaN(lastChangeTime.getTime())) {
                                // ✅ CRITICAL: Set runningStartTimeUtc langsung dari LastStatusChangeTime (sumber kebenaran dari backend)
                                // Ini memastikan durasi selalu sinkron dengan waktu saat Running diklik di backend
                                runningStartTimeUtc = lastChangeTime;
                                if (typeof window.runningStartTimeUtc !== 'undefined') {
                                    window.runningStartTimeUtc = lastChangeTime;
                                }
                                console.log('✅ Set runningStartTimeUtc from LastStatusChangeTime (backend source):', lastChangeTime.toISOString(), 'SinceLastChangeSeconds:', data.SinceLastChangeSeconds);
                            }
                        } catch (dateError) {
                            console.warn('Error parsing LastStatusChangeTime:', dateError);
                        }
                    } else if (isRunning) {
                        // Jika Running tapi tidak ada LastStatusChangeTime, clear runningStartTimeUtc
                        runningStartTimeUtc = null;
                        if (typeof window.runningStartTimeUtc !== 'undefined') {
                            window.runningStartTimeUtc = null;
                        }
                        console.warn('⚠️ Running but no LastStatusChangeTime, cleared runningStartTimeUtc');
                    }
                    
                    // ✅ CRITICAL: Panggil updateSinceLastChange() SETELAH runningStartTimeUtc di-set dari LastStatusChangeTime
                    updateSinceLastChange(data.SinceLastChangeSeconds, isRunning);
                    console.log('🔄 Updated "since-last-status" timer from backend:', data.SinceLastChangeSeconds, 'isRunning:', isRunning, 'LastStatusChangeTime:', data?.LastStatusChangeTime, 'runningStartTimeUtc:', runningStartTimeUtc?.toISOString());
                } else if (data?.LastStatusChangeTime) {
                    // Fallback: hitung dari LastStatusChangeTime jika SinceLastChangeSeconds tidak ada
                    try {
                        const lastChangeTime = new Date(data.LastStatusChangeTime);
                        if (!isNaN(lastChangeTime.getTime())) {
                            const now = new Date();
                            const diffSeconds = Math.floor((now.getTime() - lastChangeTime.getTime()) / 1000);
                            const isRunning = (data?.MachineStatus === 'Running' || data?.MachineStatus === 'Aktif') && 
                                              !(data?.HasActiveDowntime || data?.HasActiveRestBreak);
                            
                            // ✅ PERBAIKAN: Jika Running, set runningStartTimeUtc dari LastStatusChangeTime
                            if (isRunning) {
                                runningStartTimeUtc = lastChangeTime;
                                if (typeof window.runningStartTimeUtc !== 'undefined') {
                                    window.runningStartTimeUtc = lastChangeTime;
                                }
                                console.log('✅ Set runningStartTimeUtc from LastStatusChangeTime (fallback):', lastChangeTime.toISOString());
                            }
                            
                            updateSinceLastChange(Math.max(0, diffSeconds), isRunning);
                        }
                    } catch (dateError) {
                        console.warn('Error parsing LastStatusChangeTime:', dateError);
                    }
                }
                
                // Update action buttons
                updateActionButtonsOee(data);
                
                // Update machine status
                updateMachineStatusOee(data);
                
                // Update production data
                updateProductionDataOee(data);
            } catch (error) {
                console.error('Error fetching operator data for OEE:', error);
                // Don't break the UI, just log the error
            }
        }

        // ✅ PERBAIKAN: Fetch operator data lebih sering (setiap 2 detik) untuk update downtime reason dan durasi yang cepat dan sinkron
        // Ini memastikan downtime reason dan durasi update cepat tanpa delay
        setInterval(() => {
            fetchOperatorDataForOee();
        }, 2000);

        // Initial fetch
        fetchOperatorDataForOee();
        
        // ========== INPUT WAKTU KERJA OPERATOR - LIVE TIMER ==========
        (function () {
            'use strict';

            let timerInterval = null;
            let serverTimeOffset = 0; // selisih waktu server dan client (ms)
            
            // ✅ PERBAIKAN: Export serverTimeOffset ke global scope agar bisa digunakan oleh durasi
            window.getServerTimeOffset = function() {
                return serverTimeOffset;
            };
            
            // ✅ PERBAIKAN: Export fungsi untuk mendapatkan waktu server yang disesuaikan
            window.getAdjustedServerTime = function() {
                const nowClient = new Date();
                return new Date(nowClient.getTime() + serverTimeOffset);
            };
            
            // ✅ PERBAIKAN: Fungsi untuk sync ulang serverTimeOffset secara berkala
            function syncServerTimeOffset() {
                // Ambil waktu server dari Razor (fallback ke waktu client jika null)
                const serverTimeStr = '@Html.Raw(DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss"))';
                const serverTime = new Date(serverTimeStr);
                const clientTime = new Date();

                if (!isNaN(serverTime.getTime())) {
                    serverTimeOffset = serverTime.getTime() - clientTime.getTime();
                } else {
                    serverTimeOffset = 0;
                }
            }

            function initializeLiveTimer() {
                const timeDisplay = document.getElementById('filter-time-display');
                const filterTimeHidden = document.getElementById('filter-time');
                const filterTimeTimestamp = document.getElementById('filter-time-timestamp');
                const filterDate = document.getElementById('filter-date');

                if (!timeDisplay || !filterTimeHidden || !filterTimeTimestamp || !filterDate) {
                    console.warn('Input Waktu Kerja Operator elements not found', {
                        timeDisplay: !!timeDisplay,
                        filterTimeHidden: !!filterTimeHidden,
                        filterTimeTimestamp: !!filterTimeTimestamp,
                        filterDate: !!filterDate
                    });
                    return;
                }

                // ✅ PERBAIKAN: Sync serverTimeOffset pertama kali
                syncServerTimeOffset();
                console.log('✅ Server time offset initialized:', serverTimeOffset, 'ms');

                function updateTimer() {
                    try {
                        // ✅ PERBAIKAN: Gunakan getAdjustedServerTime untuk konsistensi
                        const nowAdjusted = window.getAdjustedServerTime();

                        const hours = String(nowAdjusted.getHours()).padStart(2, '0');
                        const minutes = String(nowAdjusted.getMinutes()).padStart(2, '0');
                        const seconds = String(nowAdjusted.getSeconds()).padStart(2, '0');

                        const timeString = `${hours}:${minutes}:${seconds}`;
                        const isoString = nowAdjusted.toISOString().slice(0, 19);
                        const dateString = nowAdjusted.toISOString().split('T')[0];

                        // Tampilkan di UI (input field) - pastikan update terjadi
                        if (timeDisplay) {
                            timeDisplay.value = timeString;
                            // Force update untuk memastikan perubahan terlihat
                            timeDisplay.dispatchEvent(new Event('input', { bubbles: true }));
                        }

                        // Simpan ke hidden fields untuk backend
                        if (filterTimeHidden) {
                            filterTimeHidden.value = timeString;
                        }
                        if (filterTimeTimestamp) {
                            filterTimeTimestamp.value = isoString;
                        }

                        // Sinkronkan tanggal jika berubah
                        if (filterDate && (!filterDate.value || filterDate.value !== dateString)) {
                            filterDate.value = dateString;
                        }
                    } catch (error) {
                        console.error('Error updating timer:', error);
                    }

                }

                // Jalankan pertama kali
                updateTimer();

                // ✅ PERBAIKAN: Update setiap detik dengan setInterval yang reliable
                // Gunakan setInterval langsung dengan 1000ms untuk update setiap detik
                timerInterval = window.setInterval(function() {
                    updateTimer();
                }, 1000);
                
                console.log('✅ Jam proses timer started - akan update setiap detik');
                
                // Cleanup saat halaman ditutup
                window.addEventListener('beforeunload', function () {
                    if (timerInterval) {
                        window.clearInterval(timerInterval);
                    }
                });
                
                // ✅ PERBAIKAN: Sync ulang serverTimeOffset setiap 30 detik untuk menghindari drift
                setInterval(function() {
                    syncServerTimeOffset();
                }, 30000);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initializeLiveTimer);
            } else {
                initializeLiveTimer();
            }
        })();
        // ========== END INPUT WAKTU KERJA OPERATOR ==========

        // ========== ULTIMATE SCW (Stop Call Waiting) HANDLER ==========
        
        // ========== SCW HANDLER (ULTIMATE SYNC VERSION) ==========
        (function() {
            window.handleScw4MChange = async function(val) {
                const $target = $('#scw-remark');
                const $source = $('#scw-4m-type');
                
                const typeId = val || $source.val();
                console.log(`[SCW] Handler Triggered | TypeId: "${typeId}"`);

                // 1. Reset state
                $target.empty();
                
                if (!typeId || typeId === "") {
                    $target.append('<option value="">-- Pilih Jenis 4M terlebih dahulu --</option>');
                    $target.prop('disabled', true);
                    return;
                }

                // 2. Enable
                $target.prop('disabled', false).removeAttr('disabled');
                $target.append('<option value="">-- Pilih Jenis Remark --</option>');

                // 3. Populate from Server-Rendered Data (Bulletproof)
                // We look for options that were rendered by Razor but hidden
                const $allOptions = $('.scw-remark-option');
                let foundCount = 0;

                $allOptions.each(function() {
                    const parentId = $(this).data('parent-id');
                    if (parentId == typeId) {
                        // Clone and show the option
                        const $opt = $(this).clone().show().removeAttr('style');
                        $target.append($opt);
                        foundCount++;
                    }
                });

                console.log(`[SCW] Found ${foundCount} pre-rendered items in HTML`);

                // 4. Background Sync for Data Integrity (API)
                if (/^\d+$/.test(typeId)) {
                    try {
                        const response = await fetch(`/api/Operator/GetScwRemarks?scw4MTypeId=${typeId}`);
                        if (response.ok) {
                            const data = await response.json();
                            if (data.success && data.remarks && data.remarks.length > 0) {
                                console.log(`[SCW] API Sync success: ${data.remarks.length} items from server`);
                                
                                // Jika data di HTML kosong atau berbeda, kita seragamkan dengan API
                                if (foundCount === 0 || data.remarks.length !== foundCount) {
                                    const currentVal = $target.val();
                                    $target.empty().append('<option value="">-- Pilih Jenis Remark --</option>');
                                    data.remarks.forEach(r => {
                                        $target.append($('<option>', { value: r.id, text: r.description }));
                                    });
                                    if (currentVal) $target.val(currentVal);
                                }
                            }
                        }
                    } catch (err) {
                        console.warn('[SCW] Silent sync failed', err);
                    }
                }
            };

            // Init & Event Binding
            $(document).ready(function() {
                // Delegate binding for better robustness
                $(document).on('change', '#scw-4m-type', function() {
                    window.handleScw4MChange($(this).val());
                });

                // Init check if already selected
                if ($('#scw-4m-type').val()) {
                    window.handleScw4MChange($('#scw-4m-type').val());
                }
            });

            // Submit Handler
            $(document).on('click', '#btn-scw-submit', async function() {
                const $btn = $(this);
                const typeId = $('#scw-4m-type').val();
                const remarkId = $('#scw-remark').val();

                if (!typeId || !remarkId) {
                    showWarningNotification('Pilih Jenis 4M dan Remark terlebih dahulu!');
                    return;
                }

                const originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i>Menyimpan...');

                try {
                    const fd = new FormData();
                    fd.append('machineId', '@Html.Raw(Model.MachineId)');
                    fd.append('scw4MTypeId', typeId);
                    fd.append('scwRemarkId', remarkId);
                    
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    if (token) fd.append('__RequestVerificationToken', token);

                    const res = await fetch('/Operator/Scw', {
                        method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    const json = await res.json();
                    if (json.success) {
                        showSuccessNotification('Data SCW berhasil disimpan');
                        $('#scw-4m-type').val('').trigger('change');
                    } else {
                        showErrorNotification(json.message || 'Gagal menyimpan data');
                    }
                } catch (e) {
                    showErrorNotification('Terjadi kesalahan koneksi');
                } finally {
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        })();
        // ========== END SCW HANDLER ==========
        // ========== END SCW HANDLER ==========
        // ========== END SCW HANDLER ==========
    </script>
    
    <style>
        /* Filter Card Styling */
        #filter-time-display,
        #filter-date {
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        
        #filter-time-display:focus,
        #filter-date:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }
        
        /* Live timer styling */
        #filter-time-display {
            user-select: none;
            cursor: default;
        }

        /* Pulse animation untuk indikator real-time */
        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.5;
            }
        }
        
        /* Action Buttons Horizontal Layout */
        #running-form,
        #rest-form {
            margin: 0;
        }
        
        /* Samakan ukuran & alignment semua tombol Machine Actions */
        .machine-action-btn {
            display: flex;
            align-items: center;
