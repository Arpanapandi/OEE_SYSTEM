                    showWarningNotification('Silakan pilih Group Injection terlebih dahulu di bagian "Man Power & Injection"');
                } else {
                    alert('Silakan pilih Group Injection terlebih dahulu!');
                }
                
                // Scroll ke bagian injection group
                const injectionGroup = document.getElementById('injection-group');
                if (injectionGroup) {
                    injectionGroup.scrollIntoView({ 
                        behavior: 'smooth', 
                        block: 'center',
                        inline: 'nearest'
                    });
                    
                    // Highlight
                    injectionGroup.style.transition = 'box-shadow 0.3s ease';
                    injectionGroup.style.boxShadow = '0 0 20px rgba(255, 193, 7, 0.5)';
                    setTimeout(() => { if (injectionGroup) injectionGroup.style.boxShadow = ''; }, 3000);
                }
                
                console.warn('❌ Form Add Quantity dihentikan: Group Injection belum dipilih');
                return false; // Hentikan submit
            }
            
            // Group Injection sudah dipilih - set nilai ke hidden input
            if (hiddenInjectionInput) {
                hiddenInjectionInput.value = injectionRadio.value;
                console.log('✅ Group Injection diambil dari card "Man Power & Injection":', injectionRadio.value);
            }
            
            return true; // Lanjutkan submit
        };
        
        // ========== SCANNER FUNCTIONALITY (QUAGGA2 + HTML5-QRCODE) ==========
        let quaggaInitialized = false;
        let html5QrCode = null; // Untuk QR code
        let currentScanTarget = null; // 'part-number' or 'lot-number'
        let scannerLibraryLoaded = false;
        let qrCodeLibraryLoaded = false;
        let availableCameras = [];
        let currentCameraId = null;
        let cameraIndex = 0;
        let lastScannedCode = null; // Untuk mencegah scan duplikat
        let scanCooldown = false; // Cooldown untuk mencegah scan terlalu cepat
        let scanMode = 'auto'; // 'auto', 'barcode', 'qrcode'
        
        // ✅ PERBAIKAN: Load Quagga2 library (untuk barcode)
        function loadScannerLibrary() {
            return new Promise((resolve, reject) => {
                if (typeof Quagga !== 'undefined') {
                    scannerLibraryLoaded = true;
                    resolve();
                    return;
                }
                
                // Load Quagga2 CSS
                const link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = 'https://unpkg.com/quagga@0.12.1/dist/quagga.min.css';
                document.head.appendChild(link);
                
                // Load Quagga2 JS
                const script = document.createElement('script');
                script.src = 'https://unpkg.com/quagga@0.12.1/dist/quagga.min.js';
                script.async = true;
                script.onload = () => {
                    scannerLibraryLoaded = true;
                    console.log('✅ Quagga2 library loaded');
                    resolve();
                };
                script.onerror = () => {
                    console.error('❌ Failed to load Quagga2 library');
                    reject(new Error('Failed to load Quagga2 library'));
                };
                document.head.appendChild(script);
            });
        }
        
        // ✅ PERBAIKAN: Load html5-qrcode library (untuk QR code)
        function loadQrCodeLibrary() {
            return new Promise((resolve, reject) => {
                if (typeof Html5Qrcode !== 'undefined') {
                    qrCodeLibraryLoaded = true;
                    resolve();
                    return;
                }
                
                const script = document.createElement('script');
                script.src = 'https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js';
                script.async = true;
                script.onload = () => {
                    qrCodeLibraryLoaded = true;
                    console.log('✅ html5-qrcode library loaded');
                    resolve();
                };
                script.onerror = () => {
                    console.error('❌ Failed to load html5-qrcode library');
                    reject(new Error('Failed to load html5-qrcode library'));
                };
                document.head.appendChild(script);
            });
        }
        
        // Initialize scanner functionality
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🔧 Initializing scanner event listeners...');
            try {
                // Nomor Lot Scan Button
                const btnScanNomorLot = document.getElementById('btn-scan-nomor-lot');
                console.log('📍 btn-scan-nomor-lot found:', !!btnScanNomorLot);
                if (btnScanNomorLot) {
                    btnScanNomorLot.addEventListener('click', function(e) {
                        console.log('🖱️ Scan Nomor Lot button clicked!');
                        e.preventDefault();
                        currentScanTarget = 'nomor-lot';
                        openScanner();
                    });
                    console.log('✅ Event listener attached to btn-scan-nomor-lot');
                } else {
                    console.error('❌ btn-scan-nomor-lot not found in DOM!');
                }

                // Lot Bo Scan Button
                const btnScanLotBo = document.getElementById('btn-scan-lot-bo');
                console.log('📍 btn-scan-lot-bo found:', !!btnScanLotBo);
                if (btnScanLotBo) {
                    btnScanLotBo.addEventListener('click', function(e) {
                        console.log('🖱️ Scan Lot BO button clicked!');
                        e.preventDefault();
                        currentScanTarget = 'lot-bo';
                        openScanner();
                    });
                    console.log('✅ Event listener attached to btn-scan-lot-bo');
                } else {
                    console.error('❌ btn-scan-lot-bo not found in DOM!');
                }

                // Nama Compound Scan Button
                const btnScanNamaCompound = document.getElementById('btn-scan-nama-compound');
                console.log('📍 btn-scan-nama-compound found:', !!btnScanNamaCompound);
                if (btnScanNamaCompound) {
                    btnScanNamaCompound.addEventListener('click', function(e) {
                        console.log('🖱️ Scan Nama Compound button clicked!');
                        e.preventDefault();
                        currentScanTarget = 'nama-compound';
                        openScanner();
                    });
                    console.log('✅ Event listener attached to btn-scan-nama-compound');
                } else {
                    console.error('❌ btn-scan-nama-compound not found in DOM!');
                }

                // Edit Buttons
                const editMappings = {
                    'btn-edit-nomor-lot': 'input-nomor-lot',
                    'btn-edit-lot-bo': 'input-lot-bo',
                    'btn-edit-nama-compound': 'input-nama-compound'
                };

                Object.keys(editMappings).forEach(btnId => {
                    const btn = document.getElementById(btnId);
                    if (btn) {
                        btn.addEventListener('click', function() {
                            const input = document.getElementById(editMappings[btnId]);
                            if (input) {
                                input.disabled = false;
                                input.focus();
                                input.select();
                            }
                        });
                    }
                });

                // Stop Scanner Button
                const btnStopScanner = document.getElementById('btn-stop-scanner');
                if (btnStopScanner) {
                    btnStopScanner.addEventListener('click', function() {
                        stopScanner();
                    });
                }

                // Close modal and stop scanner
                const scannerModal = document.getElementById('scannerModal');
                if (scannerModal) {
                    scannerModal.addEventListener('hidden.bs.modal', function() {
                        stopScanner();
                        const backdrop = document.getElementById('scannerModalBackdrop');
                        if (backdrop) backdrop.remove();
                    });

                    const closeButtons = scannerModal.querySelectorAll('[data-bs-dismiss="modal"], .btn-close');
                    closeButtons.forEach(btn => {
                        btn.addEventListener('click', function() {
                            const backdrop = document.getElementById('scannerModalBackdrop');
                            if (backdrop) {
                                scannerModal.classList.remove('show');
                                scannerModal.style.display = 'none';
                                scannerModal.setAttribute('aria-hidden', 'true');
                                document.body.classList.remove('modal-open');
                                backdrop.remove();
                                stopScanner();
                            }
                        });
                    });
                }
            } catch (error) {
                console.error('Error initializing scanner functionality:', error);
            }
        });
        
        window.openScanner = async function() {
            console.log('🔧 openScanner called, target:', currentScanTarget);
            
            const scannerModalEl = document.getElementById('scannerModal');
            if (!scannerModalEl) {
                console.error('❌ Scanner modal element not found!');
                if (typeof showToast === 'function') {
                    showToast('Error: Scanner modal tidak ditemukan', 'error');
                } else {
                    alert('Error: Scanner modal tidak ditemukan. Silakan refresh halaman.');
                }
                return;
            }
            console.log('✅ Scanner modal element found');

            // ✅ PERBAIKAN: Hapus backdrop lama jika ada
            const oldBackdrop = document.querySelector('.modal-backdrop');
            if (oldBackdrop) {
                oldBackdrop.remove();
                console.log('✅ Old backdrop removed');
            }
            
            // ✅ PERBAIKAN: Reset modal state
            scannerModalEl.classList.remove('show');
            scannerModalEl.style.display = 'none';
            document.body.classList.remove('modal-open');

            // Update modal title context
            const targetLabel = document.getElementById('scanner-target-label');
            if (targetLabel) {
                if (currentScanTarget === 'lot-bo') targetLabel.textContent = 'Lot BO';
                else if (currentScanTarget === 'nomor-lot') targetLabel.textContent = 'Nomor Lot';
                else if (currentScanTarget === 'nama-compound') targetLabel.textContent = 'Nama Compound';
                else targetLabel.textContent = 'Barcode/QR Code';
            }
            
            // Verifikasi Bootstrap
            if (typeof bootstrap === 'undefined') {
                console.error('❌ Bootstrap is not defined!');
                if (typeof showToast === 'function') {
                    showToast('Error: Bootstrap library tidak dimuat', 'error');
                } else {
                    alert('Error: Bootstrap library tidak dimuat. Silakan refresh halaman.');
                }
                return;
            }
            console.log('✅ Bootstrap library available');
            
            // ✅ PERBAIKAN: Stop semua scanner yang sudah ada SEBELUM buka modal
            if (quaggaInitialized && typeof Quagga !== 'undefined') {
                try {
                    console.log('🛑 Stopping existing Quagga2 scanner...');
                    Quagga.stop();
                    Quagga.offDetected();
                    quaggaInitialized = false;
                    console.log('✅ Existing Quagga2 scanner stopped');
                } catch (err) {
                    console.warn('⚠️ Warning stopping Quagga2 scanner:', err);
                    quaggaInitialized = false;
                }
            }
            
            if (html5QrCode && typeof Html5Qrcode !== 'undefined') {
                try {
                    console.log('🛑 Stopping existing html5-qrcode scanner...');
                    await html5QrCode.stop();
                    html5QrCode.clear();
                    html5QrCode = null;
                    console.log('✅ Existing html5-qrcode scanner stopped');
                } catch (err) {
                    console.warn('⚠️ Warning stopping html5-qrcode scanner:', err);
                    html5QrCode = null;
                }
            }
            
            // Reset scanner container
            const scannerReader = document.getElementById('scanner-reader');
            if (scannerReader) {
                scannerReader.innerHTML = `
                    <canvas id="scanner-canvas" style="display: none;"></canvas>
                    <video id="scanner-video" style="width: 100%; height: auto; display: block;"></video>
                    <div id="scanner-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;"></div>
                `;
            }
            
            // ✅ PERBAIKAN: Load kedua library
            if (!scannerLibraryLoaded) {
                console.log('📚 Loading Quagga2 library (barcode)...');
                try {
                    await loadScannerLibrary();
                    console.log('✅ Quagga2 library loaded');
                } catch (error) {
                    console.error('❌ Failed to load Quagga2 library:', error);
                }
            }
            
            if (!qrCodeLibraryLoaded) {
                console.log('📚 Loading html5-qrcode library (QR code)...');
                try {
                    await loadQrCodeLibrary();
                    console.log('✅ html5-qrcode library loaded');
                } catch (error) {
                    console.error('❌ Failed to load html5-qrcode library:', error);
                }
            }
            
            // Check if at least one library is available
            if (typeof Quagga === 'undefined' && typeof Html5Qrcode === 'undefined') {
                console.error('❌ Both scanner libraries are undefined');
                if (typeof showToast === 'function') {
                    showToast('Scanner library gagal dimuat. Silakan refresh halaman.', 'error');
                } else {
                    alert('Scanner library belum dimuat. Silakan refresh halaman.');
                }
                return;
            }
            
            console.log('✅ Scanner libraries available:', {
                quagga: typeof Quagga !== 'undefined',
                html5qrcode: typeof Html5Qrcode !== 'undefined'
            });
            
            // ✅ PERBAIKAN: Initialize scanner function dengan explicit camera permission
            const initializeScanner = async () => {
                try {
                    console.log('🔧 Initializing scanner...');
                    
                    // ✅ VALIDATION: Check browser support
                    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                        if (typeof showToast === 'function') {
                            showToast('Browser tidak mendukung akses kamera', 'error');
                        } else {
                            alert('Browser tidak mendukung akses kamera. Pastikan menggunakan HTTPS atau localhost.');
                        }
                        stopScanner();
                        const modalInstance = bootstrap.Modal.getInstance(scannerModalEl);
                        if (modalInstance) modalInstance.hide();
                        return;
                    }
                    
                    // ✅ VALIDATION: Check HTTPS/localhost
                    const isSecure = window.location.protocol === 'https:' || 
                                    window.location.hostname === 'localhost' || 
                                    window.location.hostname === '127.0.0.1';
                    
                    if (!isSecure) {
                        if (typeof showToast === 'function') {
                            showToast('Akses kamera memerlukan HTTPS atau localhost', 'error');
                        } else {
                            alert('⚠️ Akses kamera memerlukan HTTPS atau localhost.');
                        }
                        stopScanner();
                        const modalInstance = bootstrap.Modal.getInstance(scannerModalEl);
                        if (modalInstance) modalInstance.hide();
                        return;
                    }
                    
                    // ✅ PERBAIKAN: Request camera permission explicitly
                    try {
                        console.log('📷 Requesting camera permission...');
                        const stream = await navigator.mediaDevices.getUserMedia({ 
                            video: { facingMode: 'environment' } 
                        });
                        
                        // Stop stream immediately (we just need permission)
                        stream.getTracks().forEach(track => track.stop());
                        console.log('✅ Camera permission granted');
                        
                    } catch (permErr) {
                        console.error('❌ Camera permission denied:', permErr);
                        if (typeof showToast === 'function') {
                            showToast('Akses kamera ditolak. Silakan izinkan akses kamera.', 'error');
                        } else {
                            alert('Akses kamera ditolak. Silakan izinkan akses kamera.');
                        }
                        
                        // Close modal
                        const modalInstance = bootstrap.Modal.getInstance(scannerModalEl);
                        if (modalInstance) modalInstance.hide();
                        return;
                    }
                    
                    // ✅ PERBAIKAN: List semua camera yang tersedia
                    const devices = await navigator.mediaDevices.enumerateDevices();
                    availableCameras = devices.filter(device => device.kind === 'videoinput');
                    console.log('📷 Available cameras:', availableCameras.length);
                    
                    // Cari back camera (environment)
                    let selectedCameraId = null;
                    if (availableCameras.length > 1) {
                        const backCamera = availableCameras.find(cam => 
                            cam.label.toLowerCase().includes('back') || 
                            cam.label.toLowerCase().includes('rear') ||
                            cam.label.toLowerCase().includes('environment')
                        );
                        
                        if (backCamera) {
                            selectedCameraId = backCamera.deviceId;
                            console.log('✅ Found back camera:', backCamera.label);
                        } else {
                            selectedCameraId = availableCameras[1].deviceId;
                            console.log('⚠️ Using camera index 1 (likely back camera)');
                        }
                        
                        // Tampilkan tombol switch camera
                        const btnSwitchCamera = document.getElementById('btn-switch-camera');
                        if (btnSwitchCamera && availableCameras.length > 1) {
                            btnSwitchCamera.style.display = 'inline-block';
                            btnSwitchCamera.onclick = function() {
                                switchCamera();
                            };
                        }
                    } else if (availableCameras.length === 1) {
                        selectedCameraId = availableCameras[0].deviceId;
                    }
                    
                    currentCameraId = selectedCameraId;
                    cameraIndex = selectedCameraId ? availableCameras.findIndex(c => c.deviceId === selectedCameraId) : 0;
                    
                    // ✅ Start scanner
                    await startScanning();
                    
                } catch (err) {
                    console.error('❌ Error initializing scanner:', err);
                    if (typeof showToast === 'function') {
                        showToast('Error: ' + err.message, 'error');
                    } else {
                        alert('Error: ' + err.message);
                    }
                }
            };
            
            // ✅ ULTIMATE SCANNER WATERFALL
            async function startScanning() {
                const scannerReader = document.getElementById('scanner-reader');
                if (!scannerReader) return;
                
                const scannerContainer = document.getElementById('scanner-container');
                const containerWidth = scannerContainer ? scannerContainer.offsetWidth : 640;
                const containerHeight = scannerContainer ? scannerContainer.offsetHeight : 480;
                const qrboxWidth = Math.max(250, Math.min(containerWidth * 0.7, 300));
                const qrboxHeight = qrboxWidth;

                // 1. Try html5-qrcode as primary (supports QR + Barcode)
                if (typeof Html5Qrcode !== 'undefined') {
                    try {
                        console.log('🔧 Starting html5-qrcode...');
                        html5QrCode = new Html5Qrcode("scanner-reader");
                        const cameraConfig = currentCameraId ? { deviceId: { exact: currentCameraId } } : { facingMode: "environment" };
                        
                        await html5QrCode.start(
                            cameraConfig,
                            {
                                fps: 10,
                                qrbox: { width: qrboxWidth, height: qrboxHeight },
                                aspectRatio: 1.0,
                                formatsToSupport: [
                                    Html5QrcodeSupportedFormats.QR_CODE,
                                    Html5QrcodeSupportedFormats.CODE_128,
                                    Html5QrcodeSupportedFormats.CODE_39
                                ]
                            },
                            (text) => {
                                if (!scanCooldown) {
                                    console.log('✅ Scan Result:', text);
                                    handleScanSuccess(text);
                                }
                            }
                        );
                        console.log('✅ html5-qrcode started');
                        return; 
                    } catch (err) {
                        console.warn('⚠️ html5-qrcode failed, trying Quagga2...', err);
                        if (html5QrCode) {
                            try { await html5QrCode.stop(); } catch(e){}
                            html5QrCode = null;
                        }
                    }
                }

                // 2. Try Quagga2 as fallback
                if (typeof Quagga !== 'undefined') {
                    try {
                        console.log('🔧 Starting Quagga2...');
                        scannerReader.innerHTML = '<div id="quagga-reader" style="width:100%;height:100%;"></div>';
                        
                        Quagga.init({
                            inputStream: {
                                name: "Live", type: "LiveStream",
                                target: document.querySelector('#quagga-reader'),
                                constraints: {
                                    width: containerWidth, height: containerHeight,
                                    facingMode: "environment",
                                    deviceId: currentCameraId ? { exact: currentCameraId } : undefined
                                }
                            },
                            decoder: { readers: ["code_128_reader", "code_39_reader", "ean_reader"] }
                        }, function(err) {
                            if (err) {
                                console.error('❌ Quagga2 init failed:', err);
                                return;
                            }
                            Quagga.start();
                            quaggaInitialized = true;
                            Quagga.onDetected((res) => {
                                if (!scanCooldown && res.codeResult.code) {
                                    handleScanSuccess(res.codeResult.code);
                                }
                            });
                        });
                    } catch (err) {
                        console.error('❌ Quagga2 failed:', err);
                    }
                }
            }

            // ✅ PERBAIKAN: Buka modal dengan Bootstrap
            try {
                let modalInstance = bootstrap.Modal.getInstance(scannerModalEl);
                if (modalInstance) {
                    modalInstance.dispose(); // Hapus instance lama
                }
                
                modalInstance = new bootstrap.Modal(scannerModalEl, {
                    backdrop: 'static',
                    keyboard: true
                });
                
                // ✅ CRITICAL: Initialize scanner SETELAH modal shown
                scannerModalEl.addEventListener('shown.bs.modal', async function() {
                    console.log('✅ Modal shown, initializing scanner...');
                    await initializeScanner();
                }, { once: true });
                
                modalInstance.show();
                console.log('✅ Modal opened successfully');
                
            } catch (err) {
                console.error('❌ Error opening modal:', err);
                if (typeof showToast === 'function') {
                    showToast('Gagal membuka scanner: ' + err.message, 'error');
                } else {
                    alert('Gagal membuka modal scanner: ' + err.message);
                }
            }
        };
            
        // ✅ PERBAIKAN: Function untuk switch camera
        window.switchCamera = async function() {
            if (availableCameras.length <= 1) {
                alert('Hanya ada satu camera yang tersedia.');
                return;
            }
                
                try {
                    // Stop Quagga2 scanner
                    Quagga.stop();
                    Quagga.offDetected();
                    quaggaInitialized = false;
                    
                    // Switch ke camera berikutnya
                    cameraIndex = (cameraIndex + 1) % availableCameras.length;
                    const nextCamera = availableCameras[cameraIndex];
                    currentCameraId = nextCamera.deviceId;
                    
                    console.log(`🔄 Switching to camera ${cameraIndex + 1}/${availableCameras.length}:`, nextCamera.label);
                    
                    // Restart Quagga2 dengan camera baru
                    const scannerContainer = document.getElementById('scanner-container');
                    const containerWidth = scannerContainer ? scannerContainer.offsetWidth : 640;
                    const containerHeight = scannerContainer ? scannerContainer.offsetHeight : 480;
                    
                    Quagga.init({
                        inputStream: {
                            name: "Live",
                            type: "LiveStream",
                            target: document.querySelector('#scanner-reader'),
                            constraints: {
                                width: containerWidth,
                                height: containerHeight,
                                deviceId: { exact: currentCameraId }
                            }
                        },
                        locator: {
                            patchSize: "medium",
                            halfSample: true
                        },
                        numOfWorkers: 2,
                        decoder: {
                            readers: [
                                "code_128_reader",
                                "ean_reader",
                                "ean_8_reader",
                                "code_39_reader",
                                "code_39_vin_reader",
                                "codabar_reader",
                                "upc_reader",
                                "upc_e_reader",
                                "i2of5_reader"
                            ]
                        },
                        locate: true
                    }, function(err) {
                        if (err) {
                            console.error('❌ Error restarting Quagga2:', err);
                            alert('Gagal switch camera: ' + (err.message || err));
                            return;
                        }
                        
                        quaggaInitialized = true;
                        Quagga.start();
                        
                        Quagga.onDetected(function(result) {
                            if (scanCooldown) return;
                            if (result.codeResult && result.codeResult.code) {
                                handleScanSuccess(result.codeResult.code);
                            }
                        });
                        
                        console.log('✅ Camera switched successfully');
                    });
                } catch (err) {
                    console.error('❌ Error switching camera:', err);
                    alert('Gagal switch camera: ' + (err.message || err));
                }
            };
        }
        
        async function handleScanSuccess(decodedText) {
            if (!decodedText) return;
            decodedText = decodedText.trim();

            console.log('✅ Scan successful:', decodedText, 'Target:', currentScanTarget);

            // ✅ VALIDATION: Maksimal 12 karakter untuk Lot & Part Number
            if (currentScanTarget === 'lot-bo' || currentScanTarget === 'nomor-lot') {
                if (decodedText.length > 12) {
                    console.warn('Scanned code too long:', decodedText);
                    if (typeof showToast === 'function') {
                        showToast(`Code terlalu panjang (max 12 karakter): ${decodedText}`, 'error');
                    } else {
                        alert(`Code tidak sesuai! (${decodedText})\nMaksimal 12 karakter.`);
                    }
                    return;
                }
            }

            // ✅ DUMMY MODE: Bypass validasi untuk testing
            const USE_DUMMY_VALIDATION = false; // Set ke false untuk menggunakan API real
            
            // ✅ PERBAIKAN: Validasi Lot BO (Part Number) ke database jika target adalah lot-bo
            if (currentScanTarget === 'lot-bo' && !USE_DUMMY_VALIDATION) {
                try {
                    const validateResponse = await fetch(`/api/Scanner/komponen/validate/${encodeURIComponent(decodedText.trim())}`);
                    const validateResult = await validateResponse.json();
                    
                    if (!validateResult.success) {
                        if (typeof showToast === 'function') {
                            showToast('Lot BO tidak ditemukan di database: ' + decodedText, 'error');
                        } else {
                            alert('Lot BO tidak ditemukan di database: ' + decodedText + '\n\n' + (validateResult.message || ''));
                        }
                        return;
                    }
                } catch (err) {
                    console.error('❌ Error validating Lot BO:', err);
                    if (typeof showToast === 'function') {
                        showToast('Error saat validasi Lot BO. Silakan coba lagi.', 'error');
                    } else {
                        alert('Error saat validasi Lot BO. Silakan coba lagi.');
                    }
                    return;
                }
            }
            
            // ✅ Stop scanner
            stopScanner();
            
            // ✅ Close modal
            const scannerModalEl = document.getElementById('scannerModal');
            if (scannerModalEl) {
                const modalInstance = bootstrap.Modal.getInstance(scannerModalEl);
                if (modalInstance) modalInstance.hide();
                
                // Manual hide fallback
                scannerModalEl.classList.remove('show');
                scannerModalEl.style.display = 'none';
                document.body.classList.remove('modal-open');
                
                // Remove backdrop
                const backdrop = document.querySelector('.modal-backdrop');
                if (backdrop) backdrop.remove();
            }
            
            // ✅ PERBAIKAN: Fill input field based on target
            let inputId;
            let fieldName;
            
            if (currentScanTarget === 'lot-bo') {
                inputId = 'input-lot-bo';
                fieldName = 'Lot BO';
            } else if (currentScanTarget === 'nomor-lot') {
                inputId = 'input-nomor-lot';
                fieldName = 'Nomor Lot';
            } else if (currentScanTarget === 'nama-compound') {
                inputId = 'input-nama-compound';
                fieldName = 'Nama Compound';
            } else if (currentScanTarget === 'berat-act') {
                inputId = 'input-berat-act';
                fieldName = 'Berat Act';
            }
            
            if (inputId) {
                const input = document.getElementById(inputId);
                if (input) {
                    // ✅ CRITICAL: Enable input first
                    input.disabled = false;
                    input.readOnly = false;
                    
                    // ✅ Set value
                    if (currentScanTarget === 'berat-act') {
                        const scannedValue = parseFloat(decodedText);
                        if (!isNaN(scannedValue) && scannedValue >= 0) {
                            input.value = scannedValue.toFixed(2);
                        } else {
                            if (typeof showToast === 'function') {
                                showToast('Berat Act tidak valid: ' + decodedText, 'error');
                            } else {
                                alert('Berat Act tidak valid: ' + decodedText);
                            }
                            return;
                        }
                    } else {
                        input.value = decodedText;
                    }
                    
                    // ✅ Trigger events
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                    input.dispatchEvent(new Event('change', { bubbles: true }));
                    
                    // ✅ Visual feedback
                    input.classList.add('border-success');
                    setTimeout(() => {
                        input.classList.remove('border-success');
                    }, 2000);
                    
                    console.log('✅ Input field filled:', inputId, '=', input.value);
                    
                    // ✅ Show success toast
                    if (typeof showToast === 'function') {
                        showToast(`✅ Scan berhasil: ${fieldName} = ${input.value}`, 'success');
                    }
                    
                    // ✅ Trigger komponen load if needed
                    if (currentScanTarget === 'lot-bo' || currentScanTarget === 'nomor-lot') {
                        setTimeout(() => {
                            if (typeof checkAndLoadKomponen === 'function') {
                                checkAndLoadKomponen();
                            }
                        }, 500);
                    }
                    
                    // ✅ Trigger completeness check
                    if (typeof checkAllInputsComplete === 'function') {
                        setTimeout(() => {
                            checkAllInputsComplete();
                        }, 600);
                    }
                    
                } else {
                    console.error('❌ Input field not found:', inputId);
                    if (typeof showToast === 'function') {
                        showToast('Error: Input field tidak ditemukan', 'error');
                    } else {
                        alert('Error: Input field tidak ditemukan');
                    }
                }
            }
        }
        
