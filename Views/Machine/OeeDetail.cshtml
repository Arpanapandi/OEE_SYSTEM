                }
                
                try {
                    // Stop Quagga2 scanner
                    Quagga.stop();
                    Quagga.offDetected();
                    quaggaInitialized = false;
                    
                    // Switch ke camera berikutnya
                    cameraIndex = (cameraIndex + 1) % availableCameras.length;
                    const nextCamera = availableCameras[cameraIndex];
                    currentCameraId = nextCamera.deviceId;
                    
                    console.log(`🔄 Switching to camera ${cameraIndex + 1}/${availableCameras.length}:`, nextCamera.label);
                    
                    // Restart Quagga2 dengan camera baru
                    const scannerContainer = document.getElementById('scanner-container');
                    const containerWidth = scannerContainer ? scannerContainer.offsetWidth : 640;
                    const containerHeight = scannerContainer ? scannerContainer.offsetHeight : 480;
                    
                    Quagga.init({
                        inputStream: {
                            name: "Live",
                            type: "LiveStream",
