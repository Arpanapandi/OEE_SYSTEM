    <!-- EMERGENCY SCRIPT BLOCK: FINAL GLOBAL FIX -->
    <!-- ========================================== -->
    <script>
        console.log('🚨 LANDING EMERGENCY SCRIPT BLOCK...');
        
        // --- 1. STANDALONE TIMER LOGIC ---
        window.finalTimerInt = null;
        window.finalTimerStart = null;

        // --- 0. UTILITY RESTORATION (Fix ReferenceErrors) ---
        window.validateGroupInjection = function() {
            const mp = document.getElementById('select-man-power')?.value;
            const inj = document.querySelector('#injection-group input[name="injection"]:checked')?.value;
            if(!mp || !inj) {
                alert('⚠️ Harap pilih Man Power dan Group Injection terlebih dahulu!');
                return false;
            }
            return true;
        };

        window.validateWorkflow = function() {
            const errs = [];
            if(!document.getElementById('select-man-power')?.value) errs.push("Man Power belum terpilih");
            if(!document.querySelector('#injection-group input[name="injection"]:checked')) errs.push("Group Injection belum terpilih");
            if(!document.getElementById('input-nomor-lot')?.value && !document.getElementById('input-lot-bo')?.value) errs.push("Nomor Lot or Lot BO must be filled");
            return errs;
        };

        window.updateProductionDataWithQty = function(good, reject, duration) {
            console.log('📦 Updating Production Data:', { good, reject, duration });
            const currentData = JSON.parse(localStorage.getItem('currentProductionData') || '{}');
            currentData.goodQty = good;
            currentData.rejectQty = reject;
            currentData.durationSeconds = duration;
            localStorage.setItem('currentProductionData', JSON.stringify(currentData));
        };

        window.stopDurasiProduksi = function() {
            // Map to our final timer logic
            window.resetTimerFinal();
            console.log('⏱️ Timer Stopped (stopDurasiProduksi)');
        };

        // Variable mapping
        Object.defineProperty(window, 'durasiProduksiSeconds', {
            get: function() { 
                return parseInt(document.getElementById('hidden-durasi-seconds')?.value) || 0; 
            }
        });
        
        window.updateTimerUI = function() {
            if (!window.finalTimerStart) {
                const el = document.getElementById('durasi-produksi-display');
                if(el) el.value = "00:00:00";
                return;
            }
            
            const now = new Date();
            const diff = Math.floor((now - window.finalTimerStart) / 1000);
            
            const h = Math.floor(diff / 3600).toString().padStart(2, '0');
            const m = Math.floor((diff % 3600) / 60).toString().padStart(2, '0');
            const s = (diff % 60).toString().padStart(2, '0');
            
            const el = document.getElementById('durasi-produksi-display');
            if(el) el.value = `${h}:${m}:${s}`;
            
            const hidden = document.getElementById('hidden-durasi-seconds');
            if(hidden) hidden.value = diff;
        };
        
        window.runTimerFinal = function() {
            // Check resume
            const stored = localStorage.getItem('finalKeyStart');
            if(stored) {
                window.finalTimerStart = new Date(stored);
            } else {
                window.finalTimerStart = new Date();
                localStorage.setItem('finalKeyStart', window.finalTimerStart.toISOString());
            }
            
            if(window.finalTimerInt) clearInterval(window.finalTimerInt);
            window.finalTimerInt = setInterval(window.updateTimerUI, 1000);
            window.updateTimerUI();
            
            const st = document.getElementById('timer-status-text');
            if(st) {
                st.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Running';
                st.className = 'small text-primary mt-1 fw-bold';
            }
        };
        
        window.resetTimerFinal = function(e) {
            if(e) e.preventDefault();
            
            if(window.finalTimerInt) clearInterval(window.finalTimerInt);
            window.finalTimerInt = null;
            window.finalTimerStart = null;
            localStorage.removeItem('finalKeyStart');
            
            const el = document.getElementById('durasi-produksi-display');
            if(el) el.value = "00:00:00";
            document.getElementById('hidden-durasi-seconds').value = 0;
            
            const st = document.getElementById('timer-status-text');
            if(st) {
                 st.innerHTML = '<i class="fa-solid fa-stop-circle me-1"></i>Stopped';
                 st.className = 'small text-danger mt-1 fw-bold';
            }
        };
        
        // Auto start on load -> DISABLED per User Request (Default 00:00:00)
        // window.runTimerFinal(); 
        
        // Cek status timer hanya jika benar-benar perlu (opsional: bisa diaktifkan jika ingin resume persistensi)
        // Saat ini default: Mati.
        
        
        // --- 2. STANDALONE SUBMIT LOGIC ---
        window.submitProduksiFinal = async function(e) {
            if(e) {
                e.preventDefault();
                e.stopPropagation();
            }
            console.log('🚀 FINAL SUBMIT TRIGGERED');
            
            // Basic Validation Check
            const errs = [];
            const mp = document.getElementById('select-man-power')?.value;
            const inj = document.querySelector('#injection-group input[name="injection"]:checked')?.value;
            const lot = document.getElementById('input-nomor-lot')?.value;
            const bo = document.getElementById('input-lot-bo')?.value;
            const brat = document.getElementById('input-berat-act')?.value;
            // const nipis = document.querySelector('#penipisan-group input[name="penipisan"]:checked')?.value; // Optional?
            
            if(!mp) errs.push("Man Power");
            if(!inj) errs.push("Group Injection");
            if(!lot && !bo) errs.push("Nomor Lot / Lot BO"); // Minimal salah satu
            if(!brat) errs.push("Berat Act");
            
            if(errs.length > 0) {
                alert('⚠️ Data belum lengkap: ' + errs.join(', '));
                return;
            }
            
            const btn = document.getElementById('btn-submit-produksi');
            const originalHtml = btn ? btn.innerHTML : 'Submit';
            
            try {
                if(btn) {
                    btn.disabled = true;
                    btn.innerHTML = 'Sending...';
                }
                
                // Construct Data Robustly
                const fd = new FormData();
                fd.append('machineId', '@Html.Raw(Model.MachineId)');
                fd.append('manPowerId', mp);
                fd.append('injection', inj);
                fd.append('nomorLot', lot || '');
                fd.append('lotBo', bo || '');
                fd.append('namaCompound', document.getElementById('input-nama-compound')?.value || '');
                fd.append('beratAct', parseFloat(brat) || 0); // Ensure number
                fd.append('penipisan', document.querySelector('#penipisan-group input[name="penipisan"]:checked')?.value || '');
                fd.append('keterangan', document.getElementById('select-keterangan')?.value || '');
                fd.append('durasiProduksiSeconds', parseInt(document.getElementById('hidden-durasi-seconds')?.value) || 0);
                fd.append('qty', 1);
                
                // Komponen Logic (Try selected variable, fallback to dropdown value)
                let kId = null;
                if(typeof selectedKomponenId !== 'undefined' && selectedKomponenId) kId = selectedKomponenId;
                else {
                    const kVal = document.getElementById('select-komponen')?.value;
                    if(kVal) kId = kVal;
                }
                if(kId) fd.append('komponenId', kId);
                
                // Token
                const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if(tok) fd.append('__RequestVerificationToken', tok);
                
                console.log('📤 Submitting Payload...');

                // Fetch with forced ajax query param
                const resp = await fetch('/Operator/SubmitProductionData?ajax=1', {
                    method: 'POST',
                    body: fd
                });
                
                // Handle non-JSON response (e.g. 500 error page)
                const contentType = resp.headers.get("content-type");
                if (!contentType || !contentType.includes("application/json")) {
                    const text = await resp.text();
                    console.error("Server Error (Non-JSON):", text);
                    alert('SERVER ERROR: Terjadi kesalahan di server. Cek console.');
                    throw new Error("Server returned non-JSON");
                }

                const res = await resp.json();
                
                if(res.success) {
                    alert('✅ Data berhasil di simpan'); // User Request
                    if(typeof showToast === 'function') showToast('✅ Success', 'success');
                    
                    // Reset Form Partial (CORRECTED LOGIC)
                    // Requirement: Reset all input input produksi, KEEP Man Power & Injection
                    
                    // 1. Text Inputs
                    if(document.getElementById('input-nomor-lot')) document.getElementById('input-nomor-lot').value = '';
                    if(document.getElementById('input-lot-bo')) document.getElementById('input-lot-bo').value = '';
                    if(document.getElementById('input-nama-compound')) document.getElementById('input-nama-compound').value = '';
                    if(document.getElementById('input-berat-act')) document.getElementById('input-berat-act').value = '';
                    
                    // 2. Dropdown Keterangan
                    const selKet = document.getElementById('select-keterangan');
                    if(selKet) selKet.value = '';
                    
                    // 3. Radio Buttons Penipisan (Uncheck All)
                    document.querySelectorAll('#penipisan-group input[name="penipisan"]').forEach(r => r.checked = false);
                    
                    // 4. Komponen Selection
                    if(typeof selectedKomponenId !== 'undefined') selectedKomponenId = null;
                    const selKomp = document.getElementById('select-komponen');
                    if(selKomp) selKomp.value = '';
                    
                    // 5. Hidden Fields
                    const hiddens = ['hidden-lot-bo', 'hidden-nomor-lot', 'hidden-nama-compound', 'hidden-berat-act', 'hidden-penipisan', 'hidden-keterangan', 'hidden-komponen-id'];
                    hiddens.forEach(id => {
                        const h = document.getElementById(id);
                        if(h) h.value = '';
                    });
                    
                    // --- WORKFLOW BARU: Start Timer SETELAH Submit Berhasil ---
                    // Reset first (00:00:00)
                    localStorage.removeItem('finalKeyStart');
                    // Start Timer for NEXT item
                    window.runTimerFinal();
                    
                    // Trigger Man Power Save
                    if(typeof saveManPowerAndGroup === 'function') saveManPowerAndGroup();
                    
                } else {
                    alert('❌ GAGAL SIMPAN: ' + res.message); // Show Backend Message
                }
                
            } catch(x) {
                console.error(x);
                // Alert only if not already handled
                if(!btn.disabled) alert('❌ Connection Error / Validasi Gagal. Cek inputan.');
            } finally {
                if(btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }
        };

        // --- HELPER: Stop All Timer Intervals ---
        window.stopAllTimers = function() {
            // Clear running timer interval
            if (window.runningTimerInterval) {
                clearInterval(window.runningTimerInterval);
                window.runningTimerInterval = null;
                console.log('✅ Cleared window.runningTimerInterval');
            }
            if (typeof runningTimerInterval !== 'undefined' && runningTimerInterval) {
                clearInterval(runningTimerInterval);
                runningTimerInterval = null;
                console.log('✅ Cleared runningTimerInterval (local)');
            }
            
            // Clear since-last-change interval
            if (window.sinceLastChangeInterval) {
                clearInterval(window.sinceLastChangeInterval);
                window.sinceLastChangeInterval = null;
                console.log('✅ Cleared window.sinceLastChangeInterval');
            }
            if (typeof sinceLastChangeInterval !== 'undefined' && sinceLastChangeInterval) {
                clearInterval(sinceLastChangeInterval);
                sinceLastChangeInterval = null;
                console.log('✅ Cleared sinceLastChangeInterval (local)');
            }
            
            console.log('🧹 All timer intervals cleared');
        };

        // --- 3. MACHINE ACTIONS & REAL-TIME REFRESH ---
        window.refreshAllData = async function() {
            try {
                const resp = await fetch('/Operator/GetOperatorData?machineId=@Html.Raw(Model.MachineId)');
                if(!resp.ok) return;
                const data = await resp.json();
                
                console.log('🔄 Data refreshed:', data);

                // Update KPIs
                const updateKpi = (id, val) => { const el = document.getElementById(id); if(el) el.textContent = val; };
                updateKpi('total-good', data.TotalGood);
                updateKpi('total-reject', data.TotalReject);
                updateKpi('oee-value', Math.round(data.Oee || 0) + '%');
                updateKpi('availability-value', Math.round(data.Availability || 0) + '%');
                updateKpi('performance-value', Math.round(data.Performance || 0) + '%');
                updateKpi('quality-value', Math.round(data.Quality || 0) + '%');

                // Update Time Metrics
                const updateMetric = (id, seconds) => {
                    const el = document.getElementById(id);
                    if(el) {
                        const h = Math.floor(seconds / 3600).toString().padStart(2, '0');
                        const m = Math.floor((seconds % 3600) / 60).toString().padStart(2, '0');
                        const s = Math.floor(seconds % 60).toString().padStart(2, '0');
                        el.textContent = `${h}:${m}:${s}`;
                    }
                };
                
                updateMetric('operating-time', data.OperatingTimeSeconds);
                updateMetric('downtime-total', data.DowntimeTotalSeconds);
                updateMetric('planned-production-time', data.PlannedProductionTimeSeconds);
                
                // Update Recent Downtime Table
                if(data.RecentDowntimes) {
                    window.updateRecentDowntimeTable(data.RecentDowntimes);
                }

                // Update Status UI (Header & Navbar)
                if(typeof window.updateMachineStatusUI === 'function') {
                    window.updateMachineStatusUI(data.MachineStatus === 'Aktif' ? 'Aktif' : 'Downtime', data.ActiveDowntimeDescription || '');
                }

                // Update Timer Baseline and Start Intervals
                if(data.LastStatusChangeTime) {
                    const baseline = new Date(data.LastStatusChangeTime);
                    window.lastChangeTimestamp = baseline;
                    
                    // Determine if machine is running
                    const isRunning = (data.MachineStatus === 'Aktif' && !data.HasActiveDowntime && !data.IsNoLoading);
                    
                    if (isRunning) {
                        window.runningStartTimeUtc = baseline;
                    } else {
                        window.runningStartTimeUtc = null;
                    }
                    
                    // ✅ CRITICAL: Always call updateSinceLastChange to restart intervals
                    if(typeof window.updateSinceLastChange === 'function') {
                        window.updateSinceLastChange(data.SinceLastChangeSeconds || 0, isRunning);
                        console.log('✅ Timer intervals restarted via updateSinceLastChange, isRunning:', isRunning);
                    }
                }

                // Handle No Loading Card Display
                const currentJobCard = document.getElementById('current-job-card') || document.querySelector('.card-body .row.gy-1')?.closest('.card');
                if (currentJobCard) {
                    const isNoLoadingState = data.ActiveDowntimeDescription === 'No Loading' || data.IsNoLoading;
                    if (isNoLoadingState) {
                        currentJobCard.classList.add('opacity-25');
                        currentJobCard.style.pointerEvents = 'none';
                    } else {
                        currentJobCard.classList.remove('opacity-25');
                        currentJobCard.style.pointerEvents = 'auto';
                    }
                }

            } catch(e) { console.error('Refresh error:', e); }
        };

        window.updateRecentDowntimeTable = function(list) {
            const tbody = document.getElementById('recent-downtime-tbody');
            if(!tbody) return;
            
            tbody.innerHTML = '';
            list.forEach(dt => {
                const tr = document.createElement('tr');
                const start = new Date(dt.StartTime);
                const startStr = (start.getMonth()+1).toString().padStart(2,'0') + '/' + start.getDate().toString().padStart(2,'0') + ' ' + start.getHours().toString().padStart(2,'0') + ':' + start.getMinutes().toString().padStart(2,'0');
                
                let durationStr = 'Ongoing';
                if(dt.IsClosed) {
                    const d = dt.DurationSeconds;
                    const h = Math.floor(d / 3600).toString().padStart(2, '0');
                    const m = Math.floor((d % 3600) / 60).toString().padStart(2, '0');
                    const s = Math.floor(d % 60).toString().padStart(2, '0');
                    durationStr = `${h}:${m}:${s}`;
                }

                tr.innerHTML = `
                    <td>
                        <div class="small">${dt.ReasonDescription || '-'}</div>
                        <div class="text-secondary" style="font-size: 0.7rem;">${dt.ReasonCategory || '-'}</div>
                    </td>
                    <td class="small">${startStr}</td>
                    <td><span class="${dt.IsClosed ? 'text-success' : 'text-danger'}">${durationStr}</span></td>
                    <td><span class="badge ${dt.IsClosed ? 'bg-success' : 'bg-danger'}">${dt.IsClosed ? 'Closed' : 'Active'}</span></td>
                `;
                tbody.appendChild(tr);
            });
        };

        window.handleRestClickFinal = async function(btn) {
             if(!window.validateGroupInjection()) return;
             if(!confirm('Mulai Rest Break?')) return;
             
             // Workflow: Stop all timers and reset display to 00:00:00 IMMEDIATELY
             window.stopAllTimers();  // ✅ Clean up existing intervals
             
             const timerDisplay = document.getElementById('since-last-status');
             if(timerDisplay) timerDisplay.textContent = '00:00:00';
             window.lastChangeTimestamp = new Date();
             window.runningStartTimeUtc = null;
             
             const form = btn.closest('form');
             const fd = new FormData(form);
             try {
                 const resp = await fetch(form.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                 const res = await resp.json();
                 if(res.success) {
                     if(typeof showToast === 'function') showToast('☕ Rest Break Dimulai', 'warning');
                     window.refreshAllData();
                 } else alert(res.message);
             } catch(e) { console.error(e); }
        };

        window.submitLineStopFinal = async function(btn) {
            if(!window.validateGroupInjection()) return;
            const modal = btn.closest('.modal');
            const reasonId = modal.querySelector('select[name="reasonId"]').value;
            if(!reasonId) { alert('Pilih alasan!'); return; }
            
             // Workflow: Stop all timers and reset display to 00:00:00 IMMEDIATELY
             window.stopAllTimers();  // ✅ Clean up existing intervals
             
             const timerDisplay = document.getElementById('since-last-status');
             if(timerDisplay) timerDisplay.textContent = '00:00:00';
             window.lastChangeTimestamp = new Date();
             window.runningStartTimeUtc = null;

            const fd = new FormData();
            fd.append('machineId', '@Html.Raw(Model.MachineId)');
            fd.append('reasonId', reasonId);
            const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if(tok) fd.append('__RequestVerificationToken', tok);

            try {
                const resp = await fetch('/Operator/LineStop', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const res = await resp.json();
                if(res.success) {
                    bootstrap.Modal.getInstance(modal).hide();
                    if(typeof showToast === 'function') showToast('🛑 Line Stop Dimulai', 'danger');
                    window.refreshAllData();
                } else alert(res.message);
            } catch(e) { console.error(e); }
        };

        window.submitNoLoadingFinal = async function(btn) {
            if(!window.validateGroupInjection()) return;
            const modal = btn.closest('.modal');
            
             // Workflow: Stop all timers and reset display to 00:00:00 IMMEDIATELY
             window.stopAllTimers();  // ✅ Clean up existing intervals
             
             const timerDisplay = document.getElementById('since-last-status');
             if(timerDisplay) timerDisplay.textContent = '00:00:00';
             window.lastChangeTimestamp = new Date();
             window.runningStartTimeUtc = null;

            const fd = new FormData();
            fd.append('machineId', '@Html.Raw(Model.MachineId)');
            const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if(tok) fd.append('__RequestVerificationToken', tok);

            try {
                const resp = await fetch('/Operator/NoLoading', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const res = await resp.json();
                if(res.success) {
                    bootstrap.Modal.getInstance(modal).hide();
                    if(typeof showToast === 'function') showToast('⏳ No Loading Aktif', 'info');
                    window.refreshAllData();
                } else alert(res.message);
            } catch(e) { console.error(e); }
        };

        // Hook SignalR OeeUpdated to refreshAllData
        // (Replaced by window.setupSignalR logic below)


        // Initial Refresh on load
        window.refreshAllData();
        
        // ✅ SIGNALR SETUP FINAL
        window.setupSignalR = async function() {
            if (window.oeeHubConnection) return; // Prevent duplicate
            
            console.log("📡 Initializing SignalRConnection...");
            
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/oeeHub")
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Information)
                .build();
                
            window.oeeHubConnection = connection;
            
            connection.on("OeeUpdated", function (data) {
                console.log("📡 [SignalR] OeeUpdated received:", data);
                
                // 1. Refresh Data
                if (typeof window.refreshAllData === 'function') {
                    window.refreshAllData();
                }
                
                // 2. Direct Timer & Status Update (Faster)
                if (data.lastStatusChangeTime && window.MachineTimer) {
                    window.MachineTimer.start(data.lastStatusChangeTime);
                }
                
                // 3. Update Navbar & Machine Status
                if (typeof window.updateMachineStatusUI === 'function') {
                    // Kita panggil dengan data parsial atau biarkan refreshAllData handle via API
                    // Disini kita update visual status navbar langsung
                    const isAktif = !data.hasActiveDowntime; // Simplifikasi
                    const navbarStatusDot = document.getElementById('navbar-status-dot');
                    const navbarStatusText = document.getElementById('navbar-status-text');
                    
                    if (navbarStatusDot && navbarStatusText) {
                        if (isAktif) {
                            navbarStatusText.textContent = 'AKTIF';
                            navbarStatusDot.style.background = '#28a745'; // Green
                            navbarStatusDot.className = 'status-dot active';
                        } else {
                            navbarStatusText.textContent = 'DOWNTIME'; 
                            navbarStatusDot.style.background = '#dc3545'; // Red
                            navbarStatusDot.className = 'status-dot active';
                        }
                        navbarStatusDot.style.boxShadow = `0 0 10px ${navbarStatusDot.style.background}`;
                    }
                }
            });
            
            try {
                await connection.start();
                console.log("✅ [SignalR] Connected!");
            } catch (err) {
                console.error("❌ [SignalR] Connection failed: ", err);
                setTimeout(window.setupSignalR, 5000); // Retry
            }
        };
        
        // Start SignalR
        document.addEventListener('DOMContentLoaded', window.setupSignalR);
        if (document.readyState === 'dovetail' || document.readyState === 'complete') {
             window.setupSignalR();
        }
        
        console.log('✅ FINAL SCRIPT LOADED. Functions ready.');
    </script>
    
