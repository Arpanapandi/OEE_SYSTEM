                        if (sinceLastStatusElCheck) {
                            console.log('✅ Timer verified after 1s - current value:', sinceLastStatusElCheck.textContent);
                            if (sinceLastStatusElCheck.textContent === '00:00:00') {
                                console.warn('⚠️ Timer masih 00:00:00 setelah 1 detik, force update...');
                                if (typeof updateRunningDisplay === 'function') {
                                    updateRunningDisplay();
                                    console.log('🔄 Force updateRunningDisplay called');
                                }
                            }
                        }
                        
                        if (!runningTimerInterval) {
                            console.error('❌ FATAL: runningTimerInterval is null after start!');
