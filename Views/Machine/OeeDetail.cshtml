        // ========== KOMPONEN LOADING DARI db_HOSS ==========
        let komponenData = [];
        let selectedPartNumber = '';
        let selectedKomponenId = null;

        // Function untuk load komponen berdasarkan part number dari db_HOSS
        async function loadKomponenFromHoss(partNumber) {
            const komponenContainer = document.getElementById('komponen-container');
            const selectKomponen = document.getElementById('select-komponen');
            const komponenError = document.getElementById('komponen-error');
            const komponenSuccess = document.getElementById('komponen-success');
            
            if (!komponenContainer || !selectKomponen || !komponenError || !komponenSuccess) {
                console.error('Komponen container elements not found');
                return;
            }
            
            if (!partNumber || partNumber.trim() === '') {
                komponenContainer.style.display = 'none';
                selectKomponen.innerHTML = '<option value="">-- Pilih Komponen --</option>';
                komponenData = [];
                selectedPartNumber = '';
                return;
            }
            
            // ✅ DUMMY MODE: Bypass API untuk testing
            const USE_DUMMY_DATA = false; // Set ke false untuk menggunakan API real
            
            try {
                if (USE_DUMMY_DATA) {
                    await new Promise(resolve => setTimeout(resolve, 500));
                    
                    const partNumberUpper = partNumber.toUpperCase();
                    let dummyKomponen = [];
                    
                    if (partNumberUpper.includes('BRG') || partNumberUpper.includes('BEARING')) {
                        dummyKomponen = [
                            { Id: 1, PartNumber: 'BRG-001', JmlKomponen: 10 },
                            { Id: 2, PartNumber: 'BRG-002', JmlKomponen: 15 },
                            { Id: 3, PartNumber: 'BRG-003', JmlKomponen: 20 }
                        ];
                    } else if (partNumberUpper.includes('VLV') || partNumberUpper.includes('VALVE')) {
                        dummyKomponen = [
                            { Id: 4, PartNumber: 'VLV-001', JmlKomponen: 5 },
                            { Id: 5, PartNumber: 'VLV-002', JmlKomponen: 8 },
                            { Id: 6, PartNumber: 'VLV-003', JmlKomponen: 12 }
                        ];
                    } else if (partNumberUpper.includes('GRS') || partNumberUpper.includes('GEAR')) {
                        dummyKomponen = [
                            { Id: 7, PartNumber: 'GRS-001', JmlKomponen: 3 },
                            { Id: 8, PartNumber: 'GRS-002', JmlKomponen: 5 }
                        ];
                    } else {
                        // Default
                        dummyKomponen = [
                            { Id: 9, PartNumber: 'COMP-001', JmlKomponen: 1 },
                            { Id: 10, PartNumber: 'COMP-002', JmlKomponen: 2 },
                            { Id: 11, PartNumber: 'COMP-003', JmlKomponen: 3 },
                            { Id: 12, PartNumber: 'COMP-004', JmlKomponen: 4 }
                        ];
                    }
                    
                    komponenData = dummyKomponen;
                    selectedPartNumber = partNumber.trim();
                    
                    selectKomponen.innerHTML = '<option value="">-- Pilih Komponen --</option>';
                    dummyKomponen.forEach(k => {
                        const option = document.createElement('option');
                        option.value = k.Id;
                        option.textContent = `${k.PartNumber}${k.JmlKomponen ? ` (Qty: ${k.JmlKomponen})` : ''}`;
                        option.setAttribute('data-part-number', k.PartNumber);
                        option.setAttribute('data-jml-komponen', k.JmlKomponen || 0);
                        selectKomponen.appendChild(option);
                    });
                    
                    komponenContainer.style.display = 'block';
                    komponenError.style.display = 'none';
                    komponenSuccess.textContent = `${dummyKomponen.length} komponen ditemukan (DUMMY)`;
                    komponenSuccess.style.display = 'block';
                    return;
                }
                
                // REAL API
                const url = `/api/Scanner/komponen/validate/${encodeURIComponent(partNumber.trim())}`;
                const validateResponse = await fetch(url);
                const validateResult = await validateResponse.json();
                
                if (!validateResult.success) {
                    komponenContainer.style.display = 'none';
                    komponenError.textContent = validateResult.message || 'Part Number tidak ditemukan';
                    komponenError.style.display = 'block';
                    komponenSuccess.style.display = 'none';
                    return;
                }
                
                const response = await fetch(`/api/Scanner/komponen/${encodeURIComponent(partNumber.trim())}`);
                const result = await response.json();
                
                if (result.success && result.data && result.data.length > 0) {
                    komponenData = result.data;
                    selectedPartNumber = partNumber.trim();
                    
                    selectKomponen.innerHTML = '<option value="">-- Pilih Komponen --</option>';
                    result.data.forEach(k => {
                        const option = document.createElement('option');
                        option.value = k.Id;
                        option.textContent = `${k.PartNumber}${k.JmlKomponen ? ` (Qty: ${k.JmlKomponen})` : ''}`;
                        selectKomponen.appendChild(option);
                    });
                    
                    komponenContainer.style.display = 'block';
                    komponenError.style.display = 'none';
                    komponenSuccess.textContent = `${result.data.length} komponen ditemukan`;
                    komponenSuccess.style.display = 'block';
                } else {
                    komponenContainer.style.display = 'none';
                    komponenError.textContent = 'Komponen tidak ditemukan';
                    komponenError.style.display = 'block';
                }
            } catch (error) {
                console.error('Error loading komponen:', error);
                komponenContainer.style.display = 'none';
            }
        }

        // ✅ PERBAIKAN: Check jika Part Number dan Nomor Lot Produksi sudah diisi, lalu load komponen dengan validasi real-time
        async function checkAndLoadKomponen() {
            const inputLotBo = document.getElementById('input-lot-bo');
            const inputNomorLot = document.getElementById('input-nomor-lot');
            const komponenError = document.getElementById('komponen-error');
            const komponenSuccess = document.getElementById('komponen-success');
            
            if (!inputLotBo || !inputNomorLot) return;
            
            const lotBo = inputLotBo.value?.trim() || '';
            const nomorLot = inputNomorLot.value?.trim() || '';
            
            // ✅ DUMMY MODE: Bypass validasi untuk testing
            const USE_DUMMY_VALIDATION = false; // Set ke false untuk menggunakan API real
            
            // ✅ PERBAIKAN: Validasi Lot BO ke database terlebih dahulu (real-time)
            if (lotBo && lotBo.length > 0) {
                try {
                    if (USE_DUMMY_VALIDATION) {
                        inputLotBo.classList.remove('is-invalid');
                        inputLotBo.classList.add('is-valid');
                        if (komponenError) komponenError.style.display = 'none';
                    } else {
                        const validateResponse = await fetch(`/api/Scanner/komponen/validate/${encodeURIComponent(lotBo)}`);
                        const validateResult = await validateResponse.json();
                        
                        if (validateResult.success) {
                            inputLotBo.classList.remove('is-invalid');
                            inputLotBo.classList.add('is-valid');
                            if (komponenError) komponenError.style.display = 'none';
                        } else {
                            inputLotBo.classList.remove('is-valid');
                            inputLotBo.classList.add('is-invalid');
                            if (komponenError) {
                                komponenError.textContent = validateResult.message || 'Lot BO tidak ditemukan di database';
                                komponenError.style.display = 'block';
                            }
                            const komponenContainer = document.getElementById('komponen-container');
                            if (komponenContainer) komponenContainer.style.display = 'none';
                            return;
                        }
                    }
                } catch (err) {
                    console.error('❌ Error validating Lot BO:', err);
                    inputLotBo.classList.remove('is-valid', 'is-invalid');
                }
            } else {
                inputLotBo.classList.remove('is-valid', 'is-invalid');
            }
            
            // ✅ PERBAIKAN: Load komponen hanya jika Lot BO dan Nomor Lot sudah terisi
            if (lotBo && nomorLot) {
                try {
                    const validateResponse = await fetch(`/api/Scanner/komponen/validate/${encodeURIComponent(lotBo)}`);
                    const validateResult = await validateResponse.json();
                    
                    if (!validateResult.success && !USE_DUMMY_VALIDATION) {
                        const komponenContainer = document.getElementById('komponen-container');
                        if (komponenContainer) komponenContainer.style.display = 'none';
                        if (komponenError) {
                            komponenError.textContent = validateResult.message || 'Lot BO tidak ditemukan di database';
                            komponenError.style.display = 'block';
                        }
                        if (komponenSuccess) komponenSuccess.style.display = 'none';
                        return;
                    }
                    
                    if (lotBo !== selectedPartNumber) {
                        await loadKomponenFromHoss(lotBo);
                    } else {
                        const komponenContainer = document.getElementById('komponen-container');
                        const selectKomponen = document.getElementById('select-komponen');
                        if (komponenContainer && selectKomponen && selectKomponen.options.length > 1) {
                            komponenContainer.style.display = 'block';
                        }
                    }
                } catch (err) {
                    console.error('❌ Error validating/loading komponen:', err);
                }
            } else {
                const komponenContainer = document.getElementById('komponen-container');
                const selectKomponen = document.getElementById('select-komponen');
                if (komponenContainer && selectKomponen) {
                    komponenContainer.style.display = 'none';
                    selectKomponen.innerHTML = '<option value="">-- Pilih Komponen --</option>';
                }
                if (komponenError) komponenError.style.display = 'none';
                if (komponenSuccess) komponenSuccess.style.display = 'none';
            }
        }

        // Local Storage / Data Flow Functions
        
        // 1. Man Power & Group Data (Persistent)
        function saveManPowerAndGroup() {
            const manPower = document.getElementById('select-man-power')?.value;
            const injection = document.querySelector('#injection-group input[name="injection"]:checked')?.value;
            
            if (manPower || injection) {
                const data = {
                    manPowerId: manPower,
                    injection: injection
                };
                localStorage.setItem('manPowerData', JSON.stringify(data));
                console.log('💾 Man Power & Injection Saved:', data);
            }
        }
        
        function loadManPowerAndGroup() {
            try {
                const dataJson = localStorage.getItem('manPowerData');
                if (dataJson) {
                    const data = JSON.parse(dataJson);
                    
                    if (data.manPowerId) {
                        const selectManPower = document.getElementById('select-man-power');
                        if (selectManPower) {
                            selectManPower.value = data.manPowerId;
                            selectManPower.dispatchEvent(new Event('change'));
                        }
                    }
                    
                    if (data.injection) {
                        const radio = document.querySelector(`#injection-group input[name="injection"][value="${data.injection}"]`);
                        if (radio) {
                            radio.checked = true;
                            radio.dispatchEvent(new Event('change'));
                        }
                    }
                    console.log('📂 Man Power & Injection Loaded:', data);
                }
            } catch (e) {
                console.error('Error loading Man Power data', e);
            }
        }
        
        // 2. Production Data History (Array)
        function saveProductionData(data) {
            try {
                const historyJson = localStorage.getItem('productionDataHistory');
                let history = historyJson ? JSON.parse(historyJson) : [];
                
                // Add metadata for new record
                data.id = 'prod-' + Date.now();
                data.timestamp = new Date().toISOString();
                data.status = 'In Progress'; // Waiting for Qty
                data.durationSeconds = 0;
                
                // Add to history
                history.push(data);
                
                // Limit history size (optional, keep last 50)
                if (history.length > 50) history.shift();
                
                localStorage.setItem('productionDataHistory', JSON.stringify(history));
                console.log('💾 Production Data Saved (Start Item):', data);
            } catch (e) {
                console.error('Error saving production data', e);
            }
        }
        
        function updateProductionDataWithQty(goodQty, rejectQty, durationSeconds) {
            try {
                const historyJson = localStorage.getItem('productionDataHistory');
                if (historyJson) {
                    let history = JSON.parse(historyJson);
                    if (history.length > 0) {
                        // Find the last 'In Progress' item, or just the very last added item
                        // We prefer finding the specific ID if we tracked it, but last item is safe for single flow
                        const idx = history.length - 1;
                        const lastEntry = history[idx];
                       
                        lastEntry.goodQty = goodQty;
                        lastEntry.rejectQty = rejectQty;
                        lastEntry.durationSeconds = durationSeconds;
                        lastEntry.status = 'Completed';
                        lastEntry.completionTime = new Date().toISOString();
                        
                        history[idx] = lastEntry;
                        
                        localStorage.setItem('productionDataHistory', JSON.stringify(history));
                        console.log('💾 Production Data Updated (End Item):', lastEntry);
                    }
                }
            } catch (e) {
                console.error('Error updating production data', e);
            }
        }
        
