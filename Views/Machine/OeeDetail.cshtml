            if (window.runningStartTimeUtc && window.runningTimerInterval) {
                if (typeof window.updateRunningDisplay === 'function') {
                    window.updateRunningDisplay();
                    return;
                }
            }

            // ✅ PERBAIKAN: Untuk Rest Break/Line Stop, gunakan lastChangeTimestamp (universal timer)
            // Pastikan menggunakan waktu server yang disesuaikan untuk konsistensi
            if (!lastChangeTimestamp) {
                sinceLastStatusEl.textContent = '00:00:00';
                return;
            }
            
            // ✅ PERBAIKAN: Gunakan getAdjustedServerTime untuk konsistensi dengan jam proses
            const nowAdjusted = typeof window.getAdjustedServerTime === 'function' 
                ? window.getAdjustedServerTime() 
                : new Date();
            
            const diffMs = nowAdjusted.getTime() - lastChangeTimestamp.getTime();
            const totalSeconds = Math.max(0, Math.floor(diffMs / 1000)); // Pastikan tidak negatif
            
            // Gunakan formatTime untuk konsistensi
            sinceLastStatusEl.textContent = formatTime(totalSeconds);
        }

        // 3. Fungsi Initialize/Update Timer dari Backend
        function updateSinceLastChange(initialTimeSeconds, isRunning = false) {
            const sinceLastStatusEl = document.getElementById('since-last-status');
            if (!sinceLastStatusEl) return;
            
            // ✅ CRITICAL: Clear semua existing intervals sebelum start yang baru
            if (sinceLastChangeInterval) {
                clearInterval(sinceLastChangeInterval);
                sinceLastChangeInterval = null;
            }
            if (window.runningTimerInterval) {
                clearInterval(window.runningTimerInterval);
                window.runningTimerInterval = null;
            }
            if (typeof runningTimerInterval !== 'undefined' && runningTimerInterval) {
                clearInterval(runningTimerInterval);
                runningTimerInterval = null;
            }
            
            // Pastikan initialSeconds valid (tidak null, tidak undefined, >= 0)
            const validSeconds = (initialTimeSeconds !== null && initialTimeSeconds !== undefined && initialTimeSeconds >= 0) 
                ? initialTimeSeconds 
                : 0;
            
            // ✅ CRITICAL: Gunakan waktu server yang disesuaikan untuk konsistensi
            const nowAdjusted = typeof window.getAdjustedServerTime === 'function' 
                ? window.getAdjustedServerTime() 
                : new Date();
            
            // ✅ PERBAIKAN: Jika Running, gunakan runningStartTimeUtc dan start runningTimerInterval
            if (isRunning) {
                // ✅ CRITICAL: SELALU prioritaskan runningStartTimeUtc yang sudah di-set dari LastStatusChangeTime (lebih akurat)
                // Jika sudah di-set sebelumnya dari backend (dari fetchOperatorDataForOee atau fetchTimeMetrics), gunakan itu
                // JANGAN menghitung ulang dari initialTimeSeconds karena itu akan menggunakan data lama
                if (typeof window.runningStartTimeUtc !== 'undefined' && window.runningStartTimeUtc) {
                    // ✅ CRITICAL: Gunakan runningStartTimeUtc yang sudah di-set dari LastStatusChangeTime (backend source)
                    runningStartTimeUtc = window.runningStartTimeUtc;
                    console.log('✅ Using existing runningStartTimeUtc from LastStatusChangeTime (backend source):', runningStartTimeUtc.toISOString(), 'initialSeconds:', validSeconds, '(ignored - using LastStatusChangeTime instead)');
                } else if (runningStartTimeUtc) {
                    // Jika local variable sudah ada, gunakan itu
                    if (typeof window.runningStartTimeUtc !== 'undefined') {
                        window.runningStartTimeUtc = runningStartTimeUtc;
                    }
                    console.log('✅ Using existing local runningStartTimeUtc:', runningStartTimeUtc.toISOString());
                } else {
                    // ⚠️ FALLBACK: Calculate runningStartTimeUtc dari initialTimeSeconds hanya jika tidak ada dari backend
                    // Ini seharusnya tidak terjadi jika backend mengirim LastStatusChangeTime dengan benar
                    runningStartTimeUtc = new Date(nowAdjusted.getTime() - (validSeconds * 1000));
                    if (typeof window.runningStartTimeUtc !== 'undefined') {
                        window.runningStartTimeUtc = runningStartTimeUtc;
                    }
                    console.warn('⚠️ Running but no runningStartTimeUtc from backend, calculated from initialTimeSeconds:', runningStartTimeUtc.toISOString(), 'initialSeconds:', validSeconds);
                    console.warn('⚠️ This should not happen if backend sends LastStatusChangeTime correctly');
                }
                
                // Set lastChangeTimestamp juga untuk fallback
                lastChangeTimestamp = runningStartTimeUtc;
                
                // ✅ CRITICAL: Pastikan updateRunningDisplay function ada
                if (typeof window.updateRunningDisplay === 'function') {
                    // Update display immediately
                    window.updateRunningDisplay();
                    
                    // Start interval untuk update setiap detik dengan updateRunningDisplay
                    window.runningTimerInterval = setInterval(() => {
                        try {
                            if (typeof window.updateRunningDisplay === 'function') {
                                window.updateRunningDisplay();
                            }
                        } catch (error) {
                            console.error('❌ Error in runningTimerInterval:', error);
                        }
                    }, 1000);
                    
                    // Also set local variable untuk konsistensi
                    if (typeof runningTimerInterval !== 'undefined') {
                        runningTimerInterval = window.runningTimerInterval;
                    }
                    
                    console.log('✅ Running timer interval started after refresh, ID:', window.runningTimerInterval);
                } else {
                    console.warn('⚠️ updateRunningDisplay function not available, using fallback');
                    // Fallback: gunakan updateTimerDisplay
                    updateTimerDisplay();
                    sinceLastChangeInterval = setInterval(() => {
                        updateTimerDisplay();
                    }, 1000);
                }
            } else {
                // ✅ PERBAIKAN: Untuk Rest Break/Line Stop, gunakan lastChangeTimestamp dan start sinceLastChangeInterval
                lastChangeTimestamp = new Date(nowAdjusted.getTime() - (validSeconds * 1000));
                
                // Clear runningStartTimeUtc jika ada
                if (window.runningStartTimeUtc) {
                    window.runningStartTimeUtc = null;
                }
                if (typeof runningStartTimeUtc !== 'undefined' && runningStartTimeUtc) {
                    runningStartTimeUtc = null;
                }
                
                // Update display immediately
                updateTimerDisplay();
                
                // ✅ CRITICAL: Start interval untuk update setiap detik dengan updateTimerDisplay
                sinceLastChangeInterval = setInterval(() => {
                    updateTimerDisplay();
                }, 1000);
                
                console.log('✅ Non-running timer interval started, ID:', sinceLastChangeInterval);
            }
            
            console.log('✅ Timer initialized:', {
                initialSeconds: validSeconds,
                isRunning: isRunning,
                lastChangeTimestamp: lastChangeTimestamp,
                runningStartTimeUtc: runningStartTimeUtc,
                currentDisplay: sinceLastStatusEl.textContent
            });
        }
        
