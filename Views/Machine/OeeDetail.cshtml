                    window.handleScw4MChange = async function(val) {
                        const $target = $('#scw-remark');
                        const $source = $('#scw-4m-type');
                        
                        const typeId = val || $source.val();
                        console.log(`[SCW] Handler Triggered | TypeId: "${typeId}"`);

                        // Reset state
                        $target.empty();
                        
                        if (!typeId || typeId === "") {
                            $target.append('<option value="">-- Pilih Jenis 4M terlebih dahulu --</option>');
                            $target.prop('disabled', true);
                            return;
                        }

                        // Show loading state
                        $target.prop('disabled', true);
                        $target.append('<option value="">-- Loading remarks... --</option>');

                        try {
                            console.log(`[SCW] Fetching remarks from API for TypeId: ${typeId}`);
                            const response = await fetch(`/api/Operator/GetScwRemarks?scw4MTypeId=${typeId}`);
                            const data = await response.json();

                            if (data.success && data.remarks) {
                                $target.empty();
                                $target.append('<option value="">-- Pilih Jenis Remark --</option>');
                                
                                data.remarks.forEach(r => {
                                    $target.append($('<option>', { 
                                        value: r.id, 
                                        text: r.description 
                                    }));
                                });
                                
                                $target.prop('disabled', false).removeAttr('disabled');
                                console.log(`[SCW] API Success. Populated ${data.remarks.length} remarks for Type ${typeId}`);
                                
                                if (data.remarks.length === 0) {
                                    console.warn(`[SCW] API returned 0 remarks for TypeId ${typeId}`);
                                    $target.empty().append('<option value="">-- Tidak ada remark untuk kategori ini --</option>');
                                }
                            } else {
                                console.error('[SCW] API returned error or invalid data:', data);
                                $target.empty().append('<option value="">-- Gagal memuat data --</option>');
                            }
                        } catch (error) {
                            console.error('[SCW] Fetch error:', error);
                            $target.empty().append('<option value="">-- Kesalahan koneksi --</option>');
                        }
                    };

                // Init & Event Binding
                $(document).ready(function() {
                    // Delegate binding for better robustness
                    $(document).on('change', '#scw-4m-type', function() {
                        window.handleScw4MChange($(this).val());
                    });

                    // Init check if already selected
