@model OeeSystem.Models.ViewModels.MachineOeeViewModel
@{
    ViewData["Title"] = "OEE Detail - " + Model.MachineName;
    ViewData["IsOeeDetailPage"] = true;
    ViewData["MachineName"] = Model.MachineName;
    ViewData["LineId"] = Model.LineId;
    ViewData["ShiftName"] = string.IsNullOrEmpty(Model.ShiftName) ? $"Shift {Model.ShiftCode}" : Model.ShiftName;
    ViewData["ShiftTime"] = $"{Model.ShiftStart:HH:mm} - {Model.ShiftEnd:HH:mm}";
    ViewData["StandarCycleTime"] = Model.StandarCycleTime.ToString("F1");
    
    // Server time for scripts synchronization
    ViewData["ServerTime"] = DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss"); 
}

<partial name="Partials/_Styles" />

<div class="row">
    <div class="col-12">
        <partial name="Partials/_Header" model="Model" />
    </div>
</div>

<div class="row mb-3">
    <div class="col-12">
        <partial name="Partials/_Filter" model="Model" />
    </div>
</div>

<div class="row mt-3">
    <!-- Left Column: Actions & Metrics -->
    <div class="col-md-3">
        <partial name="Partials/_MachineActions" model="Model" />
        <partial name="Partials/_MetricsAndHistory" model="Model" />
    </div>
    
    <!-- Right Column: KPI, Forms, Charts -->
    <div class="col-md-9">
        <partial name="Partials/_KpiCards" model="Model" />
        <partial name="Partials/_InputForms" model="Model" />
        <partial name="Partials/_Charts" model="Model" />
    </div>
</div>

<!-- Modals -->
<partial name="Partials/_ModalsActions" model="Model" />
<partial name="Partials/_ModalsForms" model="Model" />
<partial name="Partials/_ScannerModal" model="Model" />

@section Scripts {
    <!-- Library Dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>


    <!-- External JS Logic -->
    <script>
        // Global Config for JS files
        window.OeeConfig = {
            machineId: '@Html.Raw(Model.MachineId)',
            shiftKey: '@Html.Raw(Model.ShiftKey)',
            machineStatus: '@Html.Raw(Model.MachineStatus)',
            lastStatusChange: '@Html.Raw(Model.LastStatusChangeTimeIso)',
            serverTime: '@ViewData["ServerTime"]'
        };

        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Main Controller
            if (window.OeeLogic) {
                window.OeeLogic.init(window.OeeConfig);
            }
        });
    </script>
    
    <script src="~/js/pages/machine/button-state-management.js"></script>
    <script src="~/js/pages/machine/oee-logic.js"></script>
    <script src="~/js/pages/machine/machine-actions.js"></script>
    <script src="~/js/pages/machine/oee-scanner.js"></script>
    
    <!-- Charts Initialization (Keep partial for Data Attributes) -->
    <partial name="Partials/_Script_Charts" model="Model" />
}
