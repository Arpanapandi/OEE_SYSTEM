            // Function untuk format durasi ke HH:mm:ss
            function formatDurasiProduksi(seconds) {
                const hours = Math.floor(seconds / 3600);
                const minutes = Math.floor((seconds % 3600) / 60);
                const secs = seconds % 60;
                return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            }

            // Function untuk start durasi produksi
            function startDurasiProduksi() {
                // Stop timer lama jika ada
                stopDurasiProduksi();
                
                // ✅ PERSISTENCE: Cek di localStorage dulu
                const savedStart = localStorage.getItem('prodDurationStartTime');
                if (savedStart) {
                    prodDurationStartTime = new Date(savedStart);
                } else {
                    prodDurationStartTime = window.getAdjustedServerTime ? window.getAdjustedServerTime() : new Date();
                    localStorage.setItem('prodDurationStartTime', prodDurationStartTime.toISOString());
                }
                
                prodDurationSecondsCounter = 0;
                
                // Show durasi container (selalu tampilkan saat start)
                const durasiContainer = document.getElementById('durasi-produksi-container');
                if (durasiContainer) {
                    durasiContainer.style.display = 'block';
                }
                
                // Update display
                updateDurasiProduksiDisplay();
                
                // Start interval jika auto mode aktif
                if (isProdDurationAuto) {
                    if (prodDurationInterval) {
                        clearTimeout(prodDurationInterval);
                    }
                    
                    function scheduleNextDurasiUpdate() {
                        prodDurationInterval = setTimeout(function() {
                            updateDurasiProduksiDisplay();
                            if (isProdDurationAuto && prodDurationStartTime) {
                                scheduleNextDurasiUpdate();
                            }
                        }, 1000 - (Date.now() % 1000));
                    }
                    scheduleNextDurasiUpdate();
                }
            }
            
            // Function untuk show durasi container (tanpa start timer)
            function showDurasiContainer() {
                const durasiContainer = document.getElementById('durasi-produksi-container');
                if (durasiContainer) {
                    durasiContainer.style.display = 'block';
                }
            }

            // Function untuk stop durasi produksi
            function stopDurasiProduksi() {
                if (prodDurationInterval) {
                    clearTimeout(prodDurationInterval);
                    prodDurationInterval = null;
                }
            }

            // Function untuk reset durasi produksi
            function resetDurasiProduksi() {
                stopDurasiProduksi();
                prodDurationSecondsCounter = 0;
                prodDurationStartTime = null;
                localStorage.removeItem('prodDurationStartTime'); // ✅ PERSISTENCE: Clear from localStorage
                updateDurasiProduksiDisplay();
                console.log('🔄 Durasi produksi reset');
            }

            // ✅ PERBAIKAN: Function untuk update display durasi menggunakan waktu server yang disesuaikan
            function updateDurasiProduksiDisplay() {
                const displayEl = document.getElementById('durasi-produksi-display');
                const hiddenEl = document.getElementById('hidden-durasi-seconds');
                
                // ✅ PERBAIKAN: Gunakan waktu server yang disesuaikan untuk menghitung durasi
                if (prodDurationStartTime) {
                    const nowAdjusted = window.getAdjustedServerTime ? window.getAdjustedServerTime() : new Date();
                    const elapsed = Math.floor((nowAdjusted - prodDurationStartTime) / 1000);
                    prodDurationSecondsCounter = elapsed;
                }
                
                if (displayEl) {
                    displayEl.value = formatDurasiProduksi(prodDurationSecondsCounter);
                }
                
                if (hiddenEl) {
                    hiddenEl.value = prodDurationSecondsCounter;
                }
            }

            // Setup toggle auto durasi
            document.addEventListener('DOMContentLoaded', function() {
                const toggleAuto = document.getElementById('toggle-auto-durasi');
                const btnReset = document.getElementById('btn-reset-durasi');
                
                if (toggleAuto) {
                    toggleAuto.addEventListener('change', function() {
                        isProdDurationAuto = this.checked;
                        if (isProdDurationAuto && prodDurationStartTime && !prodDurationInterval) {
                            // Resume timer jika sudah start tapi belum running
                            // Clear existing timeout jika ada
                            if (prodDurationInterval) {
                                clearTimeout(prodDurationInterval);
                            }
                            
                            // Update display segera
                            updateDurasiProduksiDisplay();
                            
                            // ✅ PERBAIKAN: Start timeout rekursif dengan presisi tinggi (sinkron dengan jam proses)
                            function scheduleNextDurasiUpdate() {
                                prodDurationInterval = setTimeout(function() {
                                    updateDurasiProduksiDisplay();
                                    if (isProdDurationAuto && prodDurationStartTime) {
                                        scheduleNextDurasiUpdate();
                                    }
                                }, 1000 - (Date.now() % 1000)); // Sync dengan detik penuh
                            }
                            scheduleNextDurasiUpdate();
                            console.log('✅ Durasi produksi resumed (server-time-synced) - akan update setiap detik');
                        } else if (!isProdDurationAuto) {
                            // Stop timer jika auto dimatikan
                            stopDurasiProduksi();
                        }
                        console.log('🔄 Auto durasi:', isProdDurationAuto ? 'ON' : 'OFF');
                    });
                }
                
                if (btnReset) {
                    btnReset.addEventListener('click', function() {
                        resetDurasiProduksi();
                    });
                }

                // Load preferences on page load
