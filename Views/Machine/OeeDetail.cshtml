            console.log('🚀 Initializing SignalR connection for OEE events...');

            oeeConnection = new signalR.HubConnectionBuilder()
                .withUrl("/oeeHub")
                .withAutomaticReconnect({
                    nextRetryDelayInMilliseconds: retryContext => {
                        if (retryContext.elapsedMilliseconds < 2000) return 0;
                        if (retryContext.elapsedMilliseconds < 5000) return 2000;
                        if (retryContext.elapsedMilliseconds < 10000) return 5000;
                        return 10000;
                    }
                })
                .build();


            // ========== EVENT: RunningStarted ==========
            oeeConnection.on("RunningStarted", function (machineId, startTimeUtc) {
                if (machineId !== machineIdInt) return; // Filter by machineId

                console.log('📡 RunningStarted event received:', startTimeUtc);
                // Restart timer dengan timestamp dari server (lebih akurat)
                startRunningTimer(startTimeUtc);
            });

            // ========== EVENT: RunningStopped ==========
            oeeConnection.on("RunningStopped", function (machineId, endTimeUtc, totalSeconds) {
                if (machineId !== machineIdInt) return; // Filter by machineId

                console.log('📡 RunningStopped event received:', endTimeUtc, totalSeconds);
                stopRunningTimer();
