        function validateGroupInjection() {
            const injectionGroup = document.querySelectorAll('input[name="injection"]');
            let isChecked = false;
            if (injectionGroup.length === 0) return true; // If no injection inputs, skip validation
            
            injectionGroup.forEach(radio => {
                if (radio.checked) {
                    isChecked = true;
                }
            });
            
            if (!isChecked) {
