@model OeeSystem.Models.ViewModels.MachineOeeViewModel
@using OeeSystem.Models

<div class="row mb-3">
    <div class="col-12">
        <div class="glass-card">
            <div class="glass-card-header d-flex justify-content-between align-items-center" style="padding: 0.75rem 1rem;">
                <div>
                    <i class="fa-solid fa-sliders me-2"></i>Machine Actions
                </div>
                <div>
                    <span class="badge @(Model.MachineStatus == MachineStatus.Aktif ? "bg-success" : "bg-warning")" id="machine-status-badge">
                        @(Model.MachineStatus == MachineStatus.Aktif ? "AKTIF" : "TIDAK AKTIF")
                    </span>
                    @if (Model.MachineStatus == MachineStatus.TidakAktif)
                    {
                        <span class="small text-warning ms-2" id="machine-status-info">
                            <i class="fa-solid fa-exclamation-triangle me-1"></i>Machine di-set Tidak Aktif di Admin
                        </span>
                    }
                    else
                    {
                        <span class="small text-danger ms-2" id="downtime-description" style="@(Model.HasActiveDowntime && !string.IsNullOrEmpty(Model.ActiveDowntimeDescription) ? "" : "display: none;")">
                            @(Model.HasActiveDowntime ? Model.ActiveDowntimeDescription : "")
                        </span>
                    }
                </div>
            </div>
            <div class="glass-card-body" style="padding: 1.5rem;">
                
                <!-- Action Buttons: Horizontal Symmetric Layout (1 Row, 4 Columns) -->
                <div class="row g-3 justify-content-center mb-4">
                    <!-- Running Button -->
                    <div class="col-md-3 col-12">
                        @Html.AntiForgeryToken()
                        <button type="button" 
                                id="btn-running" 
                                class="btn w-100 btn-outline-success machine-action-btn py-3"
                                data-machine-id="@Model.MachineId"
                                style="pointer-events: auto !important; cursor: pointer !important; height: 100%;"
                                onclick="if(typeof handleRunningClickDirect === 'function') { handleRunningClickDirect(this); } else { console.error('❌ handleRunningClickDirect not found'); } return false;">
                            <i class="fa-solid fa-play me-2"></i>RUNNING
                        </button>
                    </div>

                    <!-- Rest Break Button -->
                    <div class="col-md-3 col-12">
                         @if (Model.RestReason != null)
                        {
                            <form asp-controller="Operator" asp-action="Rest" method="post" id="rest-form" style="margin: 0; height: 100%;" onsubmit="return false;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="machineId" value="@Model.MachineId" />
                                <input type="hidden" name="reasonId" value="@Model.RestReason.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="button" 
                                        id="btn-rest" 
                                        class="btn w-100 btn-outline-warning machine-action-btn py-3"
                                        style="pointer-events: auto !important; cursor: pointer !important; height: 100%;">
                                    <i class="fa-solid fa-mug-hot me-2"></i>REST BREAK
                                </button>
                            </form>
                        }
                    </div>

                    <!-- Line Stop Button -->
                    <div class="col-md-3 col-12">
                        <button type="button" 
                                id="btn-line-stop" 
                                class="btn w-100 btn-outline-danger machine-action-btn py-3"
                                style="pointer-events: auto !important; cursor: pointer !important; height: 100%;"
                                onclick="if(typeof window.bootstrap !== 'undefined') { const m = new bootstrap.Modal(document.getElementById('lineStopModal')); m.show(); } else { alert('Bootstrap load failed'); }">
                            <i class="fa-solid fa-octagon-minus me-2"></i>LINE STOP
                        </button>
                    </div>

                    <!-- No Loading Button -->
                    <div class="col-md-3 col-12">
                        <button type="button" 
                                id="btn-no-loading" 
                                class="btn w-100 btn-outline-secondary machine-action-btn py-3"
                                style="pointer-events: auto !important; cursor: pointer !important; height: 100%; color: #adb5bd; border-color: #6c757d;"
                                onclick="if(typeof window.bootstrap !== 'undefined') { const m = new bootstrap.Modal(document.getElementById('noLoadingModal')); m.show(); } else { alert('Bootstrap load failed'); }">
                            <i class="fa-solid fa-door-closed me-2"></i>NO LOADING
                        </button>
                    </div>
                </div>

                <hr class="border-secondary opacity-25 my-4" style="border-style: dashed;">

                <!-- Timer Section (Bottom) -->
                <div class="text-center position-relative">
                    <div class="small text-secondary mb-2 text-uppercase fw-bold" style="letter-spacing: 2px;">TOTAL RUNNING TIME</div>
                    <input type="text" 
                           class="form-control border-0 text-center fw-bold bg-transparent p-0" 
                           id="durasi-produksi-display" 
                           value="00:00:00"
                           readonly
                           style="font-family: 'Consolas', 'Monaco', 'Courier New', monospace; font-size: 4rem; color: #0dcaf0; font-weight: 700; background: transparent; letter-spacing: 4px;">
                    
                     <!-- Running Indicator -->
                    <div id="timer-status-text" class="text-info mt-2 fw-bold small d-none">
                         <i class="fa-solid fa-circle-notch fa-spin me-1"></i>Recording...
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modals for Actions -->
<partial name="Partials/_ModalsActions" model="Model" />
