@model OeeSystem.Models.ViewModels.MachineOeeViewModel
@using OeeSystem.Models

<div class="row mb-3">
    <div class="col-12">
        <div class="glass-card">
            <div class="glass-card-header d-flex justify-content-between align-items-center" style="padding: 0.75rem 1rem;">
                <div>
                    <i class="fa-solid fa-sliders me-2"></i>Machine Actions
                </div>
                <div>
                    <span class="badge @(Model.MachineStatus == MachineStatus.Aktif ? "bg-success" : "bg-warning")" id="machine-status-badge">
                        @(Model.MachineStatus == MachineStatus.Aktif ? "AKTIF" : "TIDAK AKTIF")
                    </span>
                    @if (Model.MachineStatus == MachineStatus.TidakAktif)
                    {
                        <span class="small text-warning ms-2" id="machine-status-info">
                            <i class="fa-solid fa-exclamation-triangle me-1"></i>Machine di-set Tidak Aktif di Admin
                        </span>
                    }
                    else
                    {
                        <span class="small text-danger ms-2" id="downtime-description" style="@(Model.HasActiveDowntime && !string.IsNullOrEmpty(Model.ActiveDowntimeDescription) ? "" : "display: none;")">
                            @(Model.HasActiveDowntime ? Model.ActiveDowntimeDescription : "")
                        </span>
                    }
                </div>
            </div>
            <div class="glass-card-body py-4 position-relative">
                
                <!-- 1. Action Buttons (2x2 Grid for Tablet/Desktop) -->
                <div class="row g-3">
                    <!-- Left Column (2 Buttons) -->
                    <div class="col-6">
                        <div class="d-flex flex-column gap-3 h-100">
                             <!-- Running Button -->
                            @Html.AntiForgeryToken()
                            <button type="button" 
                                    id="btn-running" 
                                    class="btn w-100 btn-success machine-action-btn py-1 d-flex align-items-center justify-content-center shadow-sm"
                                    data-machine-id="@Model.MachineId"
                                    style="height: 40px; font-size: 1rem; letter-spacing: 1px; border-width: 0; font-weight: 450;"
                                    onclick="if(typeof handleRunningClickDirect === 'function') { handleRunningClickDirect(this); } return false;">
                                <i class="fa-solid fa-play me-2 fs-6"></i>RUNNING
                            </button>

                             <!-- Line Stop Button -->
                            <button type="button" 
                                    id="btn-line-stop" 
                                    class="btn w-100 btn-danger machine-action-btn py-1 d-flex align-items-center justify-content-center shadow-sm"
                                    style="height: 40px; font-size: 1rem; letter-spacing: 1px; border-width: 0; font-weight: 450;"
                                    onclick="if(typeof window.bootstrap !== 'undefined') { const m = new bootstrap.Modal(document.getElementById('lineStopModal')); m.show(); }">
                                <i class="fa-solid fa-octagon-minus me-2 fs-6"></i>LINE STOP
                            </button>
                        </div>
                    </div>

                    <!-- Right Column (2 Buttons) -->
                    <div class="col-6">
                        <div class="d-flex flex-column gap-3 h-100">
                            <!-- Rest Break Button -->
                             @if (Model.RestReason != null)
                            {
                                <form asp-controller="Operator" asp-action="Rest" method="post" id="rest-form" class="h-50 m-0" onsubmit="return false;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="machineId" value="@Model.MachineId" />
                                    <input type="hidden" name="reasonId" value="@Model.RestReason.Id" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="button" 
                                            id="btn-rest" 
                                            class="btn w-100 btn-warning machine-action-btn py-1 d-flex align-items-center justify-content-center text-dark shadow-sm"
                                            style="height: 40px; font-size: 1rem; letter-spacing: 1px; border-width: 0; font-weight: 450;" >
                                        <i class="fa-solid fa-mug-hot me-2 fs-6"></i>REST BREAK
                                    </button>
                                </form>
                            }

                             <!-- No Loading Button -->
                            <button type="button" 
                                    id="btn-no-loading" 
                                    class="btn w-100 btn-secondary machine-action-btn py-1 d-flex align-items-center justify-content-center shadow-sm"
                                    style="height: 40px; font-size: 1rem; letter-spacing: 1px; border-width: 0; font-weight: 450;"
                                    onclick="if(typeof window.bootstrap !== 'undefined') { const m = new bootstrap.Modal(document.getElementById('noLoadingModal')); m.show(); }">
                                <i class="fa-solid fa-door-closed me-2 fs-6"></i>NO LOADING
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. Timer Section (Bottom) -->
                <div class="text-center mt-3 position-relative">
                    <!-- Plain Text Timer (No Container) -->
                    <div class="small text-secondary mb-0 text-uppercase fw-bold opacity-75" style="letter-spacing: 3px; font-size: 0.7rem;">TOTAL RUNNING TIME</div>
                    <input type="text" 
                           class="form-control border-0 text-center fw-bold bg-transparent p-0" 
                           id="machine-running-timer" 
                           value="00:00:00"
                           readonly
                           style="font-family: 'Consolas', 'Monaco', 'Courier New', monospace; font-size: 2rem; color: #0dcaf0; font-weight: 300; background: transparent; letter-spacing: 2px; line-height: 1; text-shadow: 0 0 20px rgba(13, 202, 240, 0.3);">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals for Actions -->
<partial name="Partials/_ModalsActions" model="Model" />
