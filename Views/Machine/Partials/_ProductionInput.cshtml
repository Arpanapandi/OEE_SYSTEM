@model OeeSystem.Models.ViewModels.MachineOeeViewModel

<!-- Input Data Produksi Section -->
<div class="row mb-3">
    <div class="col-12">
        <div class="glass-card" id="production-input-card">
            <div class="glass-card-header" style="padding: 0.75rem 1rem;">
                <i class="fa-solid fa-qrcode me-2"></i>Input Data Produksi
            </div>
            <div class="glass-card-body" style="padding: 1rem;">
                
                <!-- 1. Nomor Lot -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Nomor Lot (Part Number)</label>
                    <div class="input-group">
                        <input type="text" class="form-control form-control-glass" id="input-nomor-lot" placeholder="Scan Part Number..." readonly>
                        <button class="btn btn-outline-primary" type="button" id="btn-scan-nomor-lot">
                             <i class="fa-solid fa-camera"></i> Scan
                        </button>
                        <button class="btn btn-outline-secondary" type="button" id="btn-edit-nomor-lot">
                             <i class="fa-solid fa-pencil"></i>
                        </button>
                    </div>
                </div>

                <!-- 2. Lot BO -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Lot BO</label>
                    <div class="input-group">
                         <input type="text" class="form-control form-control-glass" id="input-lot-bo" placeholder="Scan Lot BO..." readonly>
                         <button class="btn btn-outline-primary" type="button" id="btn-scan-lot-bo">
                            <i class="fa-solid fa-camera"></i>
                        </button>
                        <button class="btn btn-outline-secondary" type="button" id="btn-edit-lot-bo">
                            <i class="fa-solid fa-pencil"></i>
                        </button>
                    </div>
                </div>

                <!-- 3. Nama Compound -->
                <div class="mb-3">
                     <label class="form-label fw-bold">Nama Compound</label>
                    <div class="input-group">
                        <input type="text" class="form-control form-control-glass" id="input-nama-compound" placeholder="Scan Compound..." readonly>
                        <button class="btn btn-outline-primary" type="button" id="btn-scan-nama-compound">
                             <i class="fa-solid fa-camera"></i>
                        </button>
                         <button class="btn btn-outline-secondary" type="button" id="btn-edit-nama-compound">
                             <i class="fa-solid fa-pencil"></i>
                        </button>
                    </div>
                </div>

                <!-- 4. Berat Act -->
                <div class="mb-3">
                     <label class="form-label fw-bold">Berat Act (Kg)</label>
                    <div class="input-group">
                        <input type="number" step="0.01" class="form-control form-control-glass text-end" id="input-berat-act" placeholder="0.00">
                         <button class="btn btn-outline-secondary" type="button" id="btn-decrement-berat-act"><i class="fa-solid fa-minus"></i></button>
                        <button class="btn btn-outline-secondary" type="button" id="btn-increment-berat-act"><i class="fa-solid fa-plus"></i></button>
                    </div>
                </div>

                <!-- 5. Penipisan -->
                <div class="mb-3">
                    <label class="form-label fw-bold mb-2">Penipisan</label>
                    <div class="d-flex gap-2 w-100" id="penipisan-group">
                        <input type="radio" class="btn-check" name="penipisan" id="penipisan-tidak" value="TIDAK_PENIPISAN" checked>
                        <label class="btn btn-outline-success flex-fill" for="penipisan-tidak">Tidak Penipisan</label>

                        <input type="radio" class="btn-check" name="penipisan" id="penipisan-1" value="1_KALI">
                        <label class="btn btn-outline-warning flex-fill" for="penipisan-1">1 Kali</label>

                        <input type="radio" class="btn-check" name="penipisan" id="penipisan-2" value="2_KALI">
                        <label class="btn btn-outline-danger flex-fill" for="penipisan-2">2 Kali</label>
                    </div>
                </div>

                <!-- 6. Keterangan -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Keterangan</label>
                    <select class="form-control-glass" id="select-keterangan" required>
                        <option value="">-- Pilih Keterangan --</option>
                        <option value="Normal">Normal</option>
                        <option value="Mesin Trouble">Mesin Trouble</option>
                        <option value="Material Basah">Material Basah</option>
                        <option value="Trial Compound">Trial Compound</option>
                        <option value="Over Curing">Over Curing</option>
                        <option value="Under Curing">Under Curing</option>
                        <option value="Lainnya">Lainnya...</option>
                    </select>
                </div>
                
                <div class="mb-2" id="komponen-container" style="display: none;">
                    <label class="form-label fw-bold">Komponen <span class="text-danger">*</span></label>
                    <select class="form-control-glass" id="select-komponen" required>
                        <option value="">-- Pilih Komponen --</option>
                    </select>
                </div>

                <!-- 7. Submit Button -->
                 <button type="button" class="btn btn-primary w-100 py-3 mb-4 fw-bold shadow-sm" id="btn-submit-produksi" style="font-size: 1.1rem;">
                    <i class="fa-solid fa-paper-plane me-2"></i>SUBMIT DATA
                </button>

                <!-- 8. Timer Section -->
                <div class="pt-3 border-top border-secondary border-opacity-25" id="durasi-produksi-container">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0">Durasi Produksi (Per Item)</label>
                         <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="toggle-auto-durasi" checked>
                            <label class="form-check-label small text-muted" for="toggle-auto-durasi">Auto</label>
                        </div>
                    </div>
                    <div class="input-group mb-4">
                         <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-white">
                            <i class="fa-regular fa-clock"></i>
                        </span>
                        <input type="text" class="form-control form-control-glass text-center fw-bold" id="durasi-produksi-display" value="00:00:00" readonly style="font-family: 'Consolas', monospace; font-size: 1.5rem; letter-spacing: 2px;">
                        <button class="btn btn-outline-danger" type="button" id="btn-reset-durasi" title="Reset Timer">
                             <i class="fa-solid fa-rotate-left"></i> Reset
                        </button>
                    </div>
                </div>

                <!-- 8.1 Quantity Input (Direct) -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Quantity</label>
                    <div class="input-group">
                        <button class="btn btn-outline-success" type="button" id="btn-decrement-qty">
                            <i class="fa-solid fa-minus"></i>
                        </button>
                        <input type="number" class="form-control form-control-glass text-center fw-bold text-success fs-4" id="input-qty" value="1" min="1">
                        <button class="btn btn-outline-success" type="button" id="btn-increment-qty">
                            <i class="fa-solid fa-plus"></i>
                        </button>
                    </div>
                </div>

                <!-- 9. Quantity Section (Standalone Modal Method) -->
                <div class="pt-3 border-top border-secondary border-opacity-25 mb-2" id="quantity-container">
                    <button type="button" class="btn btn-info w-100 py-3 fw-bold shadow-sm d-flex align-items-center justify-content-center" 
                            id="btn-open-qty-modal"
                            onclick="if(window.bootstrap) { const m = new bootstrap.Modal(document.getElementById('standaloneQtyModal')); m.show(); }"
                            style="font-size: 1.1rem; letter-spacing: 1px; border: none; background: linear-gradient(135deg, #0dcaf0 0%, #0aa2c0 100%);">
                        <i class="fa-solid fa-plus-circle me-2 fs-5"></i>INPUT QUANTITY
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>
