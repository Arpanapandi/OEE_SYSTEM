@model OeeSystem.Models.ViewModels.MachineOeeViewModel

<script>
    // ========== MAIN CONTROL SCRIPT ==========
    
    // Global State
    window.machineId = '@Html.Raw(Model.MachineId)';
    window.shiftKey = '@Html.Raw(Model.ShiftKey)';
    window.serverTimeOffset = 0;
    
    // Timer Globals
    window.runningTimerInterval = null;
    window.sinceLastChangeInterval = null;
    window.timeMetricsInterval = null;
    window.realTimeMetricsInterval = null; // ✅ NEW: Interval for ticking metrics
    
    window.runningStartTimeUtc = null; // Date object
    window.lastChangeTimestamp = null; // Date object
    
    // Metrics Snapshot for Real-Time Calculation
    window.metricsSnapshot = null;
    window.snapshotTimestamp = null;
    
    // Status Globals
    window.isNoLoading = @(Model.IsNoLoading.ToString().ToLower());
    window.hasActiveRestBreak = @(Model.HasActiveRestBreak.ToString().ToLower());
    window.hasActiveDowntime = @(Model.HasActiveDowntime.ToString().ToLower()); // ✅ NEW
    window.machineStatus = '@Html.Raw(Model.MachineStatus)';
    
    // SignalR Connection
    let oeeConnection = null;
    
    // 1. UTILITIES
    
    // Sync Server Time
    function getAdjustedServerTime() {
        return new Date(Date.now() + window.serverTimeOffset);
    }
    
    function initializeServerTime() {
        const rawServerTime = '@ViewData["ServerTime"]'; 
        if (rawServerTime) {
            const serverTime = new Date(rawServerTime);
            if (!isNaN(serverTime.getTime())) {
                window.serverTimeOffset = serverTime.getTime() - Date.now();
                console.log('⏱️ Server time synced. Offset:', window.serverTimeOffset, 'ms');
            }
        }
    }
    
    function formatTime(seconds) {
        if (seconds < 0) seconds = 0;
        const h = Math.floor(seconds / 3600).toString().padStart(2, '0');
        const m = Math.floor((seconds % 3600) / 60).toString().padStart(2, '0');
        const s = Math.floor(seconds % 60).toString().padStart(2, '0');
        return `${h}:${m}:${s}`;
    }
    
    // ✅ Helper: Parse Time String to Seconds (Robust)
    function parseTime(timeStr) {
        if (!timeStr || timeStr === '-' || timeStr === '') return 0;
        const parts = timeStr.toString().split(':'); 
        if (parts.length < 3) return 0;
        let s = parseInt(parts[2]);
        let m = parseInt(parts[1]);
        let h = parseInt(parts[0]);
        if (parts[0].includes('.')) {
             const dayParts = parts[0].split('.');
             const days = parseInt(dayParts[0]);
             h = parseInt(dayParts[1]) + (days * 24);
        }
        return (h * 3600) + (m * 60) + s;
    }

    // ✅ REAL-TIME TICKING LOGIC (DIRECT ACCUMULATOR MODEL)
    // Prevents "Negative Timers" by growing values directly instead of subtracting from Shift
    window.updateRealTimeMetrics = function() {
        if (!window.metricsSnapshot || !window.snapshotTimestamp) return;

        const now = Date.now();
        const elapsedSeconds = Math.max(0, Math.floor((now - window.snapshotTimestamp) / 1000));
        
        const snapshot = window.metricsSnapshot;
        
        // 1. BASE VALUES from Snapshot (Force valid numbers)
        // These are the "Checpoints" from the last server fetch.
        const baseNoLoading = Number(snapshot.NoLoadingTimeSeconds) || parseTime(snapshot.NoLoadingTime) || 0;
        const baseRestBreak = Number(snapshot.RestBreakTimeSeconds) || parseTime(snapshot.RestBreakTime) || 0;
        const baseUnplannedDT = Number(snapshot.DowntimeTotalSeconds) || parseTime(snapshot.DowntimeTotal) || 0;
        const baseLoadingTime = Number(snapshot.PlannedProductionTimeSeconds) || parseTime(snapshot.PlannedProductionTime) || 0;
        const baseOperatingTime = Number(snapshot.OperatingTimeSeconds) || parseTime(snapshot.OperatingTime) || 0;

        // 2. DELTAS (Which counters are growing RIGHT NOW?)
        let deltaNoLoading = 0;
        let deltaRestBreak = 0;
        let deltaUnplannedDT = 0;
        let deltaLoadingTime = 0;
        let deltaOperatingTime = 0;
        
        if (window.isNoLoading) {
            deltaNoLoading = elapsedSeconds;
            // Planned (Loading) STOPS. Operating STOPS.
        } 
        else if (window.hasActiveRestBreak) {
            deltaRestBreak = elapsedSeconds;
             // Planned (Loading) STOPS. Operating STOPS.
        } 
        else if (window.hasActiveDowntime) {
            deltaUnplannedDT = elapsedSeconds;
            // Planned (Loading) GROWS (It's still scheduled production time). 
            deltaLoadingTime = elapsedSeconds;
            // Operating STOPS (Machine is down).
        } 
        else if (window.machineStatus === 'Aktif') {
            // Running normally
            // Planned (Loading) GROWS.
            deltaLoadingTime = elapsedSeconds;
            // Operating GROWS.
            deltaOperatingTime = elapsedSeconds;
        }
        
        // 3. CALCULATION (Simple Addition)
        const currentNoLoading = baseNoLoading + deltaNoLoading;
        const currentRestBreak = baseRestBreak + deltaRestBreak;
        const currentUnplannedDT = baseUnplannedDT + deltaUnplannedDT;
        // Calculation for Loading/Operating is now purely additive, ensuring no negatives.
        let currentLoadingTime = baseLoadingTime + deltaLoadingTime;
        // Correction: If backend logic for 'Operating Time' is 'Loading - Downtime', 
        // we should ensure our local 'Operating' matches that derivation visually, 
        // OR we can trust our 'deltaOperatingTime' if the snapshot was correct.
        // Let's stick to the additive Delta to be safe against negatives.
        let currentOperatingTime = baseOperatingTime + deltaOperatingTime;

        // 4. UPDATE DOM (Safe Formatting)
        const safeFormat = (val) => formatTime(Math.max(0, val));
        
        if(document.getElementById('operating-time')) 
            document.getElementById('operating-time').textContent = safeFormat(currentOperatingTime);
        
        if(document.getElementById('downtime-total')) 
            document.getElementById('downtime-total').textContent = safeFormat(currentUnplannedDT);
            
        if(document.getElementById('rest-break-time')) 
            document.getElementById('rest-break-time').textContent = safeFormat(currentRestBreak);
            
        if(document.getElementById('no-loading-time')) 
            document.getElementById('no-loading-time').textContent = safeFormat(currentNoLoading);
            
        if(document.getElementById('planned-production-time'))
            document.getElementById('planned-production-time').textContent = safeFormat(currentLoadingTime);

        // Update Bars
        if (currentLoadingTime > 0) {
            const opPercent = Math.min(100, (currentOperatingTime / currentLoadingTime) * 100);
            const dtPercent = Math.min(100, (currentUnplannedDT / currentLoadingTime) * 100);
            const opBar = document.getElementById('operating-progress-bar');
            const dtBar = document.getElementById('downtime-progress-bar');
            if(opBar) opBar.style.width = opPercent.toFixed(1) + '%';
            if(dtBar) dtBar.style.width = dtPercent.toFixed(1) + '%';
        }
    };
    
    // ✅ Helper: Finalize Snapshot
    // Commits elapsed ticks to the snapshot so transitions are seamless
    window.finalizeSnapshot = function() {
        if (!window.metricsSnapshot || !window.snapshotTimestamp) return;

        const now = Date.now();
        const elapsedSeconds = Math.max(0, Math.floor((now - window.snapshotTimestamp) / 1000));
        if (elapsedSeconds <= 0) return;

        console.log('🔄 Finalizing Snapshot. Elapsed:', elapsedSeconds, 's');

        // Init optional counters
        if(window.metricsSnapshot.PlannedProductionTimeSeconds === undefined) 
             window.metricsSnapshot.PlannedProductionTimeSeconds = parseTime(window.metricsSnapshot.PlannedProductionTime);
        if(window.metricsSnapshot.OperatingTimeSeconds === undefined) 
             window.metricsSnapshot.OperatingTimeSeconds = parseTime(window.metricsSnapshot.OperatingTime);
        if(window.metricsSnapshot.NoLoadingTimeSeconds === undefined) 
             window.metricsSnapshot.NoLoadingTimeSeconds = parseTime(window.metricsSnapshot.NoLoadingTime);
        if(window.metricsSnapshot.RestBreakTimeSeconds === undefined) 
             window.metricsSnapshot.RestBreakTimeSeconds = parseTime(window.metricsSnapshot.RestBreakTime);
        if(window.metricsSnapshot.DowntimeTotalSeconds === undefined) 
             window.metricsSnapshot.DowntimeTotalSeconds = parseTime(window.metricsSnapshot.DowntimeTotal);

        // Commit elapsed based on OLD state (before the click changed it)
        if (window.metricsSnapshot.hasActiveRestBreak) {
            window.metricsSnapshot.RestBreakTimeSeconds += elapsedSeconds;
        } 
        else if (window.metricsSnapshot.isNoLoading) {
            window.metricsSnapshot.NoLoadingTimeSeconds += elapsedSeconds;
        }
        else if (window.metricsSnapshot.hasActiveDowntime) {
             window.metricsSnapshot.DowntimeTotalSeconds += elapsedSeconds;
             // Line Stop (Unplanned) happens DURING Planned Production
             window.metricsSnapshot.PlannedProductionTimeSeconds += elapsedSeconds;
        }
        else if (window.machineStatus === 'Aktif') {
             // Running
             if (!window.metricsSnapshot.hasActiveRestBreak && 
                 !window.metricsSnapshot.isNoLoading && 
                 !window.metricsSnapshot.hasActiveDowntime) {
                 
                 window.metricsSnapshot.OperatingTimeSeconds += elapsedSeconds;
                 window.metricsSnapshot.PlannedProductionTimeSeconds += elapsedSeconds;
             }
        }
        
        window.snapshotTimestamp = now;
        console.log('✅ Snapshot Finalized.');
    };
    
    // 3. DATA FETCHING
    
    window.fetchTimeMetrics = async function() {
        try {
            const response = await fetch('/Operator/GetTimeMetrics?machineId=' + window.machineId);
            if (!response.ok) return;
            const data = await response.json();
            applyTimeMetrics(data);
        } catch (e) { console.error('Error fetching metrics', e); }
    };
    
    window.fetchOperatorDataForOee = async function() {
        // Implementation depends on what this data is. Usually for updating shift info/operator name.
        // Assuming implementation exists or is handled by page reload/SignalR.
    };
    
    function applyTimeMetrics(data) {
        if (!data) return;
        
        // ✅ SNAPSHOT for Ticking
        window.metricsSnapshot = data;
        window.snapshotTimestamp = Date.now();
        
        // ✅ SYNC INTERNAL STATE FROM SERVER
        // This is crucial if another user changed state
        if (data.HasActiveRestBreak !== undefined) window.hasActiveRestBreak = data.HasActiveRestBreak;
        if (data.IsNoLoading !== undefined) window.isNoLoading = data.IsNoLoading; // Assuming this property exists in response
        if (data.HasActiveDowntime !== undefined) window.hasActiveDowntime = data.HasActiveDowntime;
        if (data.MachineStatus) window.machineStatus = data.MachineStatus;

        // Apply static/initial values immediately
        window.updateRealTimeMetrics();
            
        // Update OEE Cards (percentages are static until next fetch)
        if(document.getElementById('oee-value')) document.getElementById('oee-value').textContent = (data.Oee || 0).toFixed(1) + '%';
        if(document.getElementById('availability-value')) document.getElementById('availability-value').textContent = (data.Availability || 0).toFixed(1) + '%';
        if(document.getElementById('performance-value')) document.getElementById('performance-value').textContent = (data.Performance || 0).toFixed(1) + '%';
        if(document.getElementById('quality-value')) document.getElementById('quality-value').textContent = (data.Quality || 0).toFixed(1) + '%';
        
        // Update Bars
        if(document.getElementById('planned-production-time'))
             document.getElementById('planned-production-time').textContent = data.PlannedProductionTime || '-';
             
        // Percentages for bars
        if (data.OperatingPercent !== undefined) {
             const bar = document.getElementById('operating-progress-bar');
             if(bar) bar.style.width = data.OperatingPercent + '%';
        }
         if (data.DowntimePercent !== undefined) {
             const bar = document.getElementById('downtime-progress-bar');
             if(bar) bar.style.width = data.DowntimePercent + '%';
        }
    }

    // 4. SIGNALR
    
    function initSignalR() {
        if (typeof signalR === 'undefined') {
            console.error('SignalR library not loaded');
            return;
        }
        
        oeeConnection = new signalR.HubConnectionBuilder()
            .withUrl("/oeeHub")
            .withAutomaticReconnect()
            .configureLogging(signalR.LogLevel.Warning)
            .build();
            
        oeeConnection.on("ReceiveRealTimeSync", (data) => {
            console.log("📡 SignalR Sync:", data);
            if (data.MachineId === window.machineId) {
                applyTimeMetrics(data);
                if (data.MachineStatus) {
                    window.machineStatus = data.MachineStatus;
                    updateMachineStatusUI(data.MachineStatus, data.ActiveDowntimeDescription);
                }
            }
        });
        
        oeeConnection.on("OeeUpdated", (data) => {
             if (data.machineId === window.machineId) {
                 fetchTimeMetrics(); // Refresh full metrics
             }
        });
        
        oeeConnection.start().then(() => {
            console.log('✅ Connected to OEE Hub');
            oeeConnection.invoke("JoinGroup", window.machineId).catch(err => console.error(err));
        }).catch(err => console.error('SignalR Connection Error', err));
    }

    // 5. CHART.JS
    function initCharts() {
        const ctxRun = document.getElementById('machineRuntimeChart');
        if (ctxRun && typeof Chart !== 'undefined') {
             // ... Render logic
        }
    }

    // ========== INITIALIZATION ==========
    document.addEventListener('DOMContentLoaded', function() {
        initializeServerTime();
        initSignalR();
        
        // Initial Timer Setup
        const lastChangeStr = '@Html.Raw(Model.LastStatusChangeTimeIso)'; 
        if (lastChangeStr) {
            window.lastChangeTimestamp = new Date(lastChangeStr);
            console.log('⏱️ Timer initialized from', window.lastChangeTimestamp);
            
            if (window.sinceLastChangeInterval) clearInterval(window.sinceLastChangeInterval);
            window.sinceLastChangeInterval = setInterval(window.updateTimerDisplay, 1000);
            window.updateTimerDisplay(); // Immediate
        }

        
        // ✅ Start Real-Time Metric Ticking
        if (window.realTimeMetricsInterval) clearInterval(window.realTimeMetricsInterval);
        window.realTimeMetricsInterval = setInterval(window.updateRealTimeMetrics, 1000);
        
        // Start Global Metrics Polling (Backup/Re-Sync)
        window.timeMetricsInterval = setInterval(window.fetchTimeMetrics, 10000); // More frequent: 10s
        
        // Initial Fetch
        fetchTimeMetrics();
    });

</script>
