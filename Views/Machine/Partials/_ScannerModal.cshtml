@model OeeSystem.Models.ViewModels.MachineOeeViewModel

<!-- Modal for Scanner -->
<div class="modal fade" id="scannerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Scan <span id="scanner-target-label">Barcode/QR Code</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="scanner-container" style="width: 100%; min-height: 300px; position: relative;">
                    <!-- Quagga2/HTML5-QRCode scanner area -->
                    <div id="scanner-reader" style="width: 100%; position: relative; background-color: #000;">
                        <canvas id="scanner-canvas" style="display: none;"></canvas>
                        <video id="scanner-video" style="width: 100%; height: auto; display: block;"></video>
                        <!-- Bounding box overlay -->
                        <div id="scanner-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;"></div>
                    </div>
                    <!-- Switch Camera Button -->
                    <div class="text-center mt-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btn-switch-camera" style="display: none;">
                            <i class="fa-solid fa-camera-rotate me-1"></i>Switch Camera
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btn-stop-scanner">Stop Scanner</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Scanner Modal Script (Load Libraries logic will be in main or separate script file)
    // Inline scanner styles
</script>

<style>
    /* Scanner styles moved from main file */
    #scanner-reader {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
    }
    #scanner-reader video {
        border-radius: 8px;
        max-width: 100%;
        height: auto;
    }
    /* Bounding box */
    #scanner-reader #qr-shaded-region {
        border: 3px solid #00ff00 !important;
        border-radius: 12px !important;
        box-shadow: 0 0 0 4px rgba(0, 255, 0, 0.3),
                    0 0 20px rgba(0, 255, 0, 0.5),
                    inset 0 0 20px rgba(0, 255, 0, 0.1) !important;
        background-color: rgba(0, 255, 0, 0.05) !important;
    }
    #scanner-reader #qr-shaded-region::before,
    #scanner-reader #qr-shaded-region::after {
        content: '';
        position: absolute;
        width: 30px;
        height: 30px;
        border: 3px solid #00ff00;
    }
    @@keyframes scanPulse {
        0%, 100% {
            box-shadow: 0 0 0 4px rgba(0, 255, 0, 0.3),
                        0 0 20px rgba(0, 255, 0, 0.5),
                        inset 0 0 20px rgba(0, 255, 0, 0.1);
        }
        50% {
            box-shadow: 0 0 0 6px rgba(0, 255, 0, 0.5),
                        0 0 30px rgba(0, 255, 0, 0.7),
                        inset 0 0 30px rgba(0, 255, 0, 0.2);
        }
    }
    #scanner-reader #qr-shaded-region {
        animation: scanPulse 2s ease-in-out infinite;
    }
    @@keyframes scanAnim {
        0% { top: 10%; opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { top: 90%; opacity: 0; }
    }
</style>
