@model OeeSystem.Models.ViewModels.MachineOeeViewModel

<!-- Modal for Scanner -->
<div class="modal fade" id="scannerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Scan <span id="scanner-target-label">Barcode/QR Code</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="scanner-container" style="width: 100%; min-height: 300px; position: relative;">
                    <!-- Quagga2/HTML5-QRCode scanner area -->
                    <div id="scanner-reader">
                        <canvas id="scanner-canvas" style="display: none;"></canvas>
                        <video id="scanner-video"></video>
                        
                        <!-- Custom Viewfinder Overlay -->
                        <div class="scanner-viewfinder"></div>
                        <div class="scanner-line"></div>
                    </div>
                    <!-- Switch Camera Button -->
                    <div class="text-center mt-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btn-switch-camera" style="display: none;">
                            <i class="fa-solid fa-camera-rotate me-1"></i>Switch Camera
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btn-stop-scanner">Stop Scanner</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Scanner Modal Script (Load Libraries logic will be in main or separate script file)
    // Inline scanner styles
</script>

<style>
    /* Scanner styles */
    #scanner-reader {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: hidden;
        background: #000;
        min-height: 300px;
        border-radius: 8px;
    }
    
    #scanner-reader video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Custom Viewfinder Overlay */
    .scanner-viewfinder {
        position: absolute;
        top: 0; 
        left: 0; 
        width: 100%; 
        height: 100%; 
        pointer-events: none;
        z-index: 10;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .scanner-viewfinder::before {
        content: '';
        display: block;
        width: 250px;
        height: 250px;
        box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.6); /* Darkens area outside box */
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 12px;
        position: relative;
    }

    /* Corner Borders for Targeting */
    .scanner-viewfinder::after {
        content: '';
        position: absolute;
        width: 260px;
        height: 260px;
        border: 4px solid transparent;
        /* Corner gradients */
        background: 
            linear-gradient(to right, #00ff00 40px, transparent 40px) top left,
            linear-gradient(to bottom, #00ff00 40px, transparent 40px) top left,
            linear-gradient(to left, #00ff00 40px, transparent 40px) top right,
            linear-gradient(to bottom, #00ff00 40px, transparent 40px) top right,
            linear-gradient(to right, #00ff00 40px, transparent 40px) bottom left,
            linear-gradient(to top, #00ff00 40px, transparent 40px) bottom left,
            linear-gradient(to left, #00ff00 40px, transparent 40px) bottom right,
            linear-gradient(to top, #00ff00 40px, transparent 40px) bottom right;
        background-repeat: no-repeat;
    }

    /* Scanning Line Animation */
    @@keyframes scanLineAnim {
        0% { transform: translateY(-120px); opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { transform: translateY(120px); opacity: 0; }
    }

    .scanner-line {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 240px;
        height: 2px;
        background: #00ff00;
        box-shadow: 0 0 10px #00ff00, 0 0 20px #00ff00;
        margin-left: -120px;
        z-index: 12;
        animation: scanLineAnim 2s linear infinite;
        pointer-events: none;
    }

    /* Hide library internals */
    #html5-qrcode-anchor-scan-type-change {
        display: none !important;
    }
</style>
