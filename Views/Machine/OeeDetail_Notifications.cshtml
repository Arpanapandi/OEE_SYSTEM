
        // ========== NOTIFICATION HELPERS ==========
        // ✅ PERBAIKAN: Global Notification Wrappers
        // These bridge the gap between specific function calls (showSuccessNotification)
        // and the generic toast system (showToast) used elsewhere in the app.
        window.showSuccessNotification = function(message) {
            if (typeof showToast === 'function') {
                showToast(message, 'success');
            } else if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'success', title: 'Berhasil', text: message, timer: 2000, showConfirmButton: false });
            } else {
                console.log('✅ SUCCESS:', message);
                alert(message);
            }
        };

        window.showErrorNotification = function(message) {
            if (typeof showToast === 'function') {
                showToast(message, 'error');
            } else if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Gagal', text: message });
            } else {
                console.error('❌ ERROR:', message);
                alert('Error: ' + message);
            }
        };

        window.showWarningNotification = function(message) {
            if (typeof showToast === 'function') {
                showToast(message, 'warning');
            } else if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'warning', title: 'Peringatan', text: message });
            } else {
                console.warn('⚠️ WARNING:', message);
                alert('Peringatan: ' + message);
            }
        };
